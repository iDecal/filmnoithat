---
import { metalMaterialFaqs } from "../data/metalMaterialFaqs";
import { samplesForMaterial } from "../data/catalogue";
import { formatRetailPrice } from "../data/infeelPrices";
const prices = samplesForMaterial("kim-loai").map(sample => sample.pricePerMetre).filter((price): price is number => typeof price === "number" && price > 0);
const priceRange = prices.length ? `${formatRetailPrice(Math.min(...prices))} – ${formatRetailPrice(Math.max(...prices))}` : "";
---
<section id="ung-dung" class="metal-guide" aria-labelledby="metal-guide-title"><div class="metal-reading metal-content-grid">
  <header><figure class="metal-topic-photo"><img src="/images/vat-lieu/kim-loai/CSM003-goc.jpg" alt="Cận cảnh cuộn film hiệu ứng kim loại tông đồng với vân xước" width="1200" height="800" loading="lazy" decoding="async" /><figcaption>Ảnh bề mặt film kim loại tham khảo.</figcaption></figure><p class="metal-eyebrow">TÌM HIỂU VẬT LIỆU</p><h2 id="metal-guide-title">Film dán nội thất kim loại: điểm nhấn ánh kim cho không gian</h2><p>Film kim loại là lựa chọn hoàn thiện bề mặt khi bạn muốn bổ sung sắc bạc, champagne, đồng hoặc những hiệu ứng ánh kim vào nội thất. Có thể bắt đầu từ một cánh tủ, một mảng vách hay mặt quầy để tạo điểm nhấn, thay vì dùng cùng hiệu ứng trên toàn bộ căn phòng.</p><p>Danh sách sản phẩm phía trên giúp bạn so sánh mã mẫu, màu sắc và giá vật liệu. Khi đã có hướng phối, nên xem mẫu trực tiếp để đánh giá độ phản chiếu, hướng vân và sự tương thích với bề mặt dự định dán.</p></header>

  <section aria-labelledby="metal-definition"><figure class="metal-topic-photo"><img src="/images/vat-lieu/kim-loai/Inox-xuoc-bac.jpg" alt="Cuộn film trang trí hiệu ứng kim loại xước bạc" width="1200" height="800" loading="lazy" decoding="async" /><figcaption>Film hiệu ứng xước bạc; thông số cần theo đúng mã mẫu.</figcaption></figure><h2 id="metal-definition">Film kim loại là gì? Khác gì với tấm kim loại?</h2><p>Film dán nội thất hiệu ứng kim loại là lớp hoàn thiện trang trí mô phỏng vẻ ngoài của bề mặt kim loại. Tùy bộ sưu tập và mã sản phẩm, bạn có thể gặp hiệu ứng xước, sắc ánh kim hoặc mức độ phản chiếu khác nhau. Tên gọi “film kim loại” mô tả hiệu ứng thị giác; không có nghĩa vật liệu thay thế được inox, nhôm hay chi tiết kim loại thật.</p><p>Hiệu quả hoàn thiện phụ thuộc cả mã film lẫn nền bên dưới. Bề mặt cần ổn định, khô và được chuẩn bị phù hợp. Với nền hư hỏng hoặc có yêu cầu kỹ thuật riêng, cần kiểm tra trước khi quyết định dùng film.</p></section>

  <section aria-labelledby="metal-uses"><figure class="metal-topic-photo"><img src="/images/perspectives/ivory-oak-kitchen.webp" alt="Phối cảnh minh họa tủ bếp sáng phối gỗ và mặt đá trung tính" width="1200" height="800" loading="lazy" decoding="async" /><figcaption>Phối cảnh minh họa không gian bếp để tham khảo cách phối chất liệu.</figcaption></figure><h2 id="metal-uses">Tủ bếp, cánh tủ và chi tiết trang trí</h2><p>Một mảng champagne hoặc ánh đồng có thể phối với gỗ sáng, màu kem hay mặt đá trung tính. Với tủ bếp, cần kiểm tra dầu mỡ, mép cánh, độ ẩm và khoảng cách tới nguồn nhiệt. Xem thêm hạng mục <a href="/dich-vu/dan-film-tu-bep/">dán film tủ bếp</a> để chuẩn bị thông tin hiện trạng.</p></section>
  <section aria-labelledby="metal-counter"><figure class="metal-topic-photo"><img src="/images/perspectives/champagne-metal-reception.webp" alt="Phối cảnh minh họa quầy tiếp đón với bề mặt ánh kim champagne" width="1200" height="800" loading="lazy" decoding="async" /><figcaption>Phối cảnh minh họa cách tạo điểm nhấn ánh kim tại quầy.</figcaption></figure><h2 id="metal-counter">Vách nội thất, mặt quầy và điểm nhấn không gian</h2><p>Film ánh kim có thể tạo nhịp sáng cho vách hoặc quầy tiếp đón. Nên cân nhắc diện tích mảng dán, vị trí đèn và các bề mặt đặt cạnh nhau để tránh cảm giác quá chói. Với mặt bàn hoặc quầy sử dụng thường xuyên, cần xác nhận đặc tính của đúng mã film theo nhu cầu tiếp xúc và vệ sinh.</p></section>
  <section aria-labelledby="metal-elevator"><figure class="metal-topic-photo"><img src="/images/perspectives/walnut-elevator.webp" alt="Phối cảnh minh họa cabin thang máy kết hợp vân gỗ và nẹp ánh kim" width="1200" height="800" loading="lazy" decoding="async" /><figcaption>Phối cảnh minh họa kết hợp gỗ và chi tiết ánh kim trong cabin.</figcaption></figure><h2 id="metal-elevator">Cabin và sảnh thang máy</h2><p>Các mảng trang trí trong cabin hoặc sảnh thang máy có thể được khảo sát để làm mới bằng film. Phạm vi phải phối hợp với ban quản lý hoặc đơn vị bảo trì, chú ý mối nối, bảng điều khiển và các vị trí cần tiếp cận. Tham khảo <a href="/dich-vu/dan-film-thang-may/">dịch vụ dán film thang máy</a> trước khi lên phương án.</p></section>

  <section aria-labelledby="metal-selection"><figure class="metal-topic-photo"><img src="/images/bo-suu-tap/film-noi-that-mau-kim-loai-tong-dong.webp" alt="Mẫu film kim loại CORANCE CSM004 tông đồng để đối chiếu sắc độ" width="1200" height="800" loading="lazy" decoding="async" /><figcaption>Mẫu màu tông đồng; nên xem trực tiếp dưới ánh sáng nơi sử dụng.</figcaption></figure><h2 id="metal-selection">Cách chọn màu và hiệu ứng kim loại phù hợp</h2><p>Hãy chọn mẫu trong mối tương quan với ánh sáng và nội thất đang có. Sắc bạc thường phù hợp khi bạn muốn một điểm nhấn trung tính; champagne và đồng có thể kết nối với bảng màu ấm. Đây là hướng phối tham khảo, cần đối chiếu bằng mẫu thật trong từng không gian.</p><ul><li><strong>Kiểm tra dưới nhiều nguồn sáng:</strong> xem mẫu ở vị trí dự định dán, cả khi có ánh sáng tự nhiên và khi bật đèn.</li><li><strong>Thống nhất hướng vân:</strong> với mẫu có vân xước hoặc hướng phản chiếu rõ, cần tính chiều dán trên cánh tủ và các tấm liền kề.</li><li><strong>Cân bằng với chất liệu khác:</strong> phối cùng <a href="/vat-lieu/van-go/">film vân gỗ</a> hoặc <a href="/vat-lieu/don-sac/">film đơn sắc</a> để mảng ánh kim có khoảng nghỉ.</li><li><strong>Chọn theo công năng:</strong> vách trang trí và mặt quầy chịu tiếp xúc có điều kiện sử dụng khác nhau; thông số cần theo đúng sản phẩm.</li></ul><p>Bạn có thể xem <a href="/huong-dan-phoi-mau-dilm-noi-that/">hướng dẫn phối màu và chất liệu nội thất</a> để tìm một bảng màu tổng thể trước khi chọn mã film.</p></section>

  <section aria-labelledby="metal-price"><figure class="metal-topic-photo"><img src="/images/vat-lieu/kim-loai/CSM003.jpg" alt="Ảnh cuộn film kim loại dùng để tham khảo bề mặt và chiều vân" width="1200" height="800" loading="lazy" decoding="async" /><figcaption>Lượng vật tư cần tính theo khổ cuộn, kích thước và chiều vân.</figcaption></figure><h2 id="metal-price">Giá film kim loại và cách dự tính vật tư</h2>{priceRange && <p>Các mẫu film kim loại có giá công bố trong danh mục hiện nằm trong khoảng <strong>{priceRange} / mét dài</strong>. Đây là khoảng giá của các sản phẩm đang niêm yết, không phải giá chung cho mọi mẫu hoặc giá thi công trọn gói. Với sản phẩm ghi “Liên hệ báo giá”, cần xác nhận giá theo mã và số lượng.</p>}<p>Để dự tính lượng film, cần có kích thước bề mặt, khổ cuộn, chiều vân, phần ôm cạnh và vị trí ghép tấm. Không nên chỉ lấy tổng diện tích rồi quy đổi sang mét dài mà bỏ qua cách bố trí tấm. Chi phí thi công còn phụ thuộc xử lý nền, tháo lắp, số góc cạnh và địa điểm công trình.</p><p>Khi gửi yêu cầu, hãy kèm mã mẫu hoặc tông màu mong muốn, ảnh hiện trạng và kích thước. Những thông tin này giúp việc tư vấn vật liệu và trao đổi chi phí cụ thể hơn.</p></section>

  <section aria-labelledby="metal-installation"><figure class="metal-topic-photo"><img src="/images/vat-lieu/kim-loai/CSM003-thuc-te.jpg" alt="Thao tác tham khảo hoàn thiện các tấm nội thất bằng film ánh kim" width="1200" height="800" loading="lazy" decoding="async" /><figcaption>Ảnh tham khảo hoàn thiện film tại các góc và cạnh nội thất.</figcaption></figure><h2 id="metal-installation">Lưu ý khi thi công và chăm sóc bề mặt</h2><p>Bề mặt ánh kim dễ làm lộ điểm gồ, khuyết tật nền và khác biệt hướng vân dưới ánh sáng xiên. Trước khi dán, cần kiểm tra độ phẳng, độ khô, lớp hoàn thiện cũ và khả năng bám; các vùng bong, ẩm hoặc thiếu ổn định phải được xử lý theo phương án phù hợp.</p><p>Sau khi hoàn thiện, vệ sinh bằng khăn mềm và phương pháp được hướng dẫn cho đúng mã vật liệu. Tránh dùng vật sắc, miếng chà nhám hoặc hóa chất chưa xác nhận tương thích. Với vị trí gần nguồn nhiệt, tiếp xúc nước thường xuyên hoặc ngoài trời, cần kiểm tra thông số riêng, không suy rộng từ tên gọi hay hình ảnh của sản phẩm.</p></section>
</div></section>
<section class="metal-faq" aria-labelledby="metal-faq-title"><div class="metal-reading"><div class="metal-faq-heading"><img src="/images/vat-lieu/kim-loai/Inox-xuoc-bac.jpg" alt="Bề mặt film hiệu ứng kim loại xước bạc" width="1280" height="854" loading="lazy" /><div><p class="metal-eyebrow">GIẢI ĐÁP VỀ VẬT LIỆU</p><h2 id="metal-faq-title">Câu hỏi thường gặp về film dán nội thất kim loại</h2></div></div><div class="metal-faq-list">{metalMaterialFaqs.map(faq=><details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div></div></section>
<style>
  .metal-guide { padding: clamp(2.5rem,5vw,4.5rem) 0; background: white; scroll-margin-top: 7rem; }
  .metal-reading { width: min(1280px,calc(100% - 40px)); margin-inline: auto; }
  .metal-eyebrow { font-size: .625rem; font-weight: 600; letter-spacing: .12em; color: var(--muted); margin-bottom: .75rem; }
  .metal-guide h2, .metal-faq h2 { font-size: 1.5rem; line-height: 1.35; font-weight: 500; color: var(--navy); }
  .metal-guide header h2 { max-width: 48rem; }
  .metal-guide h3 { font-size: 1.125rem; line-height: 1.5; font-weight: 500; margin-top: 1.5rem; }
  .metal-guide p:not(.metal-eyebrow), .metal-guide ul { margin-top: 1rem; font-size: 1rem; line-height: 1.85; color: var(--muted); }
  .metal-content-grid { display: grid; grid-template-columns: minmax(0,1fr); gap: 2rem; }
  .metal-content-grid > header, .metal-content-grid > section { min-width: 0; margin: 0; padding: 1.25rem; border-radius: 18px; background: #f6f7f9; }
  .metal-topic-photo { margin: 0 0 1.25rem; }
  .metal-topic-photo img { display: block; width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: 12px; }
  .metal-topic-photo figcaption { font-size: .6875rem; line-height: 1.6; color: var(--muted); margin-top: .625rem; }
  .metal-faq-heading { display: grid; gap: 1.5rem; align-items: center; }
  .metal-faq-heading > img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 14px; }
  @media(min-width:1024px) {
    .metal-content-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 2rem; }
    .metal-content-grid > header, .metal-content-grid > section { padding: 1.5rem; }
    .metal-faq-heading { grid-template-columns: .65fr 1.35fr; gap: 2rem; }
    .metal-faq-list { grid-template-columns: repeat(2,minmax(0,1fr)); align-items: start; }
  }
  .metal-guide ul { list-style: disc; padding-left: 1.25rem; }
  .metal-guide li + li { margin-top: .75rem; }
  .metal-guide strong { font-weight: 500; color: var(--navy); }
  .metal-guide a { color: var(--navy); text-decoration: underline; text-decoration-color: var(--pearl); text-underline-offset: .2em; }
  .metal-guide a:hover { text-decoration-color: var(--navy); }
  .metal-faq { padding: clamp(2.5rem,5vw,4.5rem) 0; background: #f4f6f8; }
  .metal-faq-list { display: grid; gap: .75rem; margin-top: 1.75rem; }
  .metal-faq details { padding: 1.25rem; background: white; border-radius: 12px; }
  .metal-faq summary { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; font-size: .9375rem; font-weight: 500; line-height: 1.6; list-style: none; cursor: pointer; }
  .metal-faq summary::-webkit-details-marker { display: none; }
  .metal-faq summary span { flex-shrink: 0; font-size: 1.25rem; line-height: 1.2; transition: transform 160ms; }
  .metal-faq details[open] summary span { transform: rotate(45deg); }
  .metal-faq details p { margin-top: 1rem; color: var(--muted); font-size: .9375rem; line-height: 1.8; }
  @media(min-width:640px) { .metal-reading { width: min(1280px,calc(100% - 48px)); } }
</style>
