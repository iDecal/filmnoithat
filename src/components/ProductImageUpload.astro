---
import ProductEditor from "./ProductEditor.astro";
import type { CatalogueSample } from "../data/catalogue";
interface Props { sample: CatalogueSample }
const { sample } = Astro.props;
---
<div hidden data-admin-only class="mt-5" data-product-upload data-slug={sample.slug} data-brand={sample.brand} data-primary={sample.image} data-extra-count={(sample.gallery || []).filter(photo => !(sample.hiddenImages || []).includes(photo.src)).length}>
  <dialog data-product-tools class="rounded-2xl bg-white p-5 sm:p-7 w-[min(72rem,calc(100%-2rem))] max-h-[90dvh] overflow-y-auto" aria-label="Quản lý ảnh và sản phẩm"><div class="flex justify-between items-center gap-3 mb-4"><h2 data-product-tools-title class="text-xl font-semibold">Sửa sản phẩm {sample.brand} {sample.code}</h2><button type="button" data-product-tools-close class="button-secondary">Đóng ×</button></div>
  <ProductEditor />
  <h3 class="text-lg font-semibold mt-6 mb-3">Ảnh sản phẩm</h3>
  <p class="text-sm mb-4">Kéo thả hoặc dùng nút ← → để sắp xếp ảnh, rồi bấm Lưu thứ tự ảnh. Ảnh đầu tiên là ảnh chính, dùng ở danh sách sản phẩm và các vị trí khác.</p><div data-admin-photo-picker class="flex flex-wrap gap-2 mb-4"></div>
  <div class="flex flex-wrap gap-3 items-center" data-photo-actions>
    <button type="button" data-upload-open aria-expanded="false" class="button-secondary" title="Tải một hoặc nhiều ảnh vật liệu">Tải ảnh</button>
    <button type="button" data-image-primary class="button-secondary" title="Đặt ảnh đang chọn làm ảnh chính">Ảnh chính</button>
    <button type="button" data-image-delete class="button-secondary">Xóa ảnh</button>
    <button type="button" data-order-save class="button-primary" disabled>Lưu thứ tự</button>
    <button type="button" data-order-reset class="button-secondary" disabled>Hủy sắp xếp</button>
    <button type="button" data-product-delete class="button-secondary">Xóa sản phẩm</button>
  </div>
  <dialog data-product-delete-dialog class="rounded-2xl bg-white p-7" aria-label="Xóa sản phẩm"><h2 class="text-xl font-semibold">Xóa sản phẩm {sample.brand} {sample.code}?</h2><p class="mt-3">Sản phẩm sẽ bị gỡ khỏi website. Các tệp ảnh được giữ lại.</p><div class="flex gap-3 mt-5"><button type="button" data-product-delete-confirm class="button-primary">Xác nhận xóa sản phẩm</button><button type="button" data-product-delete-cancel class="button-secondary">Hủy</button></div></dialog>
  <p data-delete-hint class="text-xs text-base-600 mt-2"></p>
  <dialog data-delete-dialog class="rounded-2xl bg-white p-5 sm:p-7 w-[min(30rem,calc(100%-2rem))]" aria-label="Xác nhận xóa ảnh sản phẩm">
    <h2 class="text-xl font-semibold">Xóa ảnh này khỏi sản phẩm?</h2>
    <img data-delete-preview alt="Ảnh được chọn để xóa" class="w-full max-h-64 object-contain mt-4 rounded-lg" />
    <p class="text-sm text-base-600 mt-4">Ảnh sẽ không còn hiển thị trong sản phẩm này. Ảnh dùng ở những sản phẩm khác được giữ nguyên.</p>
    <div class="flex gap-3 mt-5"><button type="button" data-delete-confirm class="button-primary">Xác nhận xóa</button><button type="button" data-delete-cancel class="button-secondary">Hủy</button></div>
  </dialog>
  <form data-upload-form hidden class="mt-4 rounded-2xl border border-base-200 bg-white p-5 space-y-4">
    <p class="font-medium">Thêm ảnh cho mẫu {sample.brand} {sample.code}</p>
    <label data-upload-drop class="block text-sm font-medium rounded-xl border-2 border-dashed border-base-300 p-5">Kéo thả ảnh vào đây hoặc chọn ảnh từ máy<input data-upload-file type="file" multiple accept="image/jpeg,image/png,image/webp" required class="block w-full mt-2 text-sm" /></label>
    <p class="text-xs text-base-600">JPG, PNG hoặc WebP, tối đa 5 MB mỗi ảnh. Có thể chọn nhiều ảnh. Tiêu đề và ALT được tự điền theo tên sản phẩm và thương hiệu. Ảnh mới được thêm vào thư viện, giữ nguyên ảnh chính.</p>
    <label class="flex items-start gap-3 text-sm"><input data-upload-sharpen type="checkbox" checked class="mt-1" /><span>Tự động làm nét nhẹ<span class="block text-xs text-base-600 mt-1">Xem trước ảnh đã xử lý; bỏ chọn để giữ ảnh gốc.</span></span></label>
    <div data-upload-previews class="flex flex-wrap gap-2"></div>
    <img data-upload-preview hidden alt="Xem trước ảnh đã chọn" class="w-full max-h-72 object-contain rounded-lg bg-base-50" />
    <p class="text-sm text-base-600">Khi lưu, đăng nhập GitHub bằng tài khoản có quyền chỉnh sửa website. Không cần mở trang quản trị. Ảnh được lưu trực tiếp và hiển thị công khai sau khi website cập nhật.</p>
    <div class="flex flex-wrap gap-3"><button data-upload-save type="submit" class="button-primary">Lưu ảnh vào sản phẩm</button><button data-upload-cancel type="button" class="button-secondary">Đóng</button></div>
  </form>
  <p data-upload-status role="status" aria-live="polite" class="text-sm text-base-600 mt-3"></p>
  </dialog>
</div>
<script>
  import { loginAdmin, logoutAdmin } from "../lib/admin-session";
  import { prepareProductImage } from "../lib/product-image-preparation.mjs";
  document.querySelectorAll<HTMLElement>("[data-product-upload]").forEach(root => {
    const form = root.querySelector<HTMLFormElement>("[data-upload-form]")!;
    const open = root.querySelector<HTMLButtonElement>("[data-upload-open]")!;
    const fileInput = root.querySelector<HTMLInputElement>("[data-upload-file]")!;
    const sharpenInput = root.querySelector<HTMLInputElement>("[data-upload-sharpen]")!;
    const preview = root.querySelector<HTMLImageElement>("[data-upload-preview]")!;
    const save = root.querySelector<HTMLButtonElement>("[data-upload-save]")!;
    const status = root.querySelector<HTMLElement>("[data-upload-status]")!;
    const gallery = root.parentElement!.querySelector<HTMLElement>("[data-product-gallery]")!;
    const tools = root.querySelector<HTMLDialogElement>("[data-product-tools]")!;
    const picker = root.querySelector<HTMLElement>("[data-admin-photo-picker]")!;
    let draftOrder: string[] | null = null;
    let baseOrder: string[] | null = null;
    let draggedSource: string | null = null;
    const orderSave = root.querySelector<HTMLButtonElement>("[data-order-save]")!;
    const orderReset = root.querySelector<HTMLButtonElement>("[data-order-reset]")!;
    const sourceOf = (thumb: HTMLButtonElement) => thumb.dataset.storedSrc || thumb.dataset.src || "";
    const materialThumbs = () => [...gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")].filter(thumb => thumb.dataset.material === "true");
    const currentOrder = () => {
      const sources = materialThumbs().map(sourceOf);
      return [root.dataset.primary!, ...sources.filter(src => src !== root.dataset.primary)];
    };
    const movePhoto = (source: string, target: number) => {
      if (busy || processing || root.dataset.editorBusy === "true") return;
      if (!draftOrder) { baseOrder = currentOrder(); draftOrder = [...baseOrder]; }
      const from = draftOrder.indexOf(source);
      if (from < 0 || target < 0 || target >= draftOrder.length) return;
      draftOrder.splice(from, 1); draftOrder.splice(target, 0, source); syncPicker();
    };
    const syncPicker = () => {
      const latest = currentOrder();
      if (baseOrder && JSON.stringify(latest) !== JSON.stringify(baseOrder)) { draftOrder = baseOrder = null; status.textContent = "Thư viện ảnh đã thay đổi; hãy sắp xếp lại từ thư viện mới."; }
      const blocked = busy || processing || root.dataset.editorBusy === "true";
      const ordered = draftOrder || latest;
      const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")];
      const sorted = [...ordered.map(src => thumbs.find(thumb => sourceOf(thumb) === src)).filter((thumb): thumb is HTMLButtonElement => !!thumb), ...thumbs.filter(thumb => !ordered.includes(sourceOf(thumb)))];
      picker.replaceChildren();
      sorted.forEach(thumb => {
        const source = sourceOf(thumb); const index = ordered.indexOf(source); const material = index >= 0;
        const card = document.createElement("div"); card.dataset.photoCard = ""; card.dataset.src = source; card.className = "rounded-lg border p-2 bg-white"; card.draggable = material && !blocked;
        const button = document.createElement("button"); button.type = "button"; button.dataset.photoSelect = ""; button.className = "rounded-lg border-2 p-1";
        button.style.borderColor = thumb.getAttribute("aria-pressed") === "true" ? "#a35e24" : "transparent";
        button.setAttribute("aria-label", thumb.dataset.alt || "Chọn ảnh"); button.setAttribute("aria-pressed", thumb.getAttribute("aria-pressed") || "false");
        const img = document.createElement("img"); img.src = thumb.dataset.src!; img.alt = ""; img.draggable = false; img.className = "w-16 h-16 object-cover";
        const label = document.createElement("span"); label.className = "block text-xs mt-1"; label.textContent = material ? index === 0 ? "1 · Ảnh chính" : `${index + 1} · Ảnh bổ sung` : "Tham khảo";
        button.append(img, label); button.addEventListener("click", () => { thumb.click(); syncPicker(); }); card.append(button);
        if (material) {
          const controls = document.createElement("div"); controls.className = "flex justify-between mt-1";
          for (const delta of [-1, 1]) {
            const arrow = document.createElement("button"); arrow.type = "button"; arrow.textContent = delta < 0 ? "←" : "→"; arrow.dataset.photoMove = String(delta); arrow.className = "min-w-10 min-h-10 rounded border";
            arrow.setAttribute("aria-label", delta < 0 ? "Đưa ảnh về trước" : "Đưa ảnh ra sau"); arrow.disabled = blocked || index + delta < 0 || index + delta >= ordered.length;
            arrow.addEventListener("click", () => { movePhoto(source, index + delta); picker.querySelector<HTMLElement>(`[data-photo-card][data-src="${CSS.escape(source)}"] [data-photo-select]`)?.focus(); }); controls.append(arrow);
          }
          card.append(controls);
          card.addEventListener("dragstart", event => { if (blocked) { event.preventDefault(); return; } draggedSource = source; event.dataTransfer!.setData("text/plain", source); event.dataTransfer!.effectAllowed = "move"; });
          card.addEventListener("dragover", event => { if (!blocked && draggedSource) event.preventDefault(); });
          card.addEventListener("drop", event => { event.preventDefault(); if (draggedSource) movePhoto(draggedSource, index); draggedSource = null; });
          card.addEventListener("dragend", () => { draggedSource = null; });
        }
        picker.append(card);
      });
      const changed = !!draftOrder && JSON.stringify(draftOrder) !== JSON.stringify(baseOrder);
      orderSave.disabled = blocked || !changed; orderReset.disabled = blocked || !changed;
    };
    orderReset.addEventListener("click", () => { draftOrder = baseOrder = null; syncPicker(); });
    window.addEventListener("admin-product-tools", () => { if (!root.hidden) { syncPicker(); tools.showModal(); } });
    root.querySelector("[data-product-tools-close]")!.addEventListener("click", () => { if (!busy && root.dataset.editorBusy !== "true") tools.close(); });
    window.addEventListener("admin-logout", () => { root.querySelectorAll("dialog").forEach(dialog => dialog.close()); root.hidden = true; });
    const deleteButton = root.querySelector<HTMLButtonElement>("[data-image-delete]")!;
    const deleteHint = root.querySelector<HTMLElement>("[data-delete-hint]")!;
    const deleteDialog = root.querySelector<HTMLDialogElement>("[data-delete-dialog]")!;
    const deleteConfirm = root.querySelector<HTMLButtonElement>("[data-delete-confirm]")!;
    let deleteTarget: HTMLButtonElement | null = null;
    let token: string | null = null;
    window.addEventListener("admin-logout", () => { token = null; });
    let previewUrl: string | null = null;
    let busy = false;
    let processing = false;
    let preparation = 0;
    let preparedFile: File | null = null;
    let pendingFiles: File[] = [];
    let batchUrls: string[] = [];
    const selectedPhoto = () => gallery.querySelector<HTMLButtonElement>('[data-gallery-thumb][aria-pressed="true"]');
    const storedSource = (button: HTMLButtonElement) => button.dataset.storedSrc || button.dataset.src || "";
    const updateDeleteState = () => {
      const blocked = busy || processing || root.dataset.editorBusy === "true";
      root.dataset.mediaBusy = String(busy || processing);
      fileInput.disabled = blocked; sharpenInput.disabled = blocked; open.disabled = blocked;
      save.disabled = blocked || !pendingFiles.length;
      syncPicker();
      const selected = selectedPhoto();
      const lastMaterial = selected && storedSource(selected) === root.dataset.primary && Number(root.dataset.extraCount || 0) < 1;
      root.querySelector<HTMLButtonElement>("[data-image-primary]")!.disabled = blocked || !selected || storedSource(selected) === root.dataset.primary || !(storedSource(selected) === root.dataset.primary || selected.dataset.material === "true");
      root.querySelector<HTMLButtonElement>("[data-product-delete]")!.disabled = blocked;
      deleteButton.disabled = blocked || !selected || !!lastMaterial;
      deleteHint.textContent = lastMaterial ? "Để xóa ảnh chính, hãy tải thêm một ảnh vật liệu trước." : "Chọn ảnh trong thư viện rồi bấm xóa.";
    };
    root.addEventListener("product-editor-lock", updateDeleteState);
    root.addEventListener("product-editor-saved", event => {
      const product = (event as CustomEvent).detail;
      root.querySelector<HTMLElement>("[data-product-tools-title]")!.textContent = `Sửa sản phẩm ${product.brand} ${product.code}`;
      gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]").forEach(thumb => {
        const src = storedSource(thumb); const photo = src === product.image ? {alt: product.imageAlt, title: product.imageTitle} : (product.gallery || []).find((item: {src: string}) => item.src === src);
        if (photo) { thumb.dataset.alt = photo.alt || thumb.dataset.alt || ""; thumb.dataset.title = photo.title || photo.alt || thumb.dataset.title || ""; }
      });
      selectedPhoto()?.click();
    });
    gallery.addEventListener("click", updateDeleteState);
    updateDeleteState();
    deleteButton.addEventListener("click", () => {
      deleteTarget = selectedPhoto(); if (!deleteTarget || deleteButton.disabled) return;
      root.querySelector<HTMLImageElement>("[data-delete-preview]")!.src = deleteTarget.dataset.src!;
      deleteDialog.showModal();
    });
    root.querySelector("[data-delete-cancel]")!.addEventListener("click", () => { if (!busy) deleteDialog.close(); });
    const close = () => { if (busy) return; form.hidden = true; open.setAttribute("aria-expanded", "false"); };
    open.addEventListener("click", () => { form.hidden = !form.hidden; open.setAttribute("aria-expanded", String(!form.hidden)); });
    root.querySelector("[data-upload-cancel]")!.addEventListener("click", close);
    const prepare = async () => {
      if (busy) return;
      const version = ++preparation;
      batchUrls.forEach(url => URL.revokeObjectURL(url)); batchUrls = []; root.querySelector("[data-upload-previews]")!.replaceChildren();
      pendingFiles = []; preparedFile = null; processing = false; save.disabled = false; updateDeleteState();
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = null; preview.hidden = true; status.textContent = "";
      const originals = [...(fileInput.files || [])]; const original = originals[0]; if (!original) return;
      if (originals.some(file => !["image/jpeg","image/png","image/webp"].includes(file.type) || file.size > 5 * 1024 * 1024)) { status.textContent = "Chọn ảnh JPG, PNG hoặc WebP, tối đa 5 MB."; fileInput.value = ""; return; }
      processing = true; save.disabled = true; updateDeleteState();
      status.textContent = sharpenInput.checked ? "Đang làm nét nhẹ và chuẩn bị ảnh xem trước…" : "Đang chuẩn bị ảnh gốc…";
      try {
        // Let the processing message paint before pixel processing starts.
        await new Promise(resolve => window.setTimeout(resolve, 0));
        const result = sharpenInput.checked ? await prepareProductImage(original) : null;
        if (version !== preparation) return;
        preparedFile = result?.file || original;
        const batch: File[] = [preparedFile];
        for (const next of originals.slice(1)) {
          const processed = sharpenInput.checked ? await prepareProductImage(next) : null;
          if (version !== preparation) return;
          batch.push(processed?.file || next);
        }
        pendingFiles = batch;
        previewUrl = URL.createObjectURL(preparedFile); preview.src = previewUrl;
        await preview.decode();
        if (version !== preparation) return;
        preview.hidden = false;
        for (const file of batch) { const image = document.createElement("img"); const url = URL.createObjectURL(file); batchUrls.push(url); image.src = url; image.alt = `Xem trước ${file.name}`; image.className = "w-20 h-20 object-contain rounded-lg"; root.querySelector("[data-upload-previews]")!.append(image); }
        status.textContent = `Đã chuẩn bị ${pendingFiles.length} ảnh. ` + (result ? `Đã làm nét nhẹ${result.resized ? " và tối ưu kích thước" : ""}. Bạn có thể xem trước hoặc bỏ chọn để dùng ảnh gốc.` : "Đang dùng ảnh gốc, không làm nét.");
      } catch (error) {
        if (version !== preparation) return;
        pendingFiles = []; preparedFile = null; preview.hidden = true;
        status.textContent = error instanceof Error ? error.message : "Không đọc được ảnh. Hãy thử ảnh khác hoặc tắt làm nét.";
      } finally { if (version === preparation) { processing = false; save.disabled = !preparedFile; updateDeleteState(); } }
    };
    const drop = root.querySelector<HTMLElement>("[data-upload-drop]")!;
    drop.addEventListener("dragover", event => { event.preventDefault(); if (!fileInput.disabled) drop.classList.add("bg-base-100"); });
    drop.addEventListener("dragleave", () => drop.classList.remove("bg-base-100"));
    drop.addEventListener("drop", event => { event.preventDefault(); drop.classList.remove("bg-base-100"); if (fileInput.disabled || !event.dataTransfer?.files.length) return; fileInput.files = event.dataTransfer.files; prepare(); });
    fileInput.addEventListener("change", prepare);
    sharpenInput.addEventListener("change", prepare);
    const login = loginAdmin;
    const showInGallery = (url: string, alt: string, title: string, caption: string, width: number, height: number, storedSrc: string) => {
      const gallery = root.parentElement?.querySelector<HTMLElement>("[data-product-gallery]"); if (!gallery) return;
      const button = document.createElement("button"); button.type = "button";
      button.className = "gallery-thumb w-16 sm:w-20 rounded-lg overflow-hidden bg-white border-2 border-transparent";
      button.dataset.material = "true"; button.dataset.galleryThumb = ""; button.dataset.src = url; button.dataset.storedSrc = storedSrc;
      button.dataset.title = title; button.dataset.alt = alt; button.dataset.caption = caption; button.dataset.width = String(width); button.dataset.height = String(height);
      button.setAttribute("aria-label", `Ảnh vừa tải lên: ${alt}`);
      const thumbnail = document.createElement("img"); thumbnail.src = url; thumbnail.alt = ""; thumbnail.className = "w-full aspect-[4/3] object-cover";
      const label = document.createElement("span"); label.textContent = "Vừa tải lên"; label.className = "block text-[10px] sm:text-xs py-1.5 text-base-700";
      button.append(thumbnail, label);
      button.addEventListener("click", () => {
        gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]").forEach(thumb => thumb.setAttribute("aria-pressed", String(thumb === button)));
        gallery.querySelectorAll<HTMLImageElement>("[data-gallery-main], [data-gallery-zoom]").forEach(image => { image.src = url; image.alt = button.dataset.alt || alt; image.title = button.dataset.title || title; image.width = width; image.height = height; });
        gallery.querySelectorAll<HTMLElement>("[data-gallery-caption], [data-gallery-zoom-caption]").forEach(element => { element.textContent = caption; });
      });
      gallery.querySelector('[role="group"]')?.append(button); button.click();
    };
    orderSave.addEventListener("click", async () => {
      if (busy || processing || root.dataset.editorBusy === "true" || !draftOrder || !baseOrder) return;
      const order = [...draftOrder]; const baseline = [...baseOrder];
      busy = true; updateDeleteState();
      try {
        token = token || await login();
        const response = await fetch("/api/product-images", {method: "PATCH", headers: {Authorization: `Bearer ${token}`, "Content-Type": "application/json"}, body: JSON.stringify({slug: root.dataset.slug, brand: root.dataset.brand, action: "reorder", order, baseOrder: baseline})});
        const result = await response.json();
        if (!response.ok) { if (response.status === 401) { token = null; logoutAdmin(); } throw new Error(result.message || "Chưa lưu được thứ tự ảnh."); }
        const group = gallery.querySelector('[role="group"]')!;
        for (const src of result.order) { const thumb = [...group.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")].find(item => sourceOf(item) === src); if (thumb) group.append(thumb); }
        group.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]").forEach(thumb => { if (!result.order.includes(sourceOf(thumb))) group.append(thumb); });
        root.dataset.primary = result.primary; root.dataset.extraCount = String(result.galleryCount); draftOrder = baseOrder = null;
        group.querySelector<HTMLButtonElement>("[data-gallery-thumb]")?.click();
        root.dispatchEvent(new Event("product-media-saved")); status.textContent = result.message;
      } catch (error) { status.textContent = error instanceof Error ? error.message : "Chưa lưu được thứ tự ảnh."; }
      finally { busy = false; updateDeleteState(); }
    });
    deleteConfirm.addEventListener("click", async () => {
      if (busy || !deleteTarget) return;
      const target = deleteTarget; const src = storedSource(target);
      busy = true; deleteConfirm.disabled = true; save.disabled = true; open.disabled = true; fileInput.disabled = true; sharpenInput.disabled = true; updateDeleteState();
      try {
        token = token || await login();
        const response = await fetch("/api/product-images", { method: "DELETE", headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" }, body: JSON.stringify({ slug: root.dataset.slug, brand: root.dataset.brand, src }) });
        const result = await response.json();
        if (!response.ok) { if (response.status === 401) { token = null; logoutAdmin(); } throw new Error(result.message || "Chưa xóa được ảnh."); }
        root.dataset.primary = result.primary; root.dataset.extraCount = String(result.galleryCount);
        target.remove(); gallery.querySelector<HTMLButtonElement>("[data-gallery-thumb]")?.click();
        deleteDialog.close(); status.textContent = result.message; root.dispatchEvent(new Event("product-media-saved"));
      } catch (error) { status.textContent = error instanceof Error ? error.message : "Chưa xóa được ảnh."; deleteDialog.close(); }
      finally { busy = false; deleteConfirm.disabled = false; save.disabled = processing || (!!fileInput.files?.length && !preparedFile); open.disabled = false; fileInput.disabled = false; sharpenInput.disabled = false; updateDeleteState(); }
    });
    const primaryButton = root.querySelector<HTMLButtonElement>("[data-image-primary]")!;
    const productDeleteButton = root.querySelector<HTMLButtonElement>("[data-product-delete]")!;
    const productDialog = root.querySelector<HTMLDialogElement>("[data-product-delete-dialog]")!;
    productDeleteButton.addEventListener("click", () => { if (!busy && !processing) productDialog.showModal(); });
    root.querySelector("[data-product-delete-cancel]")!.addEventListener("click", () => { if (!busy) productDialog.close(); });
    const manage = async (removeProduct: boolean) => {
      if (busy || processing) return;
      const selected = selectedPhoto(); if (!removeProduct && !selected) return;
      busy = true; updateDeleteState(); primaryButton.disabled = true; productDeleteButton.disabled = true;
      try {
        token = token || await login();
        const response = await fetch("/api/product-images", { method: removeProduct ? "DELETE" : "PATCH", headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" }, body: JSON.stringify({ slug: root.dataset.slug, brand: root.dataset.brand, ...(removeProduct ? { action: "delete-product" } : { src: storedSource(selected!) }) }) });
        const result = await response.json();
        if (!response.ok) { if (response.status === 401) { token = null; logoutAdmin(); } throw new Error(result.message || "Chưa lưu được thay đổi."); }
        status.textContent = result.message;
        if (removeProduct) { root.dispatchEvent(new Event("product-deleted")); productDialog.close(); window.location.assign("/vat-lieu"); return; }
        root.dataset.primary = result.primary; root.dataset.extraCount = String(result.galleryCount);
        root.dispatchEvent(new Event("product-media-saved"));
        gallery.querySelectorAll<HTMLElement>("[data-gallery-thumb] span").forEach(label => { label.textContent = storedSource(label.parentElement as HTMLButtonElement) === result.primary ? "Ảnh chính" : "Ảnh bổ sung"; });
      } catch (error) { productDialog.close(); status.textContent = error instanceof Error ? error.message : "Chưa lưu được thay đổi."; }
      finally { busy = false; primaryButton.disabled = false; productDeleteButton.disabled = false; updateDeleteState(); }
    };
    primaryButton.addEventListener("click", () => manage(false));
    root.querySelector("[data-product-delete-confirm]")!.addEventListener("click", () => manage(true));
    form.addEventListener("submit", async event => {
      event.preventDefault(); if (busy || processing || !form.reportValidity()) return;
      if (!pendingFiles.length) return;
      let savedCount = 0;
      busy = true; save.disabled = true; open.disabled = true; updateDeleteState();
      fileInput.disabled = true; sharpenInput.disabled = true;
      try {
        // Open the popup during the user gesture so browser popup blockers allow it.
        const authentication = token ? Promise.resolve(token) : login();
        status.textContent = "Đang xác nhận quyền chỉnh sửa và lưu ảnh…";
        token = await authentication;
        for (const file of [...pendingFiles]) {
          const decoded = await createImageBitmap(file);
          const width = decoded.width; const height = decoded.height; decoded.close();
          const body = new FormData(); body.set("file", file); body.set("slug", root.dataset.slug!); body.set("brand", root.dataset.brand!);
          body.set("alt", ""); body.set("caption", ""); body.set("width", String(width)); body.set("height", String(height));
          const response = await fetch("/api/product-images", { method: "POST", headers: { Authorization: `Bearer ${token}` }, body });
          const result = await response.json();
          if (!response.ok) { if (response.status === 401) { token = null; logoutAdmin(); } throw new Error(result.message || "Chưa lưu được ảnh. Vui lòng thử lại."); }
          const savedPreview = URL.createObjectURL(file);
          showInGallery(savedPreview, result.photo.alt, result.photo.title || result.photo.alt, result.photo.caption || "Ảnh vật liệu vừa tải lên.", width, height, result.photo.src);
          root.dataset.extraCount = String(Number(root.dataset.extraCount || 0) + 1);
          pendingFiles.shift(); savedCount++; status.textContent = `Đã lưu ${savedCount} ảnh. Website đang cập nhật.`;
        }
        batchUrls.forEach(url => URL.revokeObjectURL(url)); batchUrls = []; root.querySelector("[data-upload-previews]")!.replaceChildren();
        root.dispatchEvent(new Event("product-media-saved"));
        form.reset(); preparedFile = null; pendingFiles = []; preview.hidden = true; if (previewUrl) URL.revokeObjectURL(previewUrl); previewUrl = null;
      } catch (error) { status.textContent = `${savedCount ? `Đã lưu ${savedCount} ảnh. ` : ""}${error instanceof Error ? error.message : "Chưa lưu được ảnh."} Bấm lưu để thử lại những ảnh còn lại.`; }
      finally { busy = false; save.disabled = false; open.disabled = false; fileInput.disabled = false; sharpenInput.disabled = false; updateDeleteState(); }
    });
  });
</script>
