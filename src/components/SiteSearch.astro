<button type="button" data-search-open class="search-open flex items-center justify-center w-11 h-11 rounded-xl border border-base-200 text-base-900" aria-label="Tìm kiếm sản phẩm và vật liệu" aria-haspopup="dialog" aria-controls="site-search">
  <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
</button>
<dialog id="site-search" class="site-search rounded-2xl bg-white p-5 sm:p-7" aria-labelledby="site-search-title">
  <div class="flex justify-between items-center gap-3"><h2 id="site-search-title" class="text-xl font-semibold">Tìm nhanh</h2><button type="button" data-search-close class="button-secondary">Đóng ×</button></div>
  <label for="site-search-input" class="block text-sm font-medium mt-5">Mã sản phẩm, thương hiệu hoặc vật liệu</label>
  <input id="site-search-input" type="search" autocomplete="off" placeholder="Ví dụ: 923-11, TODA, vân gỗ…" class="w-full rounded-lg border border-base-300 px-4 py-3 mt-2" autofocus />
  <p data-search-status role="status" aria-live="polite" class="text-sm text-base-600 mt-3">Nhập từ khóa để tìm sản phẩm và trang liên quan.</p>
  <ul data-search-results class="mt-3 divide-y divide-base-200"></ul>
</dialog>
<script>
  type Entry = { title: string; detail: string; href: string; image?: string; type: string };
  const open = document.querySelector<HTMLButtonElement>("[data-search-open]")!;
  const dialog = document.querySelector<HTMLDialogElement>("#site-search")!;
  const input = dialog.querySelector<HTMLInputElement>("input")!;
  const status = dialog.querySelector<HTMLElement>("[data-search-status]")!;
  const results = dialog.querySelector<HTMLUListElement>("[data-search-results]")!;
  const normalize = (text: string) => text.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d").replace(/[^a-z0-9]/g, "");
  let entries: Entry[] | null = null;
  let loading: Promise<void> | null = null;
  const render = () => {
    results.replaceChildren();
    const query = input.value.trim();
    if (!query) { status.textContent = "Nhập từ khóa để tìm sản phẩm và trang liên quan."; return; }
    if (!entries) return;
    const terms = query.split(/\s+/).map(normalize).filter(Boolean);
    if (!terms.length) { status.textContent = "Hãy nhập tên hoặc mã sản phẩm."; return; }
    const matches = entries.filter(entry => terms.every(term => normalize(`${entry.title} ${entry.detail}`).includes(term)));
    status.textContent = matches.length ? `${matches.length} kết quả${matches.length > 20 ? "; hiển thị 20 kết quả đầu. Nhập thêm để thu hẹp tìm kiếm." : "."}` : "Không tìm thấy kết quả. Thử mã hoặc từ khóa khác.";
    for (const entry of matches.slice(0, 20)) {
      const li = document.createElement("li");
      const link = document.createElement("a"); link.href = entry.href; link.className = "search-result flex items-center gap-3 py-3 rounded-lg";
      if (entry.image) { const image = document.createElement("img"); image.src = entry.image; image.alt = ""; image.width = 64; image.height = 48; image.loading = "lazy"; image.className = "w-16 h-12 object-cover rounded-md shrink-0"; link.append(image); }
      const text = document.createElement("span"); const title = document.createElement("span"); title.className = "block font-semibold"; title.textContent = entry.title;
      const detail = document.createElement("span"); detail.className = "block text-xs text-base-600 mt-1"; detail.textContent = `${entry.type}${entry.detail ? ` · ${entry.detail}` : ""}`;
      text.append(title, detail); link.append(text); li.append(link); results.append(li);
    }
  };
  const load = async () => {
    if (entries) { render(); return; }
    if (loading) return loading;
    status.textContent = "Đang tải danh mục…";
    loading = (async () => {
      try { const response = await fetch("/api/search.json"); if (!response.ok) throw new Error(); entries = await response.json(); render(); }
      catch { status.textContent = "Chưa tải được danh mục. Đóng và mở lại tìm kiếm để thử lại."; }
      finally { loading = null; }
    })();
    return loading;
  };
  open.addEventListener("click", () => { dialog.showModal(); input.focus(); void load(); });
  dialog.querySelector("[data-search-close]")!.addEventListener("click", () => dialog.close());
  input.addEventListener("input", render);
  dialog.addEventListener("keydown", event => { if (event.key === "Escape") { event.preventDefault(); event.stopPropagation(); dialog.close(); } });
  dialog.addEventListener("click", event => { if (event.target !== dialog) return; const box = dialog.getBoundingClientRect(); if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close(); });
</script>
<style>
  .site-search { width: min(42rem, calc(100% - 2rem)); max-height: 85dvh; overflow-y: auto; color: #102a43; }
  .site-search::backdrop { background: rgb(7 19 33 / .7); }
  .search-open:hover { background: #f1e6d3; }
  .site-search :global(.search-result:hover), .site-search :global(.search-result:focus-visible) { background: #f5f1eb; color: #193b5b; }
</style>
