---
interface Props { image: string; imageAlt: string }
const { image, imageAlt } = Astro.props;
---
<section class="static-hero"><img class="static-hero-photo" src={image} alt={imageAlt} width="1672" height="941" fetchpriority="high" /><div class="static-hero-copy"><slot /></div></section>
<style>
  .static-hero { position: relative; isolation: isolate; overflow: hidden; margin: 16px 12px 0; padding-bottom: 24px; border-radius: 20px; background: var(--ivory); color: var(--navy); }
  .static-hero-photo { width: 100%; height: clamp(220px,65vw,380px); object-fit: cover; object-position: 65% center; }
  .static-hero-copy { position: relative; width: calc(100% - 24px); margin: -24px auto 0; padding: 28px 20px; border: 1px solid rgb(255 255 255 / .35); border-radius: 16px; background: rgb(255 255 255 / .38); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); text-align: center; }
  .static-hero-copy :global(h1) { margin: 1rem auto; font-size: clamp(1.8rem,3.2vw,3.25rem); line-height: 1.15; font-weight: 500; text-wrap: balance; }
  .static-hero-copy :global(h1)::after { content: ""; display: block; height: 1px; background: var(--gold); margin: 1.25rem 0; }
  .static-hero-copy :global(p) { max-width: 36rem; margin-inline: auto; color: var(--navy); font-size: .875rem; }
  .static-hero-copy :global(.eyebrow) { font-size: .625rem; letter-spacing: .12em; }
  .static-hero-copy :global(nav[aria-label="Đường dẫn trang"]) { font-size: .6875rem; margin-bottom: 1.25rem; }
  .static-hero-copy :global(nav[aria-label="Đường dẫn trang"] ol) { justify-content: center; }
  .static-hero-copy :global(.hero-actions) { display: grid; gap: 10px; margin-top: 1.5rem; }
  .static-hero-copy :global(.hero-actions a) { border-radius: 999px; min-height: 48px; font-size: .8125rem; }
  @media(min-width:640px) { .static-hero { margin: 24px 24px 0; }.static-hero-copy { padding: 36px; }.static-hero-copy :global(.hero-actions) { grid-template-columns: 1fr 1fr; } }
  @media(min-width:1024px) { .static-hero { display: flex; align-items: center; min-height: 590px; padding: 48px 48px 90px; margin: 24px 28px 0; }.static-hero-photo { position: absolute; inset: 0; width: 100%; height: 100%; }.static-hero-copy { width: 49%; max-width: 660px; margin: 0; padding: 40px 32px; }.static-hero-copy :global(h1) { font-size: clamp(2rem,3vw,3rem); } }
  @media(min-width:1600px) { .static-hero { min-height: 680px; padding-inline: 64px; }.static-hero-copy { padding: 48px; } }
</style>
