---
import Breadcrumbs from "./Breadcrumbs.astro";
import { heroBackdrop } from "../data/heroBackdrops";
import { referencesForService } from "../data/serviceReferences";
import type { Service } from "../data/services";
interface Props { service: Service }
const { service } = Astro.props;
const images = [...new Map([{image:heroBackdrop(`/dich-vu/${service.slug}/`),title:`Phối cảnh tham khảo cho ${service.name.toLowerCase()}`},...(service.slug === "dan-film-noi-that" ? [referencesForService("dan-film-ban")[0],referencesForService("dan-film-thang-may")[0]] : referencesForService(service.slug))].map(item=>[item.image,item])).values()].slice(0,4);
---
<section class="service-split-hero"><div class="service-split-wrap"><Breadcrumbs items={service.slug === "dan-film-noi-that" ? [{label:"Dịch vụ"}] : [{label:"Dịch vụ",href:"/dich-vu/dan-film-noi-that/"},{label:service.name}]} /><div class="service-split-grid"><div class="service-split-copy"><slot /></div><div class="service-hero-slider" data-service-slider role="region" aria-roledescription="trình chiếu" aria-label={`Ảnh tham khảo ${service.name.toLowerCase()}`}><div class="service-hero-track" data-slide-track>{images.map((image,index)=><figure class="service-hero-slide" role="group" aria-roledescription="slide" aria-label={`${index+1} / ${images.length}`}><img src={image.image} alt={image.title} width="1200" height="1000" loading={index===0?"eager":"lazy"} fetchpriority={index===0?"high":"auto"} /><figcaption>{image.title} · Ảnh tham khảo</figcaption></figure>)}</div>{images.length>1&&<div class="service-hero-controls"><button type="button" data-slide-prev aria-label="Ảnh trước">←</button><span data-slide-count aria-live="polite" aria-atomic="true">01 / {String(images.length).padStart(2,"0")}</span><button type="button" data-slide-next aria-label="Ảnh tiếp theo">→</button></div>}</div></div></div></section>
<script>
 document.querySelectorAll<HTMLElement>('[data-service-slider]').forEach(slider=>{const track=slider.querySelector<HTMLElement>('[data-slide-track]')!;const slides=Array.from(track.children) as HTMLElement[];let current=0;const go=(step:number)=>{const next=(current+step+slides.length)%slides.length;track.scrollTo({left:slides[next].offsetLeft-track.offsetLeft,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});};slider.querySelector('[data-slide-prev]')?.addEventListener('click',()=>go(-1));slider.querySelector('[data-slide-next]')?.addEventListener('click',()=>go(1));track.addEventListener('scroll',()=>{current=Math.round(track.scrollLeft/track.clientWidth);const count=slider.querySelector('[data-slide-count]');if(count)count.textContent=`${String(current+1).padStart(2,'0')} / ${String(slides.length).padStart(2,'0')}`;},{passive:true});});
</script>
<style>
.service-split-hero{padding:24px 20px 40px;background:#f6f7f8;color:var(--navy)}
.service-split-wrap{max-width:1280px;margin:auto}.service-split-grid{display:grid;gap:28px;margin-top:24px;align-items:center}.service-split-copy{min-width:0}.service-split-copy :global(h1){font-weight:500;line-height:1.18}.service-split-copy :global(.hero-title-accent){color:var(--navy)}
.service-hero-slider{min-width:0;position:relative}.service-hero-track{position:relative;display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;border-radius:20px}.service-hero-track::-webkit-scrollbar{display:none}.service-hero-slide{flex:0 0 100%;min-width:0;scroll-snap-align:start;position:relative;margin:0}.service-hero-slide img{width:100%;aspect-ratio:5/4;object-fit:cover}.service-hero-slide figcaption{position:absolute;bottom:0;left:0;right:0;padding:12px 16px;background:rgba(11,27,51,.88);color:white;font-size:.6875rem;line-height:1.6}.service-hero-controls{display:flex;align-items:center;justify-content:flex-end;gap:18px;margin-top:12px}.service-hero-controls button{display:grid;place-items:center;width:44px;height:44px;border:0;border-radius:50%;background:white;color:var(--navy);font-size:1.375rem}.service-hero-controls button:hover{background:var(--navy);color:white}.service-hero-controls button:focus-visible{outline:2px solid var(--navy);outline-offset:3px}.service-hero-controls span{font-size:.75rem;font-variant-numeric:tabular-nums}
@media(min-width:768px){.service-split-hero{padding:32px 24px 48px}}
@media(min-width:1024px){.service-split-grid{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:56px}.service-split-hero{padding-block:40px 56px}}
</style>
