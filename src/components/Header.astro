---
import Icon from "./Icon.astro";
import { categoryIcon } from "../data/icons";
import { site, navigation, isCurrentPage, isCurrentSection } from "../data/site";
interface Props { brandName?: string }
const { brandName = site.name } = Astro.props;
const pathname = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-50 border-b border-base-200">
  <div class="header-shell mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label={`${brandName} — Trang chủ`}>
      <img src="/logo.svg" alt="" width="44" height="44" class="w-11 h-11 shrink-0" />
      <span>
        <span class="block font-heading text-base font-semibold text-base-900 leading-snug">{brandName}</span>
        <span class="block text-xs text-base-500 mt-1">Vật liệu & thi công</span>
      </span>
    </a>

    <nav class="desktop-navigation hidden xl:flex items-center text-sm font-medium" aria-label="Điều hướng chính">
      {navigation.map((item, index) => item.children ? (
        <div data-nav-group class="nav-dropdown relative">
          <div class:list={["nav-trigger-group flex items-center", { "is-current": isCurrentSection(pathname, item) }]}>
            <a href={item.href} aria-current={isCurrentPage(pathname, item.href) ? "page" : undefined} class="nav-top-link px-2 py-3 rounded-lg hover:text-primary-600">{item.label}</a>
            <button type="button" data-nav-toggle data-label={item.label} aria-label={`Mở danh mục ${item.label}`} aria-expanded="false" aria-controls={`desktop-submenu-${index}`} class="submenu-toggle flex items-center justify-center w-11 h-11 rounded-lg hover:bg-primary-50 hover:text-primary-600">
              <svg class="nav-chevron w-4 h-4 transition-transform" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 8 5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <ul id={`desktop-submenu-${index}`} hidden class="submenu-panel absolute left-0 top-full mt-2 w-72 max-h-[calc(100dvh-7rem)] overflow-y-auto bg-white border border-base-200 rounded-2xl shadow-lg p-2">
            {item.children.map(child => <li><a href={child.href} aria-current={isCurrentPage(pathname, child.href) ? "page" : undefined} class="nav-child-link flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-primary-50 hover:text-primary-600">{categoryIcon(child.href) && <Icon name={categoryIcon(child.href)!} size={20} class="text-primary-600" />}<span>{child.label}</span></a></li>)}
          </ul>
        </div>
      ) : <a href={item.href} aria-current={isCurrentPage(pathname, item.href) ? "page" : undefined} class="nav-top-link rounded-lg px-2 py-3 hover:text-primary-600">{item.label}</a>)}
      <a href="/lien-he/" class="button-primary shrink-0">Nhận tư vấn</a>
    </nav>

    <div class="flex xl:hidden items-center gap-2 shrink-0">
    <button type="button" id="menuBtn" class="xl:hidden min-w-11 min-h-11 rounded-xl border border-base-200 text-xl text-base-900" aria-label="Mở menu" aria-controls="mobileMenu" aria-expanded="false">☰</button></div>
  </div>

  <nav id="mobileMenu" class="hidden xl:hidden border-t border-base-200 bg-white max-h-[calc(100dvh-6rem)] overflow-y-auto overscroll-contain" aria-label="Điều hướng trên điện thoại">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 space-y-2">
      {navigation.map((item, index) => item.children ? (
        <div data-nav-group class="mobile-nav-group border-b border-base-200 pb-2">
          <div class:list={["nav-trigger-group flex items-center justify-between gap-3", { "is-current": isCurrentSection(pathname, item) }]}>
            <a href={item.href} aria-current={isCurrentPage(pathname, item.href) ? "page" : undefined} class="nav-top-link flex-1 py-3 font-medium rounded-lg">{item.label}</a>
            <button type="button" data-nav-toggle data-label={item.label} aria-label={`${isCurrentSection(pathname, item) ? "Đóng" : "Mở"} danh mục ${item.label}`} aria-expanded={isCurrentSection(pathname, item) ? "true" : "false"} aria-controls={`mobile-submenu-${index}`} class="submenu-toggle flex items-center justify-center w-11 h-11 rounded-lg hover:bg-primary-50">
              <svg class="nav-chevron w-4 h-4 transition-transform" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 8 5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <ul id={`mobile-submenu-${index}`} hidden={!isCurrentSection(pathname, item)} class="submenu-panel pl-3 pb-2 space-y-1 text-sm text-base-600">
            {item.children.map(child => <li><a href={child.href} aria-current={isCurrentPage(pathname, child.href) ? "page" : undefined} class="nav-child-link flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-primary-50 hover:text-primary-600">{categoryIcon(child.href) && <Icon name={categoryIcon(child.href)!} size={20} class="text-primary-600" />}<span>{child.label}</span></a></li>)}
          </ul>
        </div>
      ) : <a href={item.href} aria-current={isCurrentPage(pathname, item.href) ? "page" : undefined} class="nav-top-link block py-3 border-b border-base-200 font-medium">{item.label}</a>)}
      <a href="/lien-he/" class="button-primary w-full mt-4">Nhận tư vấn</a>
      <a href={site.phoneHref} class="block text-center text-sm font-medium py-3 text-base-600">Gọi tư vấn: {site.phone}</a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const button = document.getElementById("menuBtn");
  const menu = document.getElementById("mobileMenu");
  const toggles = [...document.querySelectorAll<HTMLButtonElement>("[data-nav-toggle]")];
  const setSubmenu = (toggle: HTMLButtonElement, open: boolean) => {
    const panel = document.getElementById(toggle.getAttribute("aria-controls") || "");
    if (panel) panel.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", `${open ? "Đóng" : "Mở"} danh mục ${toggle.dataset.label}`);
  };
  const closeDropdowns = () => toggles.forEach(toggle => setSubmenu(toggle, false));
  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    button?.setAttribute("aria-expanded", String(open));
    button?.setAttribute("aria-label", open ? "Đóng menu" : "Mở menu");
    if (button) button.textContent = open ? "✕" : "☰";
  };
  button?.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
  toggles.forEach(toggle => toggle.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggles.forEach(other => { if (other !== toggle) setSubmenu(other, false); });
    setSubmenu(toggle, open);
  }));
  document.querySelectorAll<HTMLElement>(".nav-dropdown").forEach(group => group.addEventListener("focusout", event => {
    if (!group.contains(event.relatedTarget as Node | null)) {
      const toggle = group.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      if (toggle) setSubmenu(toggle, false);
    }
  }));
  document.addEventListener("keydown", event => {
    if (event.key !== "Escape") return;
    const openToggle = toggles.find(toggle => toggle.getAttribute("aria-expanded") === "true" && toggle.getClientRects().length > 0);
    if (openToggle) { setSubmenu(openToggle, false); openToggle.focus(); }
    else if (button?.getAttribute("aria-expanded") === "true") { setOpen(false); button.focus(); }
  });
  document.addEventListener("click", event => {
    if (!header?.contains(event.target as Node)) { closeDropdowns(); setOpen(false); }
  });
  header?.addEventListener("focusout", event => {
    if (!header.contains(event.relatedTarget as Node | null)) { closeDropdowns(); setOpen(false); }
  });
  menu?.querySelectorAll("a").forEach(link => link.addEventListener("click", () => setOpen(false)));
  window.matchMedia("(min-width: 1280px)").addEventListener("change", () => { setOpen(false); closeDropdowns(); });
</script>

<style>
  .site-header { background: var(--surface); color: var(--navy); border-color: rgb(var(--pearl-rgb) / .5); color-scheme: light; }
  .site-header nav a { text-transform: uppercase; letter-spacing: .025em; }
  .site-header .button-primary { background: var(--gold); color: var(--navy); border-color: var(--gold); border-radius: 999px; padding-inline: 1.75rem; }
  .site-header .button-primary:hover { background: var(--ivory); color: var(--navy); border-color: var(--gold); }
  .site-header :focus-visible { outline-color: var(--navy); }
  #menuBtn { border-color: var(--pearl); background: var(--ivory); color: var(--navy); }
  .header-shell { width: min(1280px,calc(100% - 32px)); max-width: none; padding-inline: 0; gap: 1.25rem; }
  :global(body:has(.home-dom)) .header-shell { width: min(1240px,calc(100% - 40px)); }
  .desktop-navigation { gap: .5rem; }
  .desktop-navigation > .button-primary { margin-left: .75rem; }
  .nav-child-link { gap: 1rem; padding-block: 1rem; }
  .submenu-panel > li + li { border-top: 1px solid rgb(var(--pearl-rgb) / .4); margin-top: .375rem; padding-top: .375rem; }
  .nav-dropdown > .submenu-panel { width: 21rem; padding: .75rem; margin-top: .75rem; border-color: rgb(var(--pearl-rgb) / .6); border-radius: .875rem; box-shadow: 0 12px 30px rgb(var(--navy-rgb) / .08); }
  #mobileMenu > div { padding-block: 1.25rem; }
  #mobileMenu .nav-top-link { padding-block: 1rem; }
  #mobileMenu .button-primary { margin-top: 1.5rem; }
  @media(min-width: 640px) { .header-shell { width: min(1280px,calc(100% - 48px)); } :global(body:has(.home-dom)) .header-shell { width: min(1240px,calc(100% - 64px)); } }
  @media(min-width: 1440px) { .desktop-navigation { gap: .875rem; } .desktop-navigation > .button-primary { margin-left: 1.25rem; } }
  @media(max-width: 1279px) { .header-shell { gap: 1rem; } }
  .submenu-panel[hidden] { display: none; }
  .submenu-toggle[aria-expanded="true"] .nav-chevron { transform: rotate(180deg); }
  .submenu-toggle[aria-expanded="true"] { color: var(--navy); background: transparent; }
  .nav-top-link { position: relative; }
  .nav-top-link::after { content: ""; position: absolute; height: 2px; left: .5rem; right: .5rem; bottom: .25rem; background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform 160ms; }
  .nav-top-link:hover::after, .nav-top-link:focus-visible::after, .nav-top-link[aria-current="page"]::after,
  .nav-trigger-group.is-current .nav-top-link::after, .nav-trigger-group:has(.submenu-toggle[aria-expanded="true"]) .nav-top-link::after { transform: scaleX(1); }
  .nav-child-link > span { padding-bottom: .125rem; background-image: linear-gradient(var(--gold),var(--gold)); background-repeat: no-repeat; background-position: left bottom; background-size: 0 2px; transition: background-size 160ms; }
  .nav-child-link:hover > span, .nav-child-link:focus-visible > span, .nav-child-link[aria-current="page"] > span { background-size: 100% 2px; }
  .nav-child-link[aria-current="page"] { color: var(--navy); background: transparent; font-weight: 600; }
</style>
