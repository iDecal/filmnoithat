---
const nav = [
  {
    label: "Dịch vụ",
    href: "/dich-vu/dan-film-noi-that",
    children: [
      { label: "Tổng quan dịch vụ", href: "/dich-vu/dan-film-noi-that" },
      { label: "Dán film bàn & kệ", href: "/dich-vu/dan-film-ban" },
      { label: "Dán film tủ bếp", href: "/dich-vu/dan-film-tu-bep" },
      { label: "Dán film tường & trần", href: "/dich-vu/dan-film-tran" },
      { label: "Dán film thang máy", href: "/dich-vu/dan-film-thang-may" }
    ]
  },
  {
    label: "Vật liệu",
    href: "/vat-lieu",
    children: [
      { label: "Tất cả vật liệu", href: "/vat-lieu" },
      { label: "Film vân gỗ", href: "/vat-lieu/van-go" },
      { label: "Film vân vải", href: "/vat-lieu/van-vai" },
      { label: "Film kim loại", href: "/vat-lieu/kim-loai" },
      { label: "Film giả đá", href: "/vat-lieu/da-cam-thach" }
    ]
  },
  {
    label: "Công trình",
    href: "/cong-trinh",
    children: [
      { label: "Tất cả công trình", href: "/cong-trinh" },
      { label: "Văn phòng", href: "/cong-trinh/van-phong" },
      { label: "Nhà phố", href: "/cong-trinh/nha-pho" },
      { label: "Showroom", href: "/cong-trinh/showroom" }
    ]
  },
  {
    label: "Blog",
    href: "/blog",
    children: [
      { label: "Tất cả bài viết", href: "/blog" },
      { label: "Cách chọn film nội thất", href: "/blog/cach-chon-film-noi-that" },
      { label: "Báo giá thi công", href: "/blog/bao-gia-dan-film" },
      { label: "So sánh vật liệu", href: "/blog/so-sanh-film-noi-that" }
    ]
  },
  { label: "Giới thiệu", href: "/gioi-thieu" },
  { label: "Liên hệ", href: "/lien-he" }
];
---

<header class="site-header sticky top-0 z-50 border-b border-base-200 bg-white/95 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label="Film Nội Thất — Trang chủ">
      <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-primary-500 text-white" aria-hidden="true">
        <svg width="27" height="27" viewBox="0 0 28 28" fill="none"><path d="M5 22V6h18M5 14h13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="m15 22 8-8v8h-8Z" fill="currentColor" opacity=".55"/></svg>
      </span>
      <span>
        <span class="block text-base font-semibold text-base-900 leading-snug">Film Nội Thất</span>
        <span class="block text-xs text-base-500 mt-1">Vật liệu & thi công</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-6 text-sm font-medium" aria-label="Điều hướng chính">
      {nav.map(item => (
        <div class="relative group">
          <a href={item.href} class="flex items-center gap-1 py-3 hover:text-primary-500 transition-colors">
            {item.label}
            {item.children && <span aria-hidden="true" class="text-base-400">⌄</span>}
          </a>
          {item.children && (
            <div class="absolute left-0 top-full w-64 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-150">
              <div class="bg-white border border-base-200 rounded-2xl shadow-lg p-2">
                {item.children.map(child => <a href={child.href} class="block px-4 py-3 rounded-lg hover:bg-primary-50 hover:text-primary-600">{child.label}</a>)}
              </div>
            </div>
          )}
        </div>
      ))}
      <a href="/lien-he" class="button-primary">Nhận tư vấn</a>
    </nav>

    <button id="menuBtn" class="lg:hidden min-w-11 min-h-11 rounded-xl border border-base-200 text-xl text-base-900" aria-label="Mở menu" aria-controls="mobileMenu" aria-expanded="false">☰</button>
  </div>

  <nav id="mobileMenu" class="hidden lg:hidden border-t border-base-200 bg-white max-h-[75vh] overflow-y-auto" aria-label="Điều hướng trên điện thoại">
    <div class="max-w-7xl mx-auto px-6 py-4 space-y-2">
      {nav.map(item => item.children ? (
        <details class="border-b border-base-200 pb-2">
          <summary class="py-3 cursor-pointer font-medium">{item.label}</summary>
          <div class="pl-4 pb-2 space-y-1 text-sm text-base-600">
            {item.children.map(child => <a href={child.href} class="block py-3 hover:text-primary-500">{child.label}</a>)}
          </div>
        </details>
      ) : <a href={item.href} class="block py-3 border-b border-base-200 font-medium">{item.label}</a>)}
      <a href="/lien-he" class="button-primary w-full mt-4">Nhận tư vấn</a>
    </div>
  </nav>
</header>

<script>
  const button = document.getElementById("menuBtn");
  const menu = document.getElementById("mobileMenu");
  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    button?.setAttribute("aria-expanded", String(open));
    button?.setAttribute("aria-label", open ? "Đóng menu" : "Mở menu");
    if (button) button.textContent = open ? "✕" : "☰";
  };
  button?.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
  document.addEventListener("keydown", event => {
    if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      button.focus();
    }
  });
  menu?.querySelectorAll("a").forEach(link => link.addEventListener("click", () => setOpen(false)));
  window.matchMedia("(min-width: 1024px)").addEventListener("change", event => {
    if (event.matches) setOpen(false);
  });
</script>
