---
interface Props { trackClass?: string }
const { trackClass = "" } = Astro.props;
---
<div class="post-carousel" data-post-carousel><div class:list={["post-carousel-track",trackClass]} data-post-track tabindex="0" role="region" aria-label="Bài viết tư vấn, cuộn ngang để xem thêm"><slot /></div><div class="post-carousel-controls" data-post-controls hidden><button type="button" data-post-prev aria-label="Bài viết trước">←</button><button type="button" data-post-next aria-label="Bài viết tiếp theo">→</button></div></div>
<script>
 document.querySelectorAll<HTMLElement>('[data-post-carousel]').forEach(root=>{const track=root.querySelector<HTMLElement>('[data-post-track]')!;const controls=root.querySelector<HTMLElement>('[data-post-controls]')!;const prev=root.querySelector<HTMLButtonElement>('[data-post-prev]')!;const next=root.querySelector<HTMLButtonElement>('[data-post-next]')!;const update=()=>{controls.hidden=track.scrollWidth<=track.clientWidth+2;prev.disabled=track.scrollLeft<=2;next.disabled=track.scrollLeft+track.clientWidth>=track.scrollWidth-2;};const move=(direction:number)=>{const first=track.firstElementChild as HTMLElement;const step=first?first.getBoundingClientRect().width+parseFloat(getComputedStyle(track).columnGap||'0'):track.clientWidth;track.scrollBy({left:direction*step,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});};prev.addEventListener('click',()=>move(-1));next.addEventListener('click',()=>move(1));track.addEventListener('scroll',update,{passive:true});track.addEventListener('keydown',event=>{if(event.target===track&&['ArrowLeft','ArrowRight'].includes(event.key)){event.preventDefault();move(event.key==='ArrowRight'?1:-1);}});new ResizeObserver(update).observe(track);update();});
</script>
<style>
.post-carousel{min-width:0}.post-carousel .post-carousel-track{display:flex;flex-wrap:nowrap;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:var(--pearl) transparent;padding-bottom:12px;min-width:0;overscroll-behavior-inline:contain}.post-carousel-track :global(> article){flex:0 0 86%;min-width:0;scroll-snap-align:start}.post-carousel-controls{display:flex;justify-content:flex-end;gap:10px;margin-top:12px}.post-carousel-controls[hidden]{display:none}.post-carousel-controls button{width:44px;height:44px;display:grid;place-items:center;border:1px solid var(--navy);border-radius:50%;color:var(--navy);background:transparent;font-size:1.25rem}.post-carousel-controls button:hover:not(:disabled){background:var(--navy);color:white}.post-carousel-controls button:disabled{opacity:.3;cursor:default}@media(min-width:640px){.post-carousel-track :global(> article){flex-basis:calc((100% - 24px)/2)}}@media(min-width:1024px){.post-carousel-track :global(> article){flex-basis:calc((100% - 48px)/3)}}
.post-carousel-track :global(.post-carousel-image){width:100%;aspect-ratio:16/10;overflow:hidden;border-radius:16px;flex-shrink:0;margin-bottom:1.25rem}.post-carousel-track :global(.post-carousel-image img){display:block;width:100%;height:100%;max-width:none;object-fit:cover;object-position:center;margin:0;aspect-ratio:auto}
</style>
