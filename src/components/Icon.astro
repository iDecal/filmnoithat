---
import { iconPaths, type IconName } from "../data/icons";
interface Props { name: IconName; size?: number; class?: string }
const { name, size = 24, class: className } = Astro.props;
---
<svg data-icon={name} xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class:list={["shrink-0", className]}><path d={iconPaths[name]} /></svg>
