---
import ProductCard from "./ProductCard.astro";
import { samplesForMaterial } from "../data/catalogue";
interface Props { category: string; refined?: boolean }
const { refined = false } = Astro.props;
const samples = samplesForMaterial(Astro.props.category);
const colors = [...new Set(samples.map(sample => sample.color.family))].sort((a,b) => a.localeCompare(b,"vi"));
const brands = [...new Set(samples.map(sample => sample.brand))];
const groups = [...new Set(samples.map(sample => sample.group))];
---
{samples.length > 0 && <section id="mau-vat-lieu" class:list={["px-4 sm:px-6 section-space warm-surface", {"catalogue-refined": refined}]} aria-labelledby="catalogue-title" data-catalogue>
  <div class="max-w-7xl mx-auto">
    <div class="catalogue-heading">
      <div><div class="catalogue-kicker">{refined && <svg class="catalogue-heading-icon" width="23" height="23" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/></svg>}<p class="eyebrow">BỘ SƯU TẬP VẬT LIỆU</p><span class="catalogue-count">{samples.length} mẫu</span></div><h2 id="catalogue-title" class="text-2xl md:text-[1.875rem] font-semibold mt-2">Tìm bề mặt bạn yêu thích.</h2></div>
      <nav class="catalogue-downloads" aria-label="Tải catalogue vật liệu"><span class="catalogue-download-label">Catalogue</span>{brands.map(brand => <a href={samples.find(sample => sample.brand === brand)!.pdf} class="catalogue-download">{brand}<svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></a>)}</nav>
    </div>
    <div class="catalogue-filter-panel">
      <div class="catalogue-controls hidden" data-catalogue-controls>
        <label class="catalogue-field catalogue-search-field"><span>Tìm mẫu</span><div class="catalogue-search-box"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><input type="search" data-catalogue-search placeholder="Tên, màu hoặc mã mẫu…" /></div></label>
        <button type="button" class="catalogue-filter-toggle" data-catalogue-filter-toggle aria-expanded="false" aria-controls="catalogue-extra-filters"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 17h16M9 4v6M15 14v6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg><span data-catalogue-filter-label>Bộ lọc</span></button>
        <div id="catalogue-extra-filters" class="catalogue-extra-filters" data-catalogue-extra-filters>
        <label class="catalogue-field"><span>Thương hiệu</span><select data-catalogue-brand><option value="">Tất cả</option>{brands.map(brand => <option value={brand}>{brand}</option>)}</select></label>
        <label class="catalogue-field"><span>Dòng vật liệu</span><select data-catalogue-group><option value="">Tất cả dòng</option>{groups.map(group => <option value={group}>{group}</option>)}</select></label>
        <label class="catalogue-field"><span>Tông màu</span><select data-catalogue-color><option value="">Mọi tông màu</option>{colors.map(color => <option value={color}>{color}</option>)}</select></label>
        <button type="button" data-catalogue-reset class="catalogue-reset"><span aria-hidden="true">↺</span> Đặt lại</button>
        </div>
      </div>
      <div class="catalogue-filter-meta">
        <p data-catalogue-status role="status" aria-live="polite" aria-atomic="true">{samples.length} mẫu</p>
        <details class="catalogue-notes"><summary>Lưu ý chọn mẫu <span aria-hidden="true">+</span></summary><p>Tông màu hỗ trợ tìm kiếm, cần so với mẫu thật. Giá INFEEL tính theo mét dài, chưa gồm công thi công; Corance và TODA liên hệ báo giá. Tình trạng cung cấp được xác nhận khi đặt. Quy cách cuộn được ghi riêng trên từng mẫu.</p></details>
      </div>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 sm:gap-x-6 gap-y-7" data-catalogue-grid>{samples.map(sample => <article data-catalogue-card data-slug={sample.slug} data-code={sample.code} data-search={`${sample.brand} ${sample.title} ${sample.code} ${sample.group} ${sample.color.family}`} data-brand={sample.brand} data-group={sample.group} data-color={sample.color.family} class="min-w-0"><ProductCard sample={sample} /><button type="button" hidden data-admin-only data-quick-delete class="button-secondary mt-2 w-full" aria-label={`Xóa sản phẩm ${sample.brand} ${sample.code}`}>Xóa sản phẩm</button></article>)}</div>
    <p data-quick-delete-status role="status" aria-live="polite" class="text-sm text-base-700 mt-5"></p>
    <dialog data-quick-delete-dialog class="rounded-2xl bg-white p-5 sm:p-7 w-[min(30rem,calc(100%-2rem))]" aria-labelledby="quick-delete-title" aria-describedby="quick-delete-description">
      <h2 id="quick-delete-title" class="text-xl font-semibold">Xóa sản phẩm?</h2>
      <p data-quick-delete-name class="font-semibold mt-3"></p>
      <p id="quick-delete-description" class="mt-3">Sản phẩm sẽ bị gỡ khỏi website sau khi triển khai xong. Các tệp ảnh được giữ lại.</p>
      <p data-quick-delete-error role="alert" class="text-sm mt-3"></p>
      <div class="flex flex-wrap gap-3 mt-5"><button type="button" data-quick-delete-confirm class="button-primary">Xác nhận xóa</button><button type="button" data-quick-delete-cancel class="button-secondary" autofocus>Hủy</button></div>
    </dialog>
    <div class="text-center mt-8"><button type="button" data-catalogue-more class="button-secondary hidden">Xem thêm mẫu</button></div>
    <p data-catalogue-empty class="text-base-600 py-8 hidden">Chưa tìm thấy mẫu phù hợp. Thử tên khác hoặc xóa bộ lọc để xem lại bộ sưu tập.</p>
  </div>
</section>}
<script>
  import { loginAdmin, logoutAdmin } from "../lib/admin-session";
  document.querySelectorAll<HTMLElement>("[data-catalogue]").forEach(root => {
    const search = root.querySelector<HTMLInputElement>("[data-catalogue-search]")!;
    const group = root.querySelector<HTMLSelectElement>("[data-catalogue-group]")!;
    const brand = root.querySelector<HTMLSelectElement>("[data-catalogue-brand]")!;
    const requestedBrand = new URLSearchParams(location.search).get("brand");
    if ([...brand.options].some(option => option.value === requestedBrand)) brand.value = requestedBrand!;
    const color = root.querySelector<HTMLSelectElement>("[data-catalogue-color]")!;
    const cards = [...root.querySelectorAll<HTMLElement>("[data-catalogue-card]")];
    const more = root.querySelector<HTMLButtonElement>("[data-catalogue-more]")!;
    const status = root.querySelector<HTMLElement>("[data-catalogue-status]")!;
    const empty = root.querySelector<HTMLElement>("[data-catalogue-empty]")!;
    const normalize = (text: string) => text.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d").replace(/[^a-z0-9]/g, "");
    const filterToggle = root.querySelector<HTMLButtonElement>("[data-catalogue-filter-toggle]")!;
    const extraFilters = root.querySelector<HTMLElement>("[data-catalogue-extra-filters]")!;
    filterToggle.addEventListener("click", () => {
      const expanded = filterToggle.getAttribute("aria-expanded") !== "true";
      filterToggle.setAttribute("aria-expanded", String(expanded));
      extraFilters.classList.toggle("is-open", expanded);
    });
    const deleted = new Set<HTMLElement>();
    let limit = 24;
    const update = () => {
      const activeFilters = [brand.value, group.value, color.value].filter(Boolean).length;
      root.querySelector<HTMLElement>("[data-catalogue-filter-label]")!.textContent = activeFilters ? `Bộ lọc (${activeFilters})` : "Bộ lọc";
      const query = normalize(search.value);
      const isColorQuery = !!query && cards.some(card => normalize(card.dataset.color || "") === query);
      const matching = cards.filter(card => !deleted.has(card) && (isColorQuery ? normalize(card.dataset.color || "") === query : normalize(card.dataset.search || "").includes(query)) && (!brand.value || card.dataset.brand === brand.value) && (!group.value || card.dataset.group === group.value) && (!color.value || card.dataset.color === color.value));
      const visible = new Set(matching.slice(0, limit));
      cards.forEach(card => { card.hidden = !visible.has(card); });
      more.hidden = matching.length <= limit;
      empty.hidden = matching.length > 0;
      status.textContent = `Hiển thị ${Math.min(limit, matching.length)} / ${matching.length} mẫu`;
    };
    root.querySelector<HTMLElement>("[data-catalogue-controls]")!.classList.replace("hidden", "grid");
    more.classList.remove("hidden");
    empty.classList.remove("hidden");
    search.addEventListener("input", () => { limit = 24; update(); });
    color.addEventListener("change", () => { limit = 24; update(); });
    brand.addEventListener("change", () => { limit = 24; group.value = ""; update(); });
    group.addEventListener("change", () => { limit = 24; update(); });
    root.querySelector("[data-catalogue-reset]")!.addEventListener("click", () => { search.value = ""; brand.value = ""; group.value = ""; color.value = ""; limit = 24; update(); search.focus(); });
    more.addEventListener("click", () => {
      const before = cards.filter(card => !card.hidden).length;
      limit += 24; update();
      cards.filter(card => !card.hidden)[before]?.querySelector("a")?.focus({ preventScroll: true });
    });
    const dialog = root.querySelector<HTMLDialogElement>("[data-quick-delete-dialog]")!;
    const confirm = root.querySelector<HTMLButtonElement>("[data-quick-delete-confirm]")!;
    const cancel = root.querySelector<HTMLButtonElement>("[data-quick-delete-cancel]")!;
    const message = root.querySelector<HTMLElement>("[data-quick-delete-status]")!;
    const error = root.querySelector<HTMLElement>("[data-quick-delete-error]")!;
    let target: HTMLElement | null = null;
    let busy = false;
    root.addEventListener("click", event => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-quick-delete]");
      if (!button || button.hidden || busy) return;
      target = button.closest<HTMLElement>("[data-catalogue-card]");
      if (!target || deleted.has(target)) return;
      root.querySelector<HTMLElement>("[data-quick-delete-name]")!.textContent = `${target.dataset.brand} ${target.dataset.code}`;
      error.textContent = "";
      dialog.showModal();
    });
    cancel.addEventListener("click", () => dialog.close());
    dialog.addEventListener("cancel", event => { if (busy) event.preventDefault(); });
    window.addEventListener("admin-logout", () => { if (!busy) dialog.close(); });
    confirm.addEventListener("click", async () => {
      if (!target || busy) return;
      const card = target;
      busy = true; confirm.disabled = true; cancel.disabled = true; error.textContent = "";
      try {
        const token = await loginAdmin();
        const response = await fetch("/api/product-images", {
          method: "DELETE",
          headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
          body: JSON.stringify({ slug: card.dataset.slug, brand: card.dataset.brand, action: "delete-product" }),
        });
        const result = await response.json();
        if (!response.ok || result.deletedProduct !== true) {
          if (response.status === 401 || response.status === 403) logoutAdmin();
          throw new Error(result.message || "Chưa xóa được sản phẩm. Hãy thử lại.");
        }
        deleted.add(card); update(); dialog.close();
        message.textContent = `Đã xóa ${card.dataset.brand} ${card.dataset.code}. Website đang cập nhật.`;
        (cards.find(item => !item.hidden)?.querySelector<HTMLAnchorElement>("a") || search).focus({ preventScroll: true });
      } catch (reason) {
        error.textContent = reason instanceof Error ? reason.message : "Chưa xóa được sản phẩm. Hãy thử lại.";
      } finally { busy = false; confirm.disabled = false; cancel.disabled = false; }
    });
    update();
  });
</script>
<style>
  [data-catalogue-card][hidden], [data-catalogue-more][hidden], [data-catalogue-empty][hidden] { display: none; }
  #mau-vat-lieu { scroll-margin-top: 6rem; }
  .catalogue-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.25rem; margin-bottom: 1.5rem; }
  .catalogue-kicker { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
  .catalogue-count { font-size: .75rem; line-height: 1.5; padding: .2rem .6rem; border-radius: 999px; background: #f1e6d3; color: #193b5b; }
  .catalogue-downloads { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; }
  .catalogue-download-label { font-size: .75rem; color: #56636c; margin-right: .25rem; }
  .catalogue-download { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.5rem; padding: .4rem .75rem; border: 1px solid #ded8cf; border-radius: 999px; color: #193b5b; font-size: .75rem; font-weight: 600; background: #fff; }
  .catalogue-download:hover { background: #f1e6d3; border-color: #d1b581; }
  .catalogue-filter-panel { border: 1px solid #ded8cf; background: #fff; border-radius: 1rem; padding: 1.25rem; margin-bottom: 1.75rem; box-shadow: 0 4px 20px rgb(16 42 67 / .03); }
  .catalogue-controls { grid-template-columns: minmax(0,1.5fr) repeat(3,minmax(0,1fr)) auto; gap: .875rem; align-items: end; }
  .catalogue-extra-filters { display: contents; }
  .catalogue-filter-toggle { display: none; }
  .catalogue-field { display: block; min-width: 0; color: #193b5b; font-size: .75rem; font-weight: 600; }
  .catalogue-field > span { display: block; margin-bottom: .375rem; }
  .catalogue-field input, .catalogue-field select { width: 100%; min-width: 0; height: 2.875rem; border: 1px solid #d7dee3; border-radius: .625rem; background: #fafbfc; color: #20313d; font-size: .875rem; font-weight: 400; padding: .625rem .75rem; }
  .catalogue-search-box { position: relative; }
  .catalogue-search-box svg { position: absolute; top: 50%; left: .75rem; transform: translateY(-50%); color: #687782; pointer-events: none; }
  .catalogue-search-box input { padding-left: 2.5rem; }
  .catalogue-reset { display: inline-flex; gap: .375rem; justify-content: center; align-items: center; height: 2.875rem; padding: .625rem .875rem; border-radius: .625rem; border: 1px solid #d1b581; background: #f1e6d3; color: #193b5b; font-size: .8125rem; font-weight: 600; white-space: nowrap; }
  .catalogue-reset:hover { background: #e4cfaa; }
  .catalogue-filter-meta { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; border-top: 1px solid #edf0f2; padding-top: .875rem; margin-top: 1rem; color: #56636c; font-size: .75rem; }
  .catalogue-filter-meta > p { flex-shrink: 0; padding-top: .25rem; }
  .catalogue-notes { max-width: 34rem; text-align: right; }
  .catalogue-notes summary { display: inline-flex; align-items: center; gap: .625rem; cursor: pointer; min-height: 1.75rem; list-style: none; color: #193b5b; }
  .catalogue-notes summary::-webkit-details-marker { display: none; }
  .catalogue-notes[open] summary span { transform: rotate(45deg); }
  .catalogue-notes p { margin-top: .5rem; line-height: 1.7; text-align: left; }
  @media(max-width: 1023px) {
    .catalogue-heading { align-items: flex-start; flex-direction: column; gap: .875rem; }
    .catalogue-controls { grid-template-columns: repeat(3,minmax(0,1fr)); }
    .catalogue-search-field { grid-column: 1 / -1; }
    .catalogue-reset { grid-column: 1 / -1; justify-self: start; }
  }
  @media(max-width: 639px) {
    #mau-vat-lieu { padding-block: 1.75rem; }
    .catalogue-heading { gap: .625rem; margin-bottom: 1rem; }
    .catalogue-downloads { gap: .375rem; }
    .catalogue-download { min-height: 2.25rem; padding: .25rem .625rem; }
    .catalogue-filter-panel { padding: .75rem; margin-bottom: 1.25rem; border-radius: .875rem; }
    .catalogue-controls { grid-template-columns: minmax(0,1fr) auto; gap: .625rem; }
    .catalogue-search-field { grid-column: auto; }
    .catalogue-search-field > span { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
    .catalogue-filter-toggle { display: inline-flex; align-items: center; justify-content: center; gap: .375rem; height: 2.875rem; padding: .5rem .625rem; border: 1px solid #d1b581; border-radius: .625rem; background: #f1e6d3; color: #193b5b; font-size: .75rem; font-weight: 600; white-space: nowrap; }
    .catalogue-filter-toggle[aria-expanded="true"] { background: #193b5b; color: #fff; border-color: #193b5b; }
    .catalogue-extra-filters { display: none; }
    .catalogue-extra-filters.is-open { display: grid; grid-column: 1 / -1; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .625rem; padding-top: .375rem; }
    .catalogue-reset { grid-column: auto; align-self: end; justify-self: stretch; }
    .catalogue-filter-meta { flex-direction: row; flex-wrap: wrap; gap: .25rem .5rem; padding-top: .5rem; margin-top: .625rem; }
    .catalogue-notes { text-align: right; flex: 1; min-width: 8rem; }
    .catalogue-field select, .catalogue-field input { font-size: 1rem; }
  }

  .catalogue-refined .catalogue-heading { margin-bottom:1.25rem; align-items:center; }
  .catalogue-refined .catalogue-heading h2 { font-size:clamp(1.5rem,2.4vw,2rem); letter-spacing:-.035em; }
  .catalogue-refined .catalogue-kicker { gap:.625rem; }
  .catalogue-heading-icon { color:#987744; }
  .catalogue-refined .eyebrow { font-size:.6875rem; letter-spacing:.12em; }
  .catalogue-refined .catalogue-count { background:#edf3f6; color:#23435b; font-weight:500; }
  .catalogue-refined .catalogue-download { border-color:#dfe5e9; border-radius:.625rem; background:white; }
  .catalogue-refined .catalogue-download:hover { border-color:#bda273; background:#faf7f1; }
  .catalogue-refined .catalogue-filter-panel { padding:1.125rem 1.25rem .75rem; border-color:#dce4e9; border-radius:1rem; background:linear-gradient(115deg,#fffdf9 0%,#f8f2e7 55%,#f0e3cc 100%); box-shadow:none; margin-bottom:1.5rem; }
  .catalogue-refined .catalogue-controls { gap:.75rem; }
  .catalogue-refined .catalogue-field > span { font-size:.6875rem; color:#536779; margin-bottom:.375rem; }
  .catalogue-refined .catalogue-field input, .catalogue-refined .catalogue-field select { background:#fff; border-color:#dce4e9; border-radius:.625rem; }
  .catalogue-refined .catalogue-field input:focus-visible, .catalogue-refined .catalogue-field select:focus-visible { outline:2px solid #a78957; outline-offset:2px; }
  .catalogue-refined .catalogue-reset { background:transparent; border-color:#c8d3db; }
  .catalogue-refined .catalogue-reset:hover { background:#fff; border-color:#a78957; }
  .catalogue-refined .catalogue-filter-meta { border-color:#dfe6ea; margin-top:.875rem; padding-top:.625rem; }
  @media(max-width:639px) {
    .catalogue-refined .catalogue-heading { gap:1rem; }
    .catalogue-refined .catalogue-filter-panel { padding:.875rem; }
    .catalogue-refined .catalogue-download-label { font-size:.6875rem; }
  }
</style>
