---
import { formatRetailPrice } from "../data/infeelPrices";
import { samplesForMaterial, sampleHref } from "../data/catalogue";
interface Props { category: string }
const samples = samplesForMaterial(Astro.props.category);
const colors = [...new Set(samples.map(sample => sample.color.family))].sort((a,b) => a.localeCompare(b,"vi"));
const brands = [...new Set(samples.map(sample => sample.brand))];
const groups = [...new Set(samples.map(sample => sample.group))];
---
{samples.length > 0 && <section id="mau-vat-lieu" class="px-4 sm:px-6 section-space warm-surface" aria-labelledby="catalogue-title" data-catalogue>
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6"><div><p class="eyebrow mb-3">BỘ SƯU TẬP VẬT LIỆU</p><h2 id="catalogue-title" class="text-2xl md:text-[1.875rem] font-semibold">Tìm bề mặt bạn yêu thích.</h2><p class="text-sm text-base-600 mt-3">{samples.length} mẫu từ catalogue. Tên tông màu hỗ trợ tìm kiếm, cần so với mẫu thật; Giá INFEEL tính theo mét dài, chưa gồm công thi công; Corance và TODA liên hệ báo giá. Tình trạng cung cấp được xác nhận khi đặt. Quy cách cuộn được ghi riêng trên từng mẫu.</p></div><div class="flex flex-wrap gap-x-5">{brands.map(brand => <a href={samples.find(sample => sample.brand === brand)!.pdf} class="inline-flex items-center min-h-11 text-sm text-primary-600 font-semibold hover:underline">Catalogue {brand} ↗</a>)}</div></div>
    <div class="catalogue-controls hidden grid-cols-1 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))_auto] gap-3 mb-5" data-catalogue-controls>
      <label class="block text-sm font-medium">Tìm tên, màu hoặc mã mẫu<input type="search" data-catalogue-search placeholder="Ví dụ: trắng, xanh, sồi, WD259…" class="block w-full min-h-12 border border-base-300 rounded-lg px-4 py-3 mt-2 bg-white text-base font-normal" /></label>
      <label class="block text-sm font-medium">Thương hiệu<select data-catalogue-brand class="block w-full min-h-12 border border-base-300 rounded-lg px-4 py-3 mt-2 bg-white text-base font-normal"><option value="">Tất cả thương hiệu</option>{brands.map(brand => <option value={brand}>{brand}</option>)}</select></label>
      <label class="block text-sm font-medium">Dòng vật liệu<select data-catalogue-group class="block w-full min-h-12 border border-base-300 rounded-lg px-4 py-3 mt-2 bg-white text-base font-normal"><option value="">Tất cả dòng vật liệu</option>{groups.map(group => <option value={group}>{group}</option>)}</select></label>
      <label class="block text-sm font-medium">Tông màu<select data-catalogue-color class="block w-full min-h-12 border border-base-300 rounded-lg px-4 py-3 mt-2 bg-white text-base font-normal"><option value="">Tất cả tông màu</option>{colors.map(color => <option value={color}>{color}</option>)}</select></label>
      <button type="button" data-catalogue-reset class="button-secondary sm:self-end">Xóa bộ lọc</button>
    </div>
    <p data-catalogue-status role="status" aria-live="polite" aria-atomic="true" class="text-sm text-base-600 mb-5">{samples.length} mẫu</p>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 sm:gap-x-6 gap-y-7" data-catalogue-grid>{samples.map(sample => <article data-catalogue-card data-slug={sample.slug} data-code={sample.code} data-search={`${sample.brand} ${sample.title} ${sample.code} ${sample.group} ${sample.color.family}`} data-brand={sample.brand} data-group={sample.group} data-color={sample.color.family} class="min-w-0"><a href={sampleHref(sample)} class="group block"><div class="bg-white rounded-xl overflow-hidden border border-base-200"><img src={sample.image} alt={sample.imageAlt || `${sample.title} — ${sample.code}`} width={sample.imageWidth} height={sample.imageHeight} loading="lazy" decoding="async" class="w-full aspect-[4/3] object-cover object-center" /></div><p class="text-xs text-base-600 mt-3">{sample.brand} · {sample.group.replace(`${sample.brand} `, "")}</p><h3 class="text-sm sm:text-base font-medium mt-1 group-hover:text-primary-600">{sample.title}</h3><p class="text-sm text-primary-600 font-semibold mt-1">{sample.code}</p><p class="text-sm sm:text-base font-semibold mt-2" data-card-price={sample.pricePerMetre}>{sample.pricePerMetre ? `${formatRetailPrice(sample.pricePerMetre)} / mét dài` : "Liên hệ báo giá"}</p><span class="inline-flex items-center min-h-11 text-xs sm:text-sm text-base-700 mt-1 group-hover:underline">Xem mẫu & tư vấn →</span></a><button type="button" hidden data-admin-only data-quick-delete class="button-secondary mt-2 w-full" aria-label={`Xóa sản phẩm ${sample.brand} ${sample.code}`}>Xóa sản phẩm</button></article>)}</div>
    <p data-quick-delete-status role="status" aria-live="polite" class="text-sm text-base-700 mt-5"></p>
    <dialog data-quick-delete-dialog class="rounded-2xl bg-white p-5 sm:p-7 w-[min(30rem,calc(100%-2rem))]" aria-labelledby="quick-delete-title" aria-describedby="quick-delete-description">
      <h2 id="quick-delete-title" class="text-xl font-semibold">Xóa sản phẩm?</h2>
      <p data-quick-delete-name class="font-semibold mt-3"></p>
      <p id="quick-delete-description" class="mt-3">Sản phẩm sẽ bị gỡ khỏi website sau khi triển khai xong. Các tệp ảnh được giữ lại.</p>
      <p data-quick-delete-error role="alert" class="text-sm mt-3"></p>
      <div class="flex flex-wrap gap-3 mt-5"><button type="button" data-quick-delete-confirm class="button-primary">Xác nhận xóa</button><button type="button" data-quick-delete-cancel class="button-secondary" autofocus>Hủy</button></div>
    </dialog>
    <div class="text-center mt-8"><button type="button" data-catalogue-more class="button-secondary hidden">Xem thêm mẫu</button></div>
    <p data-catalogue-empty class="text-base-600 py-8 hidden">Chưa tìm thấy mẫu phù hợp. Thử tên khác hoặc xóa bộ lọc để xem lại bộ sưu tập.</p>
  </div>
</section>}
<script>
  import { loginAdmin, logoutAdmin } from "../lib/admin-session";
  document.querySelectorAll<HTMLElement>("[data-catalogue]").forEach(root => {
    const search = root.querySelector<HTMLInputElement>("[data-catalogue-search]")!;
    const group = root.querySelector<HTMLSelectElement>("[data-catalogue-group]")!;
    const brand = root.querySelector<HTMLSelectElement>("[data-catalogue-brand]")!;
    const requestedBrand = new URLSearchParams(location.search).get("brand");
    if ([...brand.options].some(option => option.value === requestedBrand)) brand.value = requestedBrand!;
    const color = root.querySelector<HTMLSelectElement>("[data-catalogue-color]")!;
    const cards = [...root.querySelectorAll<HTMLElement>("[data-catalogue-card]")];
    const more = root.querySelector<HTMLButtonElement>("[data-catalogue-more]")!;
    const status = root.querySelector<HTMLElement>("[data-catalogue-status]")!;
    const empty = root.querySelector<HTMLElement>("[data-catalogue-empty]")!;
    const normalize = (text: string) => text.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d").replace(/[^a-z0-9]/g, "");
    const deleted = new Set<HTMLElement>();
    let limit = 24;
    const update = () => {
      const query = normalize(search.value);
      const isColorQuery = !!query && cards.some(card => normalize(card.dataset.color || "") === query);
      const matching = cards.filter(card => !deleted.has(card) && (isColorQuery ? normalize(card.dataset.color || "") === query : normalize(card.dataset.search || "").includes(query)) && (!brand.value || card.dataset.brand === brand.value) && (!group.value || card.dataset.group === group.value) && (!color.value || card.dataset.color === color.value));
      const visible = new Set(matching.slice(0, limit));
      cards.forEach(card => { card.hidden = !visible.has(card); });
      more.hidden = matching.length <= limit;
      empty.hidden = matching.length > 0;
      status.textContent = `Hiển thị ${Math.min(limit, matching.length)} / ${matching.length} mẫu`;
    };
    root.querySelector<HTMLElement>("[data-catalogue-controls]")!.classList.replace("hidden", "grid");
    more.classList.remove("hidden");
    empty.classList.remove("hidden");
    search.addEventListener("input", () => { limit = 24; update(); });
    color.addEventListener("change", () => { limit = 24; update(); });
    brand.addEventListener("change", () => { limit = 24; group.value = ""; update(); });
    group.addEventListener("change", () => { limit = 24; update(); });
    root.querySelector("[data-catalogue-reset]")!.addEventListener("click", () => { search.value = ""; brand.value = ""; group.value = ""; color.value = ""; limit = 24; update(); search.focus(); });
    more.addEventListener("click", () => {
      const before = cards.filter(card => !card.hidden).length;
      limit += 24; update();
      cards.filter(card => !card.hidden)[before]?.querySelector("a")?.focus({ preventScroll: true });
    });
    const dialog = root.querySelector<HTMLDialogElement>("[data-quick-delete-dialog]")!;
    const confirm = root.querySelector<HTMLButtonElement>("[data-quick-delete-confirm]")!;
    const cancel = root.querySelector<HTMLButtonElement>("[data-quick-delete-cancel]")!;
    const message = root.querySelector<HTMLElement>("[data-quick-delete-status]")!;
    const error = root.querySelector<HTMLElement>("[data-quick-delete-error]")!;
    let target: HTMLElement | null = null;
    let busy = false;
    root.addEventListener("click", event => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-quick-delete]");
      if (!button || button.hidden || busy) return;
      target = button.closest<HTMLElement>("[data-catalogue-card]");
      if (!target || deleted.has(target)) return;
      root.querySelector<HTMLElement>("[data-quick-delete-name]")!.textContent = `${target.dataset.brand} ${target.dataset.code}`;
      error.textContent = "";
      dialog.showModal();
    });
    cancel.addEventListener("click", () => dialog.close());
    dialog.addEventListener("cancel", event => { if (busy) event.preventDefault(); });
    window.addEventListener("admin-logout", () => { if (!busy) dialog.close(); });
    confirm.addEventListener("click", async () => {
      if (!target || busy) return;
      const card = target;
      busy = true; confirm.disabled = true; cancel.disabled = true; error.textContent = "";
      try {
        const token = await loginAdmin();
        const response = await fetch("/api/product-images", {
          method: "DELETE",
          headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
          body: JSON.stringify({ slug: card.dataset.slug, brand: card.dataset.brand, action: "delete-product" }),
        });
        const result = await response.json();
        if (!response.ok || result.deletedProduct !== true) {
          if (response.status === 401 || response.status === 403) logoutAdmin();
          throw new Error(result.message || "Chưa xóa được sản phẩm. Hãy thử lại.");
        }
        deleted.add(card); update(); dialog.close();
        message.textContent = `Đã xóa ${card.dataset.brand} ${card.dataset.code}. Website đang cập nhật.`;
        (cards.find(item => !item.hidden)?.querySelector<HTMLAnchorElement>("a") || search).focus({ preventScroll: true });
      } catch (reason) {
        error.textContent = reason instanceof Error ? reason.message : "Chưa xóa được sản phẩm. Hãy thử lại.";
      } finally { busy = false; confirm.disabled = false; cancel.disabled = false; }
    });
    update();
  });
</script>
<style>
  [data-catalogue-card][hidden], [data-catalogue-more][hidden], [data-catalogue-empty][hidden] { display: none; }
  #mau-vat-lieu { scroll-margin-top: 6rem; }
</style>
