---
import { materialHeading } from "../data/seoTitles";
import type { Material } from "../data/materials";
interface Props { material: Material; priority?: boolean }
const { material, priority = false } = Astro.props;
---
{material.image ? <img src={material.image} alt={`${materialHeading(material.name)} — mẫu bề mặt`} class="w-full h-full object-cover" loading={priority ? "eager" : "lazy"} fetchpriority={priority ? "high" : "auto"} width="800" height="800" /> : <div class:list={["surface-preview w-full h-full flex flex-col justify-end p-6", `surface-${material.preview}`]}><span class="self-start px-3 py-1 bg-white/90 rounded-full text-base-700 text-xs font-medium">Minh họa hiệu ứng</span></div>}
<style>
  .surface-stone {
    background: linear-gradient(128deg, transparent 20%, #a69d9255 20.3%, transparent 20.8%, transparent 39%, #8c837755 39.4%, transparent 40%, transparent 65%, #b8a58c55 65.6%, transparent 66.3%), repeating-linear-gradient(134deg, #ece9e1 0%, #f7f5ef 18%, #ddd8ce 23%, #f8f6f1 32%);
  }
  .surface-mirror {
    background: linear-gradient(125deg, #68716f 0%, #c5ceca 20%, #eef2ec 36%, #fffaf4 42%, #d2d9d4 52%, #a4afab 72%, #e0e3da 100%);
  }
</style>
