---
import { site } from "../data/site";
interface Props { title?: string; text?: string }
const { title = "Cùng chọn giải pháp cho không gian của bạn.", text = "Bạn cần mua film hay thuê thi công? Gửi mẫu yêu thích, kích thước và địa điểm để được tư vấn vật liệu, số lượng và phương án phù hợp." } = Astro.props;
---
<section class="px-4 sm:px-6 section-space bg-white">
  <div class="max-w-7xl mx-auto rounded-2xl bg-base-900 ink-gradient p-6 sm:p-10 lg:p-12 grid lg:grid-cols-[minmax(0,1fr)_auto] items-center gap-6">
    <div><p class="text-accent-200 text-xs font-semibold tracking-widest mb-4">BẮT ĐẦU TỪ MỘT CUỘC TRAO ĐỔI</p><h2 class="text-white text-2xl md:text-[1.625rem] font-semibold max-w-2xl">{title}</h2><p class="text-white/80 mt-4 max-w-2xl">{text}</p></div>
    <div class="flex flex-col sm:flex-row lg:flex-col gap-3"><a href={site.zaloHref} class="button-secondary button-accent">Tư vấn qua Zalo →</a><a href={site.phoneHref} class="inline-flex justify-center items-center min-h-11 text-white text-sm font-semibold hover:underline">Gọi {site.phone}</a></div>
  </div>
</section>
