---
import { site } from "../data/site";
interface Props { title?: string; text?: string }
const { title = "Cùng chọn giải pháp cho không gian của bạn.", text = "Gửi ảnh hiện trạng và kích thước dự kiến. iDecal sẽ cùng bạn trao đổi mẫu film, điều kiện bề mặt và phạm vi thi công." } = Astro.props;
---
<section class="px-4 sm:px-6 py-12 md:py-16 bg-white">
  <div class="max-w-7xl mx-auto rounded-3xl bg-base-900 p-6 sm:p-10 lg:p-12 grid lg:grid-cols-[minmax(0,1fr)_auto] items-center gap-8">
    <div><p class="text-primary-200 text-xs font-semibold tracking-widest mb-4">BẮT ĐẦU TỪ MỘT CUỘC TRAO ĐỔI</p><h2 class="text-white text-2xl md:text-3xl font-semibold max-w-2xl">{title}</h2><p class="text-white/80 mt-4 max-w-2xl">{text}</p></div>
    <div class="flex flex-col sm:flex-row lg:flex-col gap-3"><a href={site.zaloHref} class="button-secondary">Tư vấn qua Zalo →</a><a href={site.phoneHref} class="inline-flex justify-center items-center min-h-11 text-white text-sm font-semibold hover:underline">Gọi {site.phone}</a></div>
  </div>
</section>
