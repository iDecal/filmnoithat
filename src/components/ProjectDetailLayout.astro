---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import Icon from "./Icon.astro";
import ProjectBeforeAfter from "./ProjectBeforeAfter.astro";
import { projectStories, storyHref, storyLabel, type ProjectStory } from "../data/projectStories";
import type { ProjectConcept } from "../data/projectConcepts";
import { catalogue } from "../data/catalogue";
import { breadcrumbSchema } from "../data/seo";
interface Props { story: ProjectStory; concept?: ProjectConcept }
const { story, concept } = Astro.props;
const actual = story.kind === "completed";
const linkedSamples = catalogue.filter(sample => story.sampleSlugs.includes(sample.slug));
const related = projectStories.filter(item => item.slug !== story.slug && item.kind !== "catalogue").sort((a,b) => b.categories.filter(category=>story.categories.includes(category)).length-a.categories.filter(category=>story.categories.includes(category)).length).slice(0,3);
const formatDate = (value?: string) => {
  if (!value) return "Chưa cập nhật";
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? value : new Intl.DateTimeFormat("vi-VN",{day:"2-digit",month:"2-digit",year:"numeric",timeZone:"UTC"}).format(date);
};
const materialNames = actual ? (story.materials.length ? story.materials.join(" · ") : linkedSamples.map(sample=>`${sample.brand} ${sample.code}`).join(" · ")) : "Chưa cập nhật";
const facts = [
  {icon:"interior" as const,label:"Địa điểm",value:story.location || (actual ? "Chưa cập nhật" : "Chưa có địa điểm thực tế")},
  {icon:"layers" as const,label:"Vật liệu sử dụng",value:materialNames || "Chưa cập nhật"},
  {icon:"calendar" as const,label:"Ngày bắt đầu",value:formatDate(story.startDate),date:story.startDate},
  {icon:"check" as const,label:"Ngày hoàn thành",value:formatDate(story.completionDate),date:story.completionDate},
];
---
<BaseLayout title={`${story.title} | Film Nội Thất`} description={story.description} image={story.images[0].src} structuredData={[breadcrumbSchema(Astro.site!,[{name:"Công trình",path:"/cong-trinh/"},{name:story.title,path:storyHref(story)}])]}>
  <section id="thong-tin-cong-trinh" class="project-detail-intro"><div class="project-detail-wrap"><Breadcrumbs items={[{label:"Công trình",href:"/cong-trinh/"},{label:story.title}]} /><div class="project-detail-intro-grid"><div><p class="project-detail-kicker">{actual ? "CÔNG TRÌNH THỰC TẾ" : concept ? "PHƯƠNG ÁN MINH HỌA" : storyLabel(story).toUpperCase()}</p><h1>{story.title}</h1><p class="project-detail-lead">{story.description}</p><dl class="project-detail-facts">{facts.map(fact=><div><dt><span class="project-detail-icon"><Icon name={fact.icon} size={20} /></span>{fact.label}</dt><dd>{fact.date ? <time datetime={fact.date}>{fact.value}</time> : fact.value}</dd></div>)}</dl>{!actual&&<p class="project-detail-reference-note">Ảnh và vật liệu trên trang dùng để tham khảo phương án. Đây chưa phải hồ sơ công trình đã thi công; địa điểm, lịch thực hiện và ảnh trước–sau chưa được xác nhận.</p>}</div><figure class="project-detail-cover"><img src={story.images[0].src} alt={story.images[0].alt} width="1200" height="900" fetchpriority="high" /><figcaption>{actual ? story.images[0].alt : "Ảnh phương án tham khảo, không phải ảnh sau thi công."}</figcaption></figure></div></div></section>
  <nav class="project-detail-nav" aria-label="Nội dung công trình"><div class="project-detail-wrap"><a href="#thong-tin-cong-trinh">Thông tin công trình</a><a href="#truoc-va-sau">Ảnh trước & sau</a><a href="#cong-trinh-lien-quan">Công trình liên quan</a></div></nav>

  <section id="truoc-va-sau" class="project-detail-section project-detail-soft"><div class="project-detail-wrap"><header class="project-detail-section-heading"><div><p class="project-detail-kicker">HIỆN TRẠNG & KẾT QUẢ</p><h2>Ảnh trước và sau thi công.</h2></div><p>{story.beforeAfter?.length ? "Đối chiếu hình ảnh hiện trạng và hoàn thiện theo từng góc chụp." : "Khu vực ảnh trước–sau sẽ được bổ sung khi có hình ảnh thực tế của cùng hạng mục."}</p></header><ProjectBeforeAfter comparisons={story.beforeAfter} /></div></section>

  <section id="cong-trinh-lien-quan" class="project-detail-section project-detail-soft"><div class="project-detail-wrap"><header class="project-detail-section-heading"><div><p class="project-detail-kicker">KHÁM PHÁ THÊM</p><h2>Công trình liên quan.</h2></div><a href="/cong-trinh/" class="outline-action">Tất cả công trình<Icon name="arrow" size={17} /></a></header><div class="project-detail-related">{related.map(item=><a href={storyHref(item)}><img src={item.images[0].src} alt={item.images[0].alt} width="1000" height="700" loading="lazy" /><div><p>{storyLabel(item)}</p><h3>{item.title}</h3><span>Xem chi tiết<Icon name="arrow" size={16} /></span></div></a>)}</div></div></section>
</BaseLayout>
<style>
  .project-detail-wrap { width: min(1280px,calc(100% - 40px)); margin-inline: auto; }
  .project-detail-intro { padding-block: 2rem 3rem; background: white; }
  .project-detail-intro-grid { display: grid; gap: 2rem; align-items: center; }
  .project-detail-kicker { font-size: .625rem; letter-spacing: .12em; font-weight: 600; color: var(--muted); margin-bottom: .875rem; }
  .project-detail-intro h1 { font-size: 1.875rem; font-weight: 500; line-height: 1.2; text-wrap: balance; }
  .project-detail-lead { margin-top: 1.25rem; font-size: .9375rem; line-height: 1.8; color: var(--muted); }
  .project-detail-facts { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .75rem; margin-top: 1.5rem; }
  .project-detail-facts > div { min-width: 0; padding: 1rem; border-radius: 14px; background: #f3f5f7; }
  .project-detail-facts dt { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-size: .6875rem; color: var(--muted); }
  .project-detail-icon { display: grid; place-items: center; width: 34px; height: 34px; flex-shrink: 0; border-radius: 10px; color: var(--navy); background: #f3e5cc; }
  .project-detail-facts dd { margin-top: .625rem; font-size: .8125rem; font-weight: 500; line-height: 1.6; overflow-wrap: anywhere; }
  .project-detail-reference-note { margin-top: 1rem; font-size: .75rem; line-height: 1.7; color: var(--muted); }
  .project-detail-cover img { width: 100%; aspect-ratio: 4/5; max-height: 640px; object-fit: cover; border-radius: 20px; }
  .project-detail-cover figcaption { margin-top: .75rem; font-size: .75rem; line-height: 1.6; color: var(--muted); }
  .project-detail-nav { background: #f3f5f7; }
  .project-detail-nav > div { display: flex; flex-wrap: wrap; gap: .5rem; padding-block: .75rem; }
  .project-detail-nav a { display: flex; align-items: center; min-height: 44px; padding: .625rem .875rem; border-radius: 999px; font-size: .8125rem; }
  .project-detail-nav a:hover { background: var(--navy); color: var(--ivory); }
  .project-detail-section { padding-block: clamp(3rem,6vw,5rem); scroll-margin-top: 7rem; }
  .project-detail-soft { background: #f6f7f9; }
  .project-detail-section-heading { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
  .project-detail-section-heading h2 { font-size: 1.5rem; line-height: 1.4; font-weight: 500; }
  .project-detail-section-heading > p { max-width: 28rem; font-size: .875rem; line-height: 1.8; color: var(--muted); }
  .project-detail-section-heading .outline-action { font-size: .8125rem; }
  .project-detail-related { display: grid; gap: 1.5rem; }
  .project-detail-related > a { min-width: 0; overflow: hidden; border-radius: 16px; background: white; }
  .project-detail-related img { width: 100%; aspect-ratio: 3/2; object-fit: cover; }
  .project-detail-related a > div { padding: 1.25rem; }
  .project-detail-related p { font-size: .625rem; color: var(--muted); }
  .project-detail-related h3 { margin-top: .5rem; font-size: 1.125rem; font-weight: 500; line-height: 1.5; }
  .project-detail-related span { display: flex; align-items: center; justify-content: space-between; gap: .75rem; min-height: 44px; margin-top: .75rem; font-size: .8125rem; }
  @media(min-width:640px) { .project-detail-wrap { width: min(1280px,calc(100% - 48px)); }.project-detail-related { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media(min-width:1024px) { .project-detail-intro { padding-top: 3rem; }.project-detail-intro-grid { grid-template-columns: 1.05fr .95fr; gap: 3rem; }.project-detail-intro h1 { font-size: 2.5rem; }.project-detail-section-heading { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 3rem; }.project-detail-related { grid-template-columns: repeat(3,minmax(0,1fr)); } }
</style>
