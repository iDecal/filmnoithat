---
import Icon from "./Icon.astro";
import { categoryIcon } from "../data/icons";
import { site, serviceLinks, materialLinks, companyLinks } from "../data/site";
interface Props { brandName?: string }
const { brandName = site.name } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-accent-50 text-base-900 px-4 sm:px-6 pt-14 md:pt-20 pb-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 sm:gap-x-10 gap-y-9 sm:gap-y-12 pb-12">
      <div class="col-span-2 lg:col-span-1 min-w-0">
        <a href="/" class="inline-block font-heading text-2xl font-semibold leading-snug" aria-label={`${brandName} — Trang chủ`}>{brandName}</a>
        <p class="text-accent-700 text-sm font-medium mt-3">{site.tagline}</p>
        <p class="text-base-600 text-sm leading-relaxed mt-5 max-w-sm">
          Cung cấp film trang trí và thi công cho bàn, tủ, tường, trần và thang máy. Cùng bạn chọn vật liệu phù hợp để làm mới không gian.
        </p>
        <a href={site.zaloHref} class="inline-flex items-center justify-center min-h-11 px-5 py-3 mt-6 rounded-xl bg-white text-base-900 font-semibold text-sm hover:bg-primary-100 transition-colors">Tư vấn qua Zalo <span aria-hidden="true" class="ml-2">→</span></a>
      </div>

      <nav aria-labelledby="footer-services-title" class="min-w-0">
        <h2 id="footer-services-title" class="text-lg font-semibold text-accent-700 mb-4"><a href="/dich-vu/dan-film-noi-that/" class="inline-flex items-center min-h-11 hover:underline">Dịch vụ</a></h2>
        <ul class="space-y-1 text-sm">
          {serviceLinks.map(link => <li><a href={link.href} class="footer-link icon-link">{categoryIcon(link.href) && <Icon name={categoryIcon(link.href)!} size={17} />}<span>{link.label}</span></a></li>)}
        </ul>
      </nav>

      <nav aria-labelledby="footer-materials-title" class="min-w-0">
        <h2 id="footer-materials-title" class="text-lg font-semibold text-accent-700 mb-4"><a href="/vat-lieu/" class="inline-flex items-center min-h-11 hover:underline">Vật liệu</a></h2>
        <ul class="space-y-1 text-sm">
          {materialLinks.map(link => <li><a href={link.href} class="footer-link icon-link">{categoryIcon(link.href) && <Icon name={categoryIcon(link.href)!} size={17} />}<span>{link.label}</span></a></li>)}
        </ul>
      </nav>

      <div class="col-span-2 lg:col-span-1 min-w-0">
        <h2 class="text-lg font-semibold text-accent-700 mb-4">Liên hệ tư vấn</h2>
        <address class="not-italic text-sm leading-relaxed">
          <p class="text-base-600">Hotline / Zalo</p>
          <a href={site.phoneHref} class="inline-flex items-center min-h-11 text-xl font-semibold hover:text-accent-700 transition-colors">{site.phone}</a>
          <a href={`mailto:${site.email}`} class="footer-link break-words">{site.email}</a>
          <p class="text-base-600 mt-5">Khu vực phục vụ</p>
          <p class="text-base-900 mt-1">{site.serviceArea}</p>
        </address>
        <a href="/lien-he/" class="footer-link mt-4">Thông tin liên hệ <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="border-t border-base-200 pt-6 flex flex-col lg:flex-row lg:items-center justify-between gap-5">
      <p class="text-sm text-base-600">© {currentYear} {brandName}</p>
      <nav aria-label="Thông tin website">
        <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
          {companyLinks.map(link => <li><a href={link.href} class="footer-link icon-link">{categoryIcon(link.href) && <Icon name={categoryIcon(link.href)!} size={17} />}<span>{link.label}</span></a></li>)}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    display: block;
    width: fit-content;
    max-width: 100%;
    padding-block: 0.625rem;
    color: #56636c;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 150ms;
  }
  .icon-link { display: flex; align-items: center; gap: 0.5rem; }
  .footer-link:hover { color: #705130; text-decoration-line: underline; }
</style>
