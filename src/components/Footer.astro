---
import Icon from "./Icon.astro";
import { categoryIcon } from "../data/icons";
import { site, serviceLinks, materialLinks, companyLinks } from "../data/site";
const currentYear = new Date().getFullYear();
---

<footer class="bg-base-900 text-white px-4 sm:px-6 pt-14 md:pt-20 pb-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-10 gap-y-12 pb-12">
      <div>
        <a href="/" class="inline-block text-2xl font-semibold leading-snug" aria-label={`${site.name} — Trang chủ`}>{site.name}</a>
        <p class="text-primary-200 text-sm font-medium mt-3">{site.tagline}</p>
        <p class="text-white/80 text-sm leading-relaxed mt-5 max-w-sm">
          Cung cấp film trang trí và thi công cho bàn, tủ, tường, trần và thang máy. Cùng bạn chọn vật liệu phù hợp để làm mới không gian.
        </p>
        <a href={site.zaloHref} class="inline-flex items-center justify-center min-h-11 px-5 py-3 mt-6 rounded-xl bg-white text-base-900 font-semibold text-sm hover:bg-primary-100 transition-colors">Tư vấn qua Zalo <span aria-hidden="true" class="ml-2">→</span></a>
      </div>

      <nav aria-labelledby="footer-services-title">
        <h2 id="footer-services-title" class="text-base font-semibold text-primary-200 mb-4">Dịch vụ thi công</h2>
        <ul class="space-y-1 text-sm">
          <li><a href="/dich-vu/dan-film-noi-that/" class="footer-link">Tổng quan dịch vụ</a></li>
          {serviceLinks.map(link => <li><a href={link.href} class="footer-link icon-link">{categoryIcon(link.href) && <Icon name={categoryIcon(link.href)!} size={17} />}<span>{link.label}</span></a></li>)}
        </ul>
      </nav>

      <nav aria-labelledby="footer-materials-title">
        <h2 id="footer-materials-title" class="text-base font-semibold text-primary-200 mb-4">Film & vật liệu</h2>
        <ul class="space-y-1 text-sm">
          <li><a href="/vat-lieu/" class="footer-link">Tất cả vật liệu</a></li>
          <li><a href="/san-pham/" class="footer-link">Mẫu film theo mã</a></li>
          {materialLinks.map(link => <li><a href={link.href} class="footer-link icon-link">{categoryIcon(link.href) && <Icon name={categoryIcon(link.href)!} size={17} />}<span>{link.label}</span></a></li>)}
        </ul>
      </nav>

      <div>
        <h2 class="text-base font-semibold text-primary-200 mb-4">Liên hệ tư vấn</h2>
        <address class="not-italic text-sm leading-relaxed">
          <p class="text-white/80">Hotline / Zalo</p>
          <a href={site.phoneHref} class="inline-flex items-center min-h-11 text-xl font-semibold hover:text-primary-200 transition-colors">{site.phone}</a>
          <a href={`mailto:${site.email}`} class="footer-link break-words">{site.email}</a>
          <p class="text-white/80 mt-5">Khu vực phục vụ</p>
          <p class="text-white mt-1">{site.serviceArea}</p>
        </address>
        <a href="/lien-he/" class="footer-link mt-4">Thông tin liên hệ <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="border-t border-white/20 pt-6 flex flex-col lg:flex-row lg:items-center justify-between gap-5">
      <p class="text-sm text-white/80">© {currentYear} {site.name} · iDecal</p>
      <nav aria-label="Thông tin website">
        <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
          {companyLinks.map(link => <li><a href={link.href} class="footer-link icon-link">{categoryIcon(link.href) && <Icon name={categoryIcon(link.href)!} size={17} />}<span>{link.label}</span></a></li>)}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    display: block;
    width: fit-content;
    max-width: 100%;
    padding-block: 0.625rem;
    color: rgb(255 255 255 / 0.8);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 150ms;
  }
  .icon-link { display: flex; align-items: center; gap: 0.5rem; }
  .footer-link:hover { color: white; text-decoration-line: underline; }
</style>
