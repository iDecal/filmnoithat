---
import { productHref, type Product } from "../data/products";
interface Props { products: Product[]; title?: string }
const { products, title = "Mẫu film tham khảo" } = Astro.props;
---
<section class="px-4 sm:px-6 py-14 md:py-20 bg-base-50">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div><h2 class="text-2xl md:text-3xl font-semibold">{title}</h2><p class="mt-3 text-base-600">Xem mẫu và ứng dụng; liên hệ xác nhận thông số, giá và tình trạng cung cấp.</p></div>
      <a href="/san-pham/" class="text-primary-600 font-medium py-2 hover:underline">Tất cả mẫu film →</a>
    </div>
    <div class:list={["grid gap-6", products.length === 1 ? "grid-cols-1" : products.length > 3 ? "sm:grid-cols-2 lg:grid-cols-4" : products.length === 3 ? "sm:grid-cols-2 lg:grid-cols-3" : "sm:grid-cols-2"]}>
      {products.map(product => <a href={productHref(product)} class:list={["group bg-white rounded-2xl overflow-hidden border border-base-200 hover:border-primary-300 hover:shadow-md transition", { "md:grid md:grid-cols-2": products.length === 1 }]}>
        <img src={product.image} alt={product.name} class="w-full aspect-[4/3] object-cover" loading="lazy" width="600" height="450" />
        <div class:list={["p-5", { "md:p-10 flex flex-col justify-center": products.length === 1 }]}><p class="text-xs font-semibold text-primary-600">MÃ {product.code}</p><h3 class:list={["font-semibold mt-2", { "text-2xl": products.length === 1 }]}>{product.name}</h3><p class="text-sm text-base-600 mt-3">{products.length === 1 ? product.description : product.applications[0]}</p><span class="block mt-4 text-sm text-primary-600 font-medium">Xem mẫu film →</span></div>
      </a>)}
    </div>
  </div>
</section>
