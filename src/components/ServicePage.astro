---
import { heroBackdrop } from "../data/heroBackdrops";
import { uploadedImageAlt } from "../data/uploadedImages";
import Icon from "./Icon.astro";
import ServiceReferenceGallery from "./ServiceReferenceGallery.astro";
import { categoryIcon } from "../data/icons";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import { services, serviceHref, type Service } from "../data/services";
import { getServiceLayout } from "../data/serviceLayouts";
import MaterialPreview from "./MaterialPreview.astro";
import { findMaterials, materialHref } from "../data/materials";
import { posts, postHref } from "../data/posts";
import { projectsForService } from "../data/projects";
import { site, internationalPhone } from "../data/site";
import { breadcrumbSchema } from "../data/seo";
interface Props { service: Service }
const { service } = Astro.props;
const overview = service.slug === "dan-film-noi-that";
const target = service.heading.replace(/^Film dán nội thất cho /, "").toLowerCase();
const design = getServiceLayout(service.slug);
const mobileLeads: Record<string, string> = {
  "dan-film-noi-that": "Film dán nội thất cho bàn, tủ và vách còn kết cấu tốt.",
  "dan-film-tu-bep": "Đổi màu cánh tủ bếp với film dán nội thất, giữ lại phần cốt còn tốt.",
  "dan-film-ban": "Làm mới bàn và kệ với film dán nội thất phù hợp cách sử dụng.",
  "dan-film-tuong": "Chọn film dán nội thất cho vách theo nền và ánh sáng thực tế.",
  "dan-film-tran": "Film dán nội thất cho trần: chọn chất liệu, kiểm tra nền và vị trí kỹ thuật.",
  "dan-film-thang-may": "Film dán nội thất cho vách cabin theo phạm vi thống nhất với đơn vị quản lý.",
};
const relatedServices = services.filter(item => item.slug !== service.slug);
const matchingPosts = posts.filter(post => post.services.includes(service.slug));
const relatedPosts = [...matchingPosts, ...posts.filter(post => !matchingPosts.includes(post))].slice(0, 3);
const relatedProjects = projectsForService(service.slug);
const selectedMaterials = findMaterials(service.materials);
const crumbs = overview ? [{ label: "Dịch vụ dán film nội thất" }] : [{ label: "Dịch vụ", href: "/dich-vu/dan-film-noi-that/" }, { label: service.name }];
const schema = [
  {
    "@context": "https://schema.org", "@type": "Service",
    name: service.name, serviceType: service.name, description: service.description,
    url: new URL(serviceHref(service), Astro.site).href,
    provider: { "@type": "Organization", name: "Film Nội Thất", url: Astro.site!.href, telephone: internationalPhone },
    areaServed: { "@type": "Country", name: "Việt Nam" },
  },
  breadcrumbSchema(Astro.site!, overview ? [{ name: service.name, path: serviceHref(service) }] : [{ name: "Dịch vụ", path: "/dich-vu/dan-film-noi-that/" }, { name: service.name, path: serviceHref(service) }]),
];
const navigation = [
  { id: "pham-vi", label: "Phạm vi" }, { id: "luu-y", label: "Bề mặt & lưu ý" },
  { id: "mau-film", label: "Mẫu film" }, { id: "quy-trinh", label: "Quy trình" },
  { id: "nhan-tu-van", label: "Nhận báo giá" }, { id: "cau-hoi", label: "Câu hỏi" },
  { id: "cong-trinh-lien-quan", label: "Công trình" }, { id: "blog-tu-van", label: "Blog tư vấn" },
];
const steps = [
  { title: "Chia sẻ hiện trạng", text: "Gửi ảnh, kích thước, địa điểm và cách sử dụng để cùng xác định nhu cầu." },
  { title: "Khảo sát & xem mẫu", text: "Kiểm tra nền, so mẫu dưới ánh sáng thực tế và thống nhất chiều vân, mối nối." },
  { title: "Chốt phạm vi & thi công", text: "Xác nhận vật tư, xử lý nền, tháo lắp, nhân công và tiến độ trước khi thực hiện." },
  { title: "Kiểm tra & bàn giao", text: "Xem lại góc mép, mối nối và phụ kiện; nhận hướng dẫn chăm sóc theo mã vật liệu." },
];
---
<BaseLayout faqs={service.faqs} title={service.title} description={service.description} image={service.image} structuredData={schema}>
  <div class="service-page">
    <section class="editorial-hero service-hero px-4 sm:px-6 pt-4 pb-6 lg:pt-10 lg:pb-16 bg-base-50 surface-gradient">
      <div class="max-w-7xl mx-auto">
        <div class="hidden lg:block"><Breadcrumbs items={crumbs} /></div>
        <a href={overview ? "/" : "/dich-vu/dan-film-noi-that/"} class="inline-flex items-center min-h-11 text-sm text-base-600 mb-2 lg:hidden">← {overview ? "Trang chủ" : "Tất cả dịch vụ"}</a>
        <div class="grid lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] gap-5 lg:gap-14 items-center">
          <div>
            <p class="eyebrow flex items-center gap-2 text-xs mb-3 lg:mb-5"><Icon name={categoryIcon(service.slug)!} size={22} />THI CÔNG THEO NHU CẦU</p>
            <h1 class="text-[1.75rem] sm:text-3xl lg:text-4xl xl:text-[2.5rem] font-medium leading-[1.18]">{service.heading}</h1>
            <p class="hero-title-accent hidden lg:block text-2xl font-medium text-primary-500 mt-4 leading-snug text-balance">{design.accent}</p>
            <p class="lg:hidden text-base text-base-600 mt-3">{mobileLeads[service.slug]}</p>
            <p class="hidden lg:block text-lg text-base-600 mt-6 max-w-xl">{design.lead}</p>
            <div class="grid grid-cols-2 lg:flex lg:flex-wrap gap-3 mt-5 lg:mt-8"><a href="#nhan-tu-van" class="button-primary service-hero-action"><span class="lg:hidden">Nhận tư vấn</span><span class="hidden lg:inline">Nhận tư vấn & báo giá →</span></a><a href="#mau-film" class="button-secondary service-hero-action">Xem mẫu film</a></div>
            <ul class="hidden lg:flex flex-wrap gap-x-5 gap-y-2 mt-7 text-sm text-base-600"><li><span aria-hidden="true" class="text-primary-600 mr-2">✓</span>Xem mẫu trước</li><li><span aria-hidden="true" class="text-primary-600 mr-2">✓</span>Chốt rõ phạm vi</li></ul>
          </div>
          <div>
            <figure class="relative rounded-2xl lg:rounded-3xl overflow-hidden bg-white border border-base-200"><img src={service.image} alt={service.imageAlt || uploadedImageAlt(service.image, `Hình tham khảo cho ${service.name.toLowerCase()}`)} width="1000" height="800" fetchpriority="high" class="service-hero-image w-full aspect-[16/9] lg:aspect-[5/4] object-cover" /><span class="absolute bottom-3 left-3 lg:hidden bg-white/95 text-base-700 text-xs px-3 py-1 rounded-full">Ảnh tham khảo</span><figcaption class="hidden lg:block px-5 py-4 text-sm text-base-600">{design.caption}</figcaption></figure>

          </div>
        </div>
      </div>
    </section>

    <nav class="service-jump-nav px-4 sm:px-6 bg-white border-y border-base-200 z-40" aria-label="Nội dung trang dịch vụ">
      <div class="service-jump-strip max-w-7xl mx-auto flex gap-x-5 lg:gap-x-7 overflow-x-auto py-2">{navigation.map((item, index) => <a data-service-link href={`#${item.id}`} class="service-jump-link shrink-0 inline-flex items-center gap-2 text-sm font-medium whitespace-nowrap"><span aria-hidden="true" class="text-xs opacity-60">0{index + 1}</span>{item.label}</a>)}</div>
    </nav>

    <section id="pham-vi" data-service-section class="service-anchor service-section px-4 sm:px-6 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="service-section-heading"><div><p class="eyebrow mb-3">01 / PHẠM VI CÔNG VIỆC</p><h2 class="text-2xl sm:text-[1.625rem] md:text-[1.875rem] font-semibold">{design.scopeTitle}</h2></div><p class="text-base-600">{service.intro}</p></div>
        <div class="service-scope-layout">
          <figure class="service-scope-visual"><img src={heroBackdrop(Astro.url.pathname)} alt={`Ảnh tham khảo vật liệu và không gian cho ${service.name.toLowerCase()}`} width="1000" height="750" loading="lazy" class="w-full h-full object-cover" /><figcaption><span>ỨNG DỤNG THAM KHẢO</span><p>{design.accent}</p></figcaption></figure>
          <div class="service-scope-list">{design.scope.map((item,index) => <details data-scope-detail open={index===0} class="service-scope-card"><summary><span class="service-card-number">0{index+1}</span><h3 class="text-lg font-semibold">{item.title}</h3><span class="service-detail-plus" aria-hidden="true">+</span></summary><p class="text-base-600">{item.text}</p></details>)}</div>
        </div>
      </div>
    </section>

    <section id="luu-y" data-service-section class="service-anchor service-section service-surface-section px-4 sm:px-6">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.4fr)] gap-9 lg:gap-16">
        <div><p class="text-accent-200 text-xs font-semibold tracking-widest mb-5">02 / HIỂU ĐÚNG BỀ MẶT</p><h2 class="text-white text-2xl sm:text-[1.625rem] md:text-[1.875rem] font-semibold">Đẹp từ mẫu.<br />Bền từ cách chuẩn bị.</h2><p class="text-white/80 mt-6">Film dán nội thất là lớp hoàn thiện bên ngoài. Hiện trạng nền và cách sử dụng quyết định những gì cần kiểm tra trước khi thi công.</p><a href="/blog/cach-chon-film-noi-that/" class="inline-block py-3 mt-5 text-accent-200 font-medium hover:underline">Đọc hướng dẫn chọn film →</a></div>
        <div class="space-y-7">{service.sections.map((section, index) => <details data-surface-detail open={index === 0} class="service-surface-detail border-b border-white/20 pb-5 last:border-0 last:pb-0"><summary class="flex items-start gap-3 cursor-pointer list-none"><span class="text-accent-200 text-sm font-semibold pt-1">0{index + 1}</span><h3 class="text-white text-lg md:text-lg font-semibold flex-1">{section.title}</h3><span class="service-detail-plus text-accent-200" aria-hidden="true">+</span></summary><p class="text-white/80 leading-relaxed mt-4 pl-8">{section.text}</p></details>)}</div>
      </div>
    </section>

    <section id="mau-film" data-service-section class="service-anchor service-section px-4 sm:px-6 bg-base-50">
      <div class="max-w-7xl mx-auto">
        <div class="service-section-heading"><div><p class="eyebrow mb-3">03 / CHỌN VẬT LIỆU</p><h2 class="text-2xl sm:text-[1.625rem] md:text-[1.875rem] font-semibold">Chọn film dán nội thất cho {target}</h2></div><div><p class="text-base-600">So mẫu thực tế, hướng vân và thông số trước khi quyết định. Giá và tình trạng cung cấp được xác nhận theo vật liệu, số lượng và thời điểm đặt.</p><a href="/vat-lieu/" class="inline-flex items-center min-h-11 text-primary-600 text-sm font-semibold mt-2">Tất cả vật liệu <span aria-hidden="true" class="ml-2">→</span></a></div></div>
        <div class="service-material-grid" style={{ "--service-material-count": selectedMaterials.length }}>{selectedMaterials.map(material => <a href={materialHref(material)} class="service-material-card group"><div class="service-material-preview overflow-hidden"><MaterialPreview material={material} /></div><div class="service-material-label"><span class="service-material-icon"><Icon name={categoryIcon(material.slug)!} size={20} /></span><div><h3 class="text-sm sm:text-lg font-semibold">{material.name}</h3><p class="text-xs text-base-600 mt-1">{material.moodLabel}</p></div><Icon name="arrow" size={16} class="shrink-0" /></div></a>)}</div>
      </div>
    </section>

    <section id="quy-trinh" data-service-section class="service-anchor service-section px-4 sm:px-6 bg-white">
      <div class="max-w-7xl mx-auto"><div class="service-section-heading"><div><p class="eyebrow mb-3">04 / CÁCH CHÚNG TÔI LÀM VIỆC</p><h2 class="text-2xl sm:text-[1.625rem] md:text-[1.875rem] font-semibold">Rõ từng bước. Gọn từng việc.</h2></div><p class="text-base-600">Từ ảnh hiện trạng đến kiểm tra hoàn thiện, phạm vi và phương án được trao đổi trước khi thi công.</p></div>
        <ol class="service-process-grid">{steps.map((step,index) => <li><span class="service-process-number">0{index+1}</span><h3 class="text-lg font-semibold mt-4">{step.title}</h3><p class="text-sm text-base-600 mt-3">{step.text}</p></li>)}</ol>
      </div>
    </section>

    <section id="nhan-tu-van" data-service-section class="service-anchor service-section px-4 sm:px-6 bg-base-50">
      <div class="max-w-7xl mx-auto service-quote-layout"><div class="service-quote-prep"><p class="eyebrow mb-3">05 / NHẬN TƯ VẤN & BÁO GIÁ</p><h2 class="text-2xl sm:text-[1.625rem] md:text-[1.875rem] font-semibold">Bắt đầu từ ảnh hiện trạng.</h2><p class="text-base-600 mt-4">Chuẩn bị thông tin cho hạng mục {service.name.toLowerCase()} để tư vấn sát nhu cầu.</p><ol class="service-preparation-list">{service.preparation.map((item,index)=><li><span>0{index+1}</span><p>{item}</p></li>)}</ol><p class="text-sm text-base-600 mt-5">Báo giá phụ thuộc mã film, khối lượng, xử lý nền, góc cạnh, tháo lắp và điều kiện tiếp cận. Phạm vi và chi phí được thống nhất trước khi thi công.</p></div>
        <aside class="service-quote-card" aria-labelledby="service-contact-title"><p class="service-quote-kicker">TƯ VẤN VẬT LIỆU & THI CÔNG</p><h2 id="service-contact-title" class="text-2xl font-semibold mt-4">Bạn gửi ảnh.<br />Cùng bàn phương án.</h2><p class="service-quote-muted mt-4">Gửi ảnh, kích thước và địa điểm qua Zalo để trao đổi mẫu phù hợp.</p><div class="grid sm:grid-cols-2 gap-3 mt-6"><a href={site.zaloHref} class="button-primary">Tư vấn qua Zalo →</a><a href={site.phoneHref} class="button-secondary">Gọi {site.phone}</a></div><div class="service-quote-footer"><a href={`mailto:${site.email}`}>{site.email}</a><p>{site.serviceArea}</p></div></aside>
      </div>
    </section>

    <section id="cau-hoi" data-service-section class="service-anchor service-section px-4 sm:px-6 bg-white">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.4fr)] gap-8 lg:gap-16"><div><p class="eyebrow mb-4">06 / GIẢI ĐÁP TRƯỚC KHI LÀM</p><h2 class="text-2xl sm:text-[1.625rem] font-semibold">Những điều<br />bạn có thể đang hỏi.</h2><a href="/lien-he/" class="inline-block mt-5 py-3 text-primary-600 font-semibold hover:underline">Trao đổi thêm với Film Nội Thất →</a></div><div class="space-y-4">{service.faqs.map(faq => <details class="service-faq rounded-2xl bg-base-50 border border-base-200 p-5 sm:p-6"><summary class="flex justify-between items-start gap-4 cursor-pointer list-none font-semibold"><span>{faq.question}</span><svg class="service-faq-icon w-5 h-5 shrink-0 text-primary-600 mt-1 transition-transform" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></summary><p class="text-base-600 mt-5">{faq.answer}</p></details>)}</div></div>
    </section>

    <section id="cong-trinh-lien-quan" data-service-section class="service-anchor service-section px-4 sm:px-6 warm-surface" aria-labelledby="related-projects-title">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-2xl mb-7"><p class="eyebrow mb-4">07 / CÔNG TRÌNH LIÊN QUAN</p><h2 id="related-projects-title" class="text-2xl sm:text-[1.625rem] md:text-[1.875rem] font-semibold">Từ hiện trạng đến hoàn thiện.</h2><p class="text-base-600 mt-4">Xem hình ảnh ứng dụng cho {service.name.toLowerCase()} để hình dung cách phối vật liệu. Hồ sơ công trình thực tế được bổ sung khi có thông tin và ảnh xác nhận.</p></div>
        {relatedProjects.length ? <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">{relatedProjects.map(project => <article id={`cong-trinh-${project.id}`} class="min-w-0 border-t border-base-200 pt-5">
          <img src={project.image} alt={project.title} width="900" height="600" loading="lazy" class="w-full aspect-[3/2] object-cover rounded-xl" />
          {project.location && <p class="text-xs text-base-600 mt-4">{project.location}</p>}
          <h3 class="text-lg font-medium mt-4">{project.title}</h3><p class="text-sm text-base-600 mt-3">{project.summary}</p>
          <details class="mt-4 border-t border-base-200"><summary class="min-h-11 py-3 text-sm text-primary-600 font-semibold cursor-pointer">Xem chi tiết công trình</summary><div class="text-sm text-base-600 pb-4"><p class="font-medium text-base-900 mb-2">Hạng mục thực hiện</p><ul class="list-disc pl-5 space-y-2">{project.scope.map(item => <li>{item}</li>)}</ul><p class="font-medium text-base-900 mt-4 mb-2">Vật liệu sử dụng</p><ul class="list-disc pl-5 space-y-2">{project.materials.map(item => <li>{item}</li>)}</ul>{project.gallery?.map(photo => <img src={photo.src} alt={photo.alt} width="900" height="600" loading="lazy" class="w-full h-auto rounded-xl mt-4" />)}</div></details>
        </article>)}</div> : <ServiceReferenceGallery slug={service.slug} />}
      </div>
    </section>

    <section id="blog-tu-van" data-service-section class="service-anchor service-section px-4 sm:px-6 bg-white" aria-labelledby="service-blog-title">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-7"><div class="max-w-2xl"><p class="eyebrow mb-4">08 / BLOG TƯ VẤN</p><h2 id="service-blog-title" class="text-2xl sm:text-[1.625rem] md:text-[1.875rem] font-semibold">Tìm hiểu kỹ trước khi chọn.</h2><p class="text-base-600 mt-4">Đọc thêm về chọn film, chuẩn bị bề mặt và dự toán chi phí. Bài viết cùng hạng mục được ưu tiên hiển thị trước.</p></div><a href="/blog/" class="inline-flex items-center min-h-11 text-sm font-semibold text-primary-600 shrink-0 hover:underline">Tất cả bài tư vấn →</a></div>
        <div class="grid md:grid-cols-3 gap-6">{relatedPosts.map(post => <article class="min-w-0 border-t border-base-200 pt-5"><a href={postHref(post)} class="group block"><img src={post.image} alt={post.imageAlt || post.title} title={post.imageTitle || post.title} width="800" height="500" loading="lazy" class="w-full aspect-[16/10] object-cover rounded-xl" /><p class="text-xs text-base-600 mt-4">{post.services.includes(service.slug) ? "CÙNG HẠNG MỤC" : "KIẾN THỨC NỀN TẢNG"}</p><h3 class="text-lg font-medium mt-3 group-hover:text-primary-600">{post.title}</h3><p class="text-sm text-base-600 mt-3">{post.description}</p><span class="inline-flex items-center min-h-11 text-sm font-semibold text-primary-600 mt-3 group-hover:underline">Đọc bài tư vấn →</span></a></article>)}</div>
      </div>
    </section>

    <section class="px-4 sm:px-6 py-9 md:py-14 bg-base-50 border-t border-base-200"><div class="max-w-7xl mx-auto"><h2 class="text-2xl font-semibold mb-5">Khám phá thêm dịch vụ</h2><ul class="related-services-list grid md:grid-cols-2 gap-x-10">{relatedServices.map(item => <li class="border-b border-base-200"><a href={serviceHref(item)} class="flex items-center justify-between gap-3 py-4 text-base-700 font-medium hover:text-primary-600">{item.name}<span aria-hidden="true">→</span></a></li>)}</ul></div></section>
  </div>
  <nav class="mobile-service-actions" aria-label="Liên hệ nhanh cho dịch vụ">
    <a href={site.phoneHref} class="button-secondary">Gọi ngay</a>
    <a href={site.zaloHref} class="button-primary">Tư vấn qua Zalo →</a>
  </nav>
</BaseLayout>

<script>
  const page = document.querySelector<HTMLElement>(".service-page");
  const header = document.querySelector<HTMLElement>(".site-header");
  const jumpNav = document.querySelector<HTMLElement>(".service-jump-nav");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-service-link]")];
  const sections = [...document.querySelectorAll<HTMLElement>("[data-service-section]")];
  const actionBar = document.querySelector<HTMLElement>(".mobile-service-actions");
  const menuButton = document.getElementById("menuBtn");
  let quoteVisible = false;
  const updateActions = () => {
    if (actionBar) actionBar.hidden = quoteVisible || menuButton?.getAttribute("aria-expanded") === "true";
  };
  const updateOffsets = () => {
    if (header) page?.style.setProperty("--service-header-height", `${header.getBoundingClientRect().height}px`);
    if (jumpNav) page?.style.setProperty("--service-nav-height", `${jumpNav.getBoundingClientRect().height}px`);
  };
  updateOffsets();
  if ("ResizeObserver" in window) {
    const resizeObserver = new ResizeObserver(updateOffsets);
    if (header) resizeObserver.observe(header);
    if (jumpNav) resizeObserver.observe(jumpNav);
  }
  if (menuButton) new MutationObserver(updateActions).observe(menuButton, { attributes: true, attributeFilter: ["aria-expanded"] });
  const expandedLayout = window.matchMedia("(min-width: 768px)");
  const updateDetails = () => {
    ["[data-scope-detail]", "[data-surface-detail]"].forEach(selector => {
      document.querySelectorAll<HTMLDetailsElement>(selector).forEach((detail, index) => { detail.open = expandedLayout.matches || index === 0; });
    });
  };
  updateDetails();
  expandedLayout.addEventListener("change", updateDetails);
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(entries => {
      const visible = entries.filter(entry => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (!visible.length) return;
      const id = visible[0].target.id;
      links.forEach(link => {
        if (link.hash === `#${id}`) {
          link.setAttribute("aria-current", "location");
          const strip = link.parentElement;
          if (strip && strip.scrollWidth > strip.clientWidth) {
            const bounds = link.getBoundingClientRect();
            const parent = strip.getBoundingClientRect();
            if (bounds.left < parent.left) strip.scrollBy({ left: bounds.left - parent.left - 8 });
            else if (bounds.right > parent.right) strip.scrollBy({ left: bounds.right - parent.right + 8 });
          }
        } else link.removeAttribute("aria-current");
      });
    }, { rootMargin: "-25% 0px -45% 0px", threshold: 0 });
    sections.forEach(section => observer.observe(section));
    const quote = document.getElementById("nhan-tu-van");
    if (quote) new IntersectionObserver(entries => { quoteVisible = entries[0].isIntersecting; updateActions(); }, { threshold: 0 }).observe(quote);
  }
</script>

