---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Film Nội Thất - Dán Film Trang Trí Cao Cấp",
  description = "Dịch vụ dán film nội thất: bàn, tủ, tường, trần, thang máy, showroom. Giải pháp thay đổi không gian không cần phá bỏ.",
} = Astro.props;
---

<html lang="vi">
  <head>
    <meta charset="UTF-8" />

    <!-- SEO BASE -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

  </head>

  <body class="bg-base-50 text-base-900">

    <a href="#main-content" class="skip-link button-primary">Đến nội dung chính</a>
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

  </body>
</html>
