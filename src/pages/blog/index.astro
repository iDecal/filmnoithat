---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { posts, postHref, formatDate } from "../../data/posts";
import { breadcrumbSchema } from "../../data/seo";
---
<BaseLayout title="Blog film nội thất: chọn mẫu, thi công & báo giá | iDecal" description="Cẩm nang film nội thất: cách chọn vật liệu, lưu ý dán tủ bếp và cách so sánh báo giá. Bài viết có liên kết đến mẫu film và dịch vụ phù hợp." structuredData={[breadcrumbSchema(Astro.site!, [{ name: "Kiến thức nội thất", path: "/blog/" }])]}>
  <section class="px-4 sm:px-6 section-space bg-base-50 surface-gradient"><div class="max-w-7xl mx-auto"><Breadcrumbs items={[{ label: "Kiến thức nội thất" }]} /><p class="eyebrow mb-4">CẨM NANG CHỌN FILM & THI CÔNG</p><h1 class="text-3xl md:text-5xl font-semibold">Kiến thức film nội thất</h1><p class="text-base-600 text-lg mt-6 max-w-3xl">Thông tin để bạn chọn vật liệu, chuẩn bị bề mặt và trao đổi phương án thi công rõ ràng hơn.</p></div></section>
  <section class="px-4 sm:px-6 section-space bg-white"><div class="max-w-7xl mx-auto grid md:grid-cols-3 gap-6">
    {posts.map(post => <article class="group"><a href={postHref(post)} class="block group"><img src={post.image} alt={post.title} width="600" height="400" loading="lazy" class="w-full aspect-[3/2] object-cover rounded-xl" /><div class="pt-5"><time datetime={post.date} class="text-xs text-base-600">{formatDate(post.date)}</time><h2 class="text-xl font-semibold mt-3 group-hover:text-primary-600">{post.title}</h2><p class="text-sm text-base-600 mt-4">{post.description}</p><span class="inline-block text-primary-600 font-medium mt-6">Đọc bài viết →</span></div></a></article>)}
  </div></section>
</BaseLayout>
