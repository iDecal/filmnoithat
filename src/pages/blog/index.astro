---
import ColorGuideFeature from "../../components/ColorGuideFeature.astro";
import pageContent from "../../data/pageContent.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { posts, postHref, formatDate } from "../../data/posts";
import { blogCategories, blogCategory } from "../../data/blogCategories";
import { breadcrumbSchema } from "../../data/seo";
---
<BaseLayout title={pageContent.knowledge.title} description={pageContent.knowledge.description} structuredData={[breadcrumbSchema(Astro.site!, [{ name: "Kiến thức nội thất", path: "/blog/" }])]}>
  <section class="editorial-hero px-4 sm:px-6 section-space bg-base-50 surface-gradient"><div class="max-w-7xl mx-auto"><Breadcrumbs items={[{ label: "Kiến thức nội thất" }]} /><p class="eyebrow mb-4">CẨM NANG CHỌN FILM & THI CÔNG</p><h1 class="text-[1.75rem] md:text-4xl font-medium">{pageContent.knowledge.headingLead}</h1><p class="text-base-600 text-lg mt-6 max-w-3xl">{pageContent.knowledge.intro}</p></div></section>
  <ColorGuideFeature prominent />
  <section id="bai-viet" class="px-4 sm:px-6 section-space bg-white" data-blog-browser><div class="max-w-7xl mx-auto">
    <div class="blog-toolbar"><div><p class="eyebrow mb-2">KHÁM PHÁ KIẾN THỨC</p><h2 class="text-2xl font-semibold">Đọc theo điều bạn quan tâm.</h2></div><label class="blog-filter"><span>LỌC CHUYÊN MỤC</span><select data-blog-filter aria-label="Lọc bài viết theo chuyên mục"><option value="all">Tất cả bài viết ({posts.length})</option>{blogCategories.map(category => <option value={category.value}>{category.label} ({posts.filter(post => blogCategory(post.category).value === category.value).length})</option>)}</select></label></div>
    <div class="blog-results-meta"><p data-blog-status role="status" aria-live="polite">{posts.length} bài viết</p><button type="button" data-blog-reset hidden>Đặt lại bộ lọc</button></div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-9">
      {posts.map(post => <article class="group" data-blog-card data-category={blogCategory(post.category).value}><a href={postHref(post)} class="block group"><img src={post.image} alt={post.imageAlt || post.title} title={post.imageTitle || post.title} width="600" height="400" loading="lazy" class="w-full aspect-[3/2] object-cover rounded-xl" /><div class="pt-4"><div class="flex flex-wrap items-center gap-x-3 gap-y-1"><span class="blog-category-badge">{blogCategory(post.category).label}</span><time datetime={post.date} class="text-xs text-base-600">{formatDate(post.date)}</time></div><h3 class="text-[1.375rem] font-medium mt-3 group-hover:text-primary-600">{post.title}</h3><p class="text-sm text-base-600 mt-3">{post.description}</p><span class="blog-read-button text-sm font-medium mt-3">Đọc bài viết →</span></div></a></article>)}
    </div>
    <p data-blog-empty hidden class="text-base-600 py-10 text-center">Chưa có bài viết phù hợp. Chọn chuyên mục khác hoặc đặt lại bộ lọc.</p>
  </div></section>
</BaseLayout>
<script>
  const root = document.querySelector<HTMLElement>("[data-blog-browser]")!;
  const filter = root.querySelector<HTMLSelectElement>("[data-blog-filter]")!;
  const cards = [...root.querySelectorAll<HTMLElement>("[data-blog-card]")];
  const reset = root.querySelector<HTMLButtonElement>("[data-blog-reset]")!;
  const update = (save = true) => {
    let count = 0;
    for (const card of cards) {
      card.hidden = filter.value !== "all" && card.dataset.category !== filter.value;
      if (!card.hidden) count++;
    }
    root.querySelector<HTMLElement>("[data-blog-status]")!.textContent = `${count} / ${cards.length} bài viết`;
    root.querySelector<HTMLElement>("[data-blog-empty]")!.hidden = count > 0;
    reset.hidden = filter.value === "all";
    if (save) {
      const url = new URL(location.href);
      if (filter.value !== "all") url.searchParams.set("chuyen-muc", filter.value); else url.searchParams.delete("chuyen-muc");
      url.searchParams.delete("q");
      history.replaceState(null, "", url.pathname + url.search + url.hash);
    }
  };
  const restore = () => {
    const category = new URLSearchParams(location.search).get("chuyen-muc");
    filter.value = [...filter.options].some(option => option.value === category) ? category! : "all";
    update(false);
  };
  filter.addEventListener("change", () => update());
  reset.addEventListener("click", () => { filter.value = "all"; update(); filter.focus(); });
  window.addEventListener("popstate", restore);
  restore();
</script>
<style>
  #bai-viet { scroll-margin-top: 6rem; }
  .blog-toolbar { display: flex; align-items: end; justify-content: space-between; gap: 1.25rem; margin-bottom: 1.5rem; }
  .blog-filter { display: flex; flex-direction: column; gap: .5rem; width: min(100%,22rem); flex-shrink: 0; }
  .blog-filter > span { font-size: .625rem; letter-spacing: .1em; font-weight: 600; color: var(--muted); }
  .blog-filter select { width: 100%; min-height: 48px; padding: .75rem 2.5rem .75rem 1rem; border: 1px solid rgb(var(--pearl-rgb) / .65); border-radius: 12px; background-color: var(--surface-soft); color: var(--navy); font-size: .9375rem; cursor: pointer; }
  .blog-filter select:focus-visible { outline: 2px solid var(--navy); outline-offset: 3px; }
  .blog-read-button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: .625rem 1.25rem; border: 1px solid var(--navy); border-radius: 999px; background: transparent; color: var(--navy); transition: border-color 160ms, color 160ms; }
  a:hover .blog-read-button, a:focus-visible .blog-read-button { background: transparent; border-color: #876a37; color: #876a37; }
  .blog-results-meta { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin: .5rem 0 1.5rem; font-size: .75rem; color: var(--muted); }
  .blog-results-meta button { min-height: 2.75rem; color: var(--navy); padding: .5rem .875rem; border: 1px solid var(--navy); border-radius: 999px; background: transparent; }
  .blog-category-badge { display: inline-block; border-radius: 999px; background: var(--surface-soft); color: var(--navy); padding: .375rem .75rem; font-size: .6875rem; font-weight: 600; }
  [data-blog-card][hidden], [data-blog-empty][hidden], [data-blog-reset][hidden] { display: none; }
  @media(max-width: 767px) { .blog-toolbar { flex-direction: column; align-items: stretch; gap: 1rem; margin-bottom: .875rem; } .blog-filter { width: 100%; } .blog-results-meta { margin-bottom: 1rem; } }
</style>
