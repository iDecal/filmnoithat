---
import type { GetStaticPaths } from "astro";
import { blogCategory } from "../../data/blogCategories";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MaterialCards from "../../components/MaterialCards.astro";
import { posts, postHref, formatDate, type Post } from "../../data/posts";
import { findMaterials } from "../../data/materials";
import { services, serviceHref } from "../../data/services";
import { site } from "../../data/site";
import { breadcrumbSchema } from "../../data/seo";
export const getStaticPaths = (() => posts.map(post => ({ params: { slug: post.slug }, props: { post } }))) satisfies GetStaticPaths;
interface Props { post: Post }
const { post } = Astro.props;
const relatedPosts = posts.filter(item => item.slug !== post.slug).sort((a,b) => Number(b.services.some(slug => post.services.includes(slug))) - Number(a.services.some(slug => post.services.includes(slug)))).slice(0,4);
const relatedServices = services.filter(service => post.services.includes(service.slug));
const schema = [
  {
    "@context": "https://schema.org", "@type": "BlogPosting", headline: post.title, description: post.description,
    datePublished: post.date, image: new URL(post.image, Astro.site).href,
    author: { "@type": "Organization", name: "Film Nội Thất", url: new URL("/gioi-thieu/", Astro.site).href },
    publisher: { "@type": "Organization", name: site.name, url: Astro.site!.href },
    mainEntityOfPage: { "@type": "WebPage", "@id": new URL(postHref(post), Astro.site).href },
  },
  breadcrumbSchema(Astro.site!, [{ name: "Kiến thức nội thất", path: "/blog/" }, { name: post.title, path: postHref(post) }]),
];
---
<BaseLayout faqs={post.faqs || []} title={post.title} description={post.description} image={post.image} pageType="article" structuredData={schema}>
  <article>
    <header style={{ "--hero-image": `url("${post.image}")` }} class="editorial-hero px-4 sm:px-6 section-space bg-base-50 surface-gradient"><div class="max-w-4xl mx-auto"><Breadcrumbs items={[{ label: "Kiến thức nội thất", href: "/blog/" }, { label: post.title }]} /><a class="eyebrow inline-flex items-center min-h-11 mb-4" href={`/blog/?chuyen-muc=${blogCategory(post.category).value}#bai-viet`}>{blogCategory(post.category).label}</a><h1 class="text-[1.75rem] md:text-4xl font-medium">{post.title}</h1><p class="text-sm text-base-600 mt-5">Biên soạn: Film Nội Thất · <time datetime={post.date}>{formatDate(post.date)}</time></p><p class="mt-7 text-lg text-base-600">{post.intro}</p><figure class="mt-8"><img src={post.image} alt={post.imageAlt || post.title} title={post.imageTitle || post.title} class="w-full aspect-[16/9] object-cover rounded-2xl" width={post.imageWidth || 1000} height={post.imageHeight || 563} fetchpriority="high" /><figcaption class="text-xs text-base-600 mt-3">{post.imageCaption || "Ảnh tham khảo chất liệu và không gian nội thất."}</figcaption></figure></div></header>
    <div class="px-4 sm:px-6 section-space bg-white"><div class="max-w-4xl mx-auto">
      <nav aria-label="Mục lục bài viết" class="bg-base-50 border border-base-200 rounded-2xl p-6 mb-10"><h2 class="text-xl font-semibold mb-4">Trong bài viết này</h2><ol class="space-y-3">{post.sections.map(section => <li><a href={`#${section.id}`} class="text-primary-600 hover:underline">{section.title}</a></li>)}</ol></nav>
      <div class="space-y-10">{post.sections.map(section => <section id={section.id} class="scroll-mt-28"><h2 class="text-2xl font-semibold mb-5">{section.title}</h2><div class="space-y-5 text-base-600 leading-relaxed">{section.paragraphs.map(text => <p>{text}</p>)}{section.image && <figure class="py-3"><img src={section.image.src} alt={section.image.alt} title={section.image.title || section.image.caption} width={section.image.width} height={section.image.height} loading="lazy" decoding="async" class="w-full h-auto rounded-xl" /><figcaption class="text-sm text-base-500 mt-3">{section.image.caption}</figcaption></figure>}{section.subsections?.map(subsection => <div class="pt-2"><h3 class="text-lg font-semibold text-base-900 mb-3">{subsection.title}</h3><div class="space-y-4">{subsection.paragraphs.map(text => <p>{text}</p>)}</div></div>)}{section.bullets && <ul class="list-disc pl-6 space-y-3">{section.bullets.map(text => <li>{text}</li>)}</ul>}{section.links && <ul class="space-y-2 pt-2">{section.links.map(link => <li><a href={link.href} class="text-primary-600 underline underline-offset-4 inline-flex min-h-11 items-center">{link.label} →</a></li>)}</ul>}</div></section>)}</div>
      {post.faqs && <section class="mt-12" aria-labelledby="article-faq-title"><h2 id="article-faq-title" class="text-2xl font-semibold mb-5">{post.focusKeyword === "dán film tủ bếp" ? "Câu hỏi thường gặp về dán film tủ bếp" : "Câu hỏi thường gặp về film dán nội thất"}</h2><div class="space-y-3">{post.faqs.map(faq => <details class="rounded-xl border border-base-200 p-5"><summary class="font-medium cursor-pointer">{faq.question}</summary><p class="text-base-600 leading-relaxed mt-4">{faq.answer}</p></details>)}</div></section>}
      <aside class="mt-12 p-6 border border-base-200 rounded-2xl bg-base-50"><h2 class="text-[1.375rem] font-semibold mb-4">Bạn đang chuẩn bị thi công?</h2><p class="text-base-600">Mỗi nền và mã film có điều kiện sử dụng riêng. Gửi ảnh hiện trạng để được tư vấn, xem mẫu và xác nhận phạm vi trước khi quyết định.</p><ul class="space-y-3 mt-5">{relatedServices.map(service => <li><a href={serviceHref(service)} class="text-primary-600 hover:underline">{service.name} →</a></li>)}</ul><a href={site.zaloHref} class="button-primary mt-6">Trao đổi qua Zalo</a></aside>
    </div></div>
  </article>
  <MaterialCards materials={findMaterials(post.materials)} title="Chất liệu được nhắc đến" />
  <section class="px-4 sm:px-6 section-space bg-white"><div class="max-w-4xl mx-auto"><h2 class="text-2xl font-semibold mb-6">Đọc tiếp</h2><ul class="space-y-4">{relatedPosts.map(item => <li><a href={postHref(item)} class="text-primary-600 hover:underline">{item.title} →</a></li>)}</ul></div></section>
</BaseLayout>
