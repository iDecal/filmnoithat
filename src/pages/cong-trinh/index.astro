---
import Icon from "../../components/Icon.astro";
import { projectConcepts } from "../../data/projectConcepts";
import pageContent from "../../data/pageContent.json";
import { projectStories, storyHref, storyLabel } from "../../data/projectStories";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FilterGallery from "../../components/FilterGallery.astro";
import { catalogue, sampleHref } from "../../data/catalogue";
import { materials } from "../../data/materials";
import { spaces } from "../../data/spaces";
import { breadcrumbSchema } from "../../data/seo";
const projectCards = projectStories.filter(story => story.kind !== "catalogue").map(story => {
  const concept = projectConcepts.find(item => item.slug === story.slug);
  const index = Number(story.slug.match(/^khong-gian-tham-khao-(\d+)$/)?.[1]) - 1;
  return { story, category: concept?.category || spaces[index]?.category || "commercial", label: concept ? "PHƯƠNG ÁN MINH HỌA" : storyLabel(story) };
});
projectCards.sort((first, second) => Number(second.category === "office") - Number(first.category === "office"));
const applications = projectStories.flatMap(story => {
  if (story.kind !== "catalogue") return [];
  const sample = catalogue.find(item => item.slug === story.sampleSlugs[0]);
  return sample ? [{ story, sample }] : [];
});
const applicationFilters = [
  { label: "Tất cả vật liệu", value: "all" },
  ...materials.filter(material => applications.some(({ sample }) => sample.category === material.slug))
    .map(material => ({ label: material.shortName, value: material.slug })),
];
const featured = projectCards.find(({ category }) => category === "office") ?? projectCards[0];
const filters = [{ label: "Tất cả không gian", value: "all" }, { label: "Văn phòng", value: "office" }, { label: "Nhà ở", value: "home" }, { label: "Không gian chung", value: "commercial" }];
---
<BaseLayout title={pageContent.projects.title} description={pageContent.projects.description} structuredData={[breadcrumbSchema(Astro.site!, [{ name: "Công trình & ứng dụng", path: "/cong-trinh/" }])]}>
  <section class="application-hero">
    <div class="projects-wrap">
      <Breadcrumbs items={[{ label: "Công trình & ứng dụng" }]} />
      <div class="application-hero-grid">
        <div class="application-hero-copy">
          <h1>Công trình<br />& ứng dụng</h1>
          <p>Khám phá cách dùng film nội thất trong văn phòng, nhà ở và không gian chung.</p>
          <nav aria-label="Nội dung trang" class="flex flex-wrap gap-3">
            <a href="#cong-trinh" class="button-primary">Xem công trình</a>
            <a href="#ung-dung-vat-lieu" class="button-secondary">Xem phối cảnh vật liệu</a>
          </nav>
        </div>
        {featured && <figure class="application-feature">
          <a href={storyHref(featured.story)}><img src={featured.story.images[0].src} alt={featured.story.images[0].alt} width="1000" height="650" fetchpriority="high" /></a>
          <figcaption><span>{featured.story.title}</span><a href={storyHref(featured.story)}>Xem chi tiết <Icon name="arrow" size={16} /></a></figcaption>
        </figure>}
      </div>
    </div>
  </section>
  <section id="cong-trinh" class="projects-section"><div class="projects-wrap"><header class="projects-heading"><div><p class="eyebrow mb-3">KHÁM PHÁ TỪNG KHÔNG GIAN</p><h2>Công trình & ý tưởng theo không gian</h2></div><p>Mỗi mẫu có trang chi tiết riêng với hướng phối và nhóm vật liệu gợi ý. Phương án minh họa được ghi rõ để bạn phân biệt với hồ sơ công trình thực tế. <a href="/du-an/" class="font-semibold underline">Cách chuẩn bị dự án</a></p></header><FilterGallery filters={filters} noun="không gian"><span slot="count">{projectCards.length} không gian</span><div class="projects-grid">{projectCards.map(({story,category,label})=><article data-filter-card={category}><a href={storyHref(story)} class="project-card"><div class="project-card-photo"><img src={story.images[0].src} alt={story.images[0].alt} width="1000" height="700" loading="lazy" /><span>{label}</span></div><div class="project-card-copy"><h3>{story.title}</h3><p>{story.description}</p><span class="project-card-action">Xem công trình chi tiết<Icon name="arrow" size={18} /></span></div></a></article>)}</div></FilterGallery></div></section>
  <section id="ung-dung-vat-lieu" class="projects-section projects-applications">
    <div class="projects-wrap">
      <header class="projects-heading"><h2>Phối cảnh theo vật liệu</h2><a href="/vat-lieu/" class="outline-action">Xem danh mục vật liệu <Icon name="arrow" size={17} /></a></header>
      <FilterGallery filters={applicationFilters} noun="phối cảnh">
        <span slot="count">{applications.length} phối cảnh</span>
        <div class="projects-application-grid">
          {applications.map(({ story, sample }) => (
            <article class="application-story-card" data-filter-card={sample.category}>
              <a class="application-photo" href={storyHref(story)} aria-label={story.title}>
                <img src={story.images[0].src} alt={story.images[0].alt} width="800" height="600" loading="lazy" />
              </a>
              <div class="application-card-copy">
                <p>{sample.brand} · {sample.code}</p>
                <h3><a href={storyHref(story)}>{sample.title}</a></h3>
                <a class="application-product" href={sampleHref(sample)}>Xem mẫu film <Icon name="arrow" size={16} /></a>
              </div>
            </article>
          ))}
        </div>
      </FilterGallery>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-wrap { width: min(1280px,calc(100% - 40px)); margin-inline: auto; }
  .projects-section { padding-block: clamp(3rem,6vw,5rem); }
  .projects-heading { display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 2rem; }
  .projects-heading h2 { font-size: 1.5rem; line-height: 1.35; font-weight: 500; }
  .projects-heading > p { max-width: 28rem; font-size: .875rem; line-height: 1.8; color: var(--muted); }
  .projects-grid { display: grid; gap: 1.75rem; }
  .projects-grid article { min-width: 0; }
  .project-card { height: 100%; display: flex; flex-direction: column; overflow: hidden; border-radius: 18px; background: var(--surface-soft); }
  .project-card-photo { position: relative; overflow: hidden; }
  .project-card-photo img { width: 100%; aspect-ratio: 3/2; object-fit: cover; transition: transform 200ms; }
  .project-card:hover img { transform: scale(1.025); }
  .project-card-photo > span { position: absolute; left: 1rem; bottom: 1rem; max-width: calc(100% - 2rem); padding: .375rem .625rem; border-radius: 7px; background: rgb(255 255 255 / .94); color: var(--navy); font-size: .625rem; font-weight: 600; }
  .project-card-copy { display: flex; flex-direction: column; flex: 1; padding: 1.5rem; }
  .project-card-copy h3 { font-size: 1.25rem; font-weight: 500; line-height: 1.4; }
  .project-card-copy p { margin-top: .75rem; color: var(--muted); font-size: .875rem; line-height: 1.8; }
  .project-card-action { display: flex; justify-content: space-between; align-items: center; gap: .75rem; padding-top: 1.25rem; margin-top: auto; min-height: 44px; font-size: .8125rem; font-weight: 500; }
  .application-hero { padding-block: 2rem clamp(3rem, 6vw, 5rem); background: var(--ivory); }
  .application-hero-grid { display: grid; gap: 2rem; align-items: center; }
  .application-hero-copy h1 { color: var(--navy); font-size: clamp(3rem, 7vw, 6.5rem); line-height: .98; letter-spacing: -.045em; font-weight: 600; }
  .application-hero-copy p { max-width: 28rem; margin-block: 1.5rem; color: var(--muted); line-height: 1.7; }
  .application-feature { overflow: hidden; border-radius: 20px; background: var(--navy); color: var(--ivory); }
  .application-feature img { display: block; width: 100%; aspect-ratio: 3/2; object-fit: cover; }
  .application-feature figcaption { padding: .75rem 1rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .5rem 1rem; font-size: .875rem; font-weight: 600; }
  .application-feature figcaption a, .application-product { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; }
  .application-feature a:hover, .application-card-copy a:hover { text-decoration: underline; }
  .projects-applications { background: var(--surface-soft); }
  .projects-application-grid { display: grid; gap: 1.25rem; }
  .application-story-card { overflow: hidden; min-width: 0; background: white; border-radius: 16px; display: flex; flex-direction: column; }
  .application-photo { display: block; }
  .application-photo img { width: 100%; aspect-ratio: 3/2; object-fit: cover; }
  .application-card-copy { padding: 1rem 1.125rem .75rem; display: flex; flex-direction: column; flex: 1; }
  .application-card-copy p { font-size: .75rem; color: var(--muted); }
  .application-card-copy h3 { margin-block: .25rem .5rem; font-size: 1.125rem; font-weight: 600; }
  .application-product { margin-top: auto; align-self: start; font-size: .875rem; font-weight: 600; }
  #ung-dung-vat-lieu, #cong-trinh { scroll-margin-top: 6rem; }
  @media (min-width: 640px) {
    .projects-wrap { width: min(1280px, calc(100% - 48px)); }
    .projects-grid, .projects-application-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .application-hero-grid { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 3rem; }
    .projects-heading { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 3rem; }
    .projects-grid, .projects-application-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media(prefers-reduced-motion:reduce) { .project-card-photo img { transition: none; } }
</style>
