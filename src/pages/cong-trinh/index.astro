---
import pageContent from "../../data/pageContent.json";
import { projectStories, storyHref, storyLabel } from "../../data/projectStories";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FilterGallery from "../../components/FilterGallery.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { spaces } from "../../data/spaces";
import { breadcrumbSchema } from "../../data/seo";
const filters = [{ label: "Tất cả không gian", value: "all" }, { label: "Nhà ở", value: "home" }, { label: "Văn phòng", value: "office" }, { label: "Không gian chung", value: "commercial" }];
---
<BaseLayout title={pageContent.projects.title} description={pageContent.projects.description} structuredData={[breadcrumbSchema(Astro.site!, [{ name: "Công trình & ứng dụng", path: "/cong-trinh/" }])]}>
  <section class="px-4 sm:px-6 section-space bg-base-50 surface-gradient"><div class="max-w-7xl mx-auto"><Breadcrumbs items={[{ label: "Công trình & ứng dụng" }]} /><p class="eyebrow mb-4">THAM KHẢO TỪNG KHÔNG GIAN</p><h1 class="text-[1.75rem] sm:text-3xl lg:text-4xl font-medium max-w-3xl">{pageContent.projects.headingLead}<br /><span class="text-primary-500">{pageContent.projects.headingAccent}</span></h1><p class="text-lg text-base-600 mt-6 max-w-2xl">{pageContent.projects.intro}</p><a href="/du-an/" class="inline-block py-3 mt-4 text-primary-600 font-semibold hover:underline">Cách chuẩn bị một phương án thi công →</a></div></section>
  <section class="px-4 sm:px-6 section-space bg-white"><div class="max-w-7xl mx-auto"><FilterGallery filters={filters} noun="gợi ý không gian"><span slot="count">{spaces.length} gợi ý không gian</span><div class="grid md:grid-cols-2 gap-7">{spaces.map(space => <article data-filter-card={space.category} class="border border-base-200 rounded-2xl overflow-hidden"><img src={space.image} alt={space.title} class="w-full aspect-[16/10] object-cover" loading="lazy" width="900" height="563" /><div class="p-6 md:p-8"><p class="eyebrow text-xs mb-3">{space.label}</p><h2 class="text-2xl font-semibold">{space.title}</h2><p class="mt-4 text-base-600">{space.text}</p><div class="flex flex-wrap gap-x-6 gap-y-2 mt-5"><a href={space.service} class="text-primary-600 font-semibold py-2 hover:underline">Xem dịch vụ →</a><a href={space.material} class="text-base-600 py-2 hover:underline">Khám phá vật liệu</a></div></div></article>)}</div></FilterGallery></div></section>
  <section class="px-4 sm:px-6 section-space warm-surface"><div class="max-w-7xl mx-auto"><p class="eyebrow mb-3">XEM CHI TIẾT TỪNG KHÔNG GIAN</p><h2 class="text-2xl md:text-[1.875rem] font-semibold mb-7">Ảnh ứng dụng & vật liệu liên quan.</h2><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{projectStories.slice(0,6).map(story => <a href={storyHref(story)} class="group min-w-0"><img src={story.images[0].src} alt={story.images[0].alt} width="800" height="600" loading="lazy" class="w-full aspect-[4/3] object-cover rounded-xl" /><p class="text-xs text-accent-700 mt-4">{storyLabel(story)}</p><h3 class="text-lg font-medium mt-2 group-hover:text-primary-600">{story.title}</h3><span class="inline-flex items-center min-h-11 text-sm text-primary-600 mt-2">Xem chi tiết →</span></a>)}</div></div></section>
  <ContactCTA title="Bạn thích hướng phối nào?" text="Gửi ảnh không gian hoặc hình tham khảo bạn yêu thích. Cùng trao đổi cách ứng dụng phù hợp với nội thất và ngân sách dự kiến." />
</BaseLayout>
