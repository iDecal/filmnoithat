---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { projectStories, storyHref, storyLabel } from "../../data/projectStories";
import { catalogue, sampleHref, cataloguePdf } from "../../data/catalogue";
import { materials, materialHref } from "../../data/materials";
import { breadcrumbSchema } from "../../data/seo";
export function getStaticPaths() { return projectStories.map(story => ({params:{slug:story.slug},props:{story}})); }
const { story } = Astro.props;
const linkedSamples = catalogue.filter(sample => story.sampleSlugs.includes(sample.slug));
const linkedMaterials = materials.filter(material => story.categories.includes(material.slug));
const actual = story.kind === "completed";
---
<BaseLayout title={`${story.title} | Film Nội Thất`} description={story.description} image={story.images[0].src} structuredData={[breadcrumbSchema(Astro.site!, [{name:"Công trình",path:"/cong-trinh/"},{name:story.title,path:storyHref(story)}])]}>
  <section class="px-4 sm:px-6 section-space bg-base-50 surface-gradient"><div class="max-w-7xl mx-auto"><Breadcrumbs items={[{label:"Công trình",href:"/cong-trinh/"},{label:story.title}]} /><p class="eyebrow mb-4">{storyLabel(story)}</p><h1 class="text-[1.75rem] sm:text-3xl lg:text-4xl font-medium max-w-4xl">{story.title}</h1><p class="text-base-600 text-base sm:text-lg mt-5 max-w-3xl">{story.description}</p>{story.location && <p class="text-sm text-base-600 mt-4">Địa điểm: {story.location}</p>}{!actual && <p class="text-sm text-base-600 mt-5 max-w-3xl border-l-2 border-accent-300 pl-4">{story.kind === "catalogue" ? "Ảnh ứng dụng từ catalogue INFEEL 2026, không phải hồ sơ công trình do Film Nội Thất thi công." : "Hình ảnh tham khảo cách phối không gian. Chưa có xác nhận mã film hoặc hồ sơ thi công cho ảnh này."}</p>}</div></section>
  <section class="px-4 sm:px-6 section-space bg-white"><div class="max-w-6xl mx-auto space-y-8">{story.images.map((photo,index) => <figure><img src={photo.src} alt={photo.alt} width="1100" height="750" loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} class="w-full max-h-[48rem] object-contain bg-base-50 rounded-xl" /><figcaption class="text-sm text-base-600 mt-3">{photo.alt}</figcaption></figure>)}</div></section>
  {actual && story.scope.length > 0 && <section class="px-4 sm:px-6 section-space warm-surface"><div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-8"><div><h2 class="text-2xl font-semibold mb-5">Hạng mục thực hiện</h2><ul class="list-disc pl-5 space-y-3 text-base-600">{story.scope.map(item => <li>{item}</li>)}</ul></div><div><h2 class="text-2xl font-semibold mb-5">Vật liệu sử dụng</h2><ul class="list-disc pl-5 space-y-3 text-base-600">{story.materials.map(item => <li>{item}</li>)}</ul></div></div></section>}
  <section class="px-4 sm:px-6 section-space warm-surface"><div class="max-w-7xl mx-auto"><h2 class="text-2xl md:text-[1.875rem] font-semibold mb-6">{actual ? "Mẫu film trong công trình" : story.kind === "catalogue" ? "Mẫu được minh họa trong catalogue" : "Khám phá nhóm vật liệu liên quan"}</h2>{linkedSamples.length > 0 ? <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">{linkedSamples.map(sample => <a href={sampleHref(sample)} class="block min-w-0 group"><img src={sample.image} alt={`${sample.title} ${sample.code}`} width={sample.imageWidth} height={sample.imageHeight} loading="lazy" class="w-full aspect-[4/3] object-cover rounded-xl border border-base-200" /><h3 class="text-base font-medium mt-4 group-hover:text-primary-600">{sample.title}</h3><p class="text-sm text-primary-600 font-semibold mt-2">{sample.code}</p><span class="inline-flex items-center min-h-11 text-sm text-primary-600">Xem mẫu & tư vấn →</span></a>)}</div> : <p class="text-base-600">Mẫu và phương án cụ thể được chọn sau khi xem hiện trạng, ánh sáng và nhu cầu sử dụng.</p>}<div class="flex flex-wrap gap-x-6 gap-y-2 mt-6">{linkedMaterials.map(material => <a href={`${materialHref(material)}#mau-vat-lieu`} class="inline-flex items-center min-h-11 text-primary-600 text-sm font-medium hover:underline">Xem bộ sưu tập {material.shortName.toLowerCase()} →</a>)}</div>{story.sourcePage && <a href={`${cataloguePdf}#page=${story.sourcePage}`} class="inline-flex items-center min-h-11 text-sm text-primary-600 font-medium mt-3 hover:underline">Đối chiếu catalogue gốc ↗</a>}</div></section>
  <ContactCTA title="Bạn muốn ứng dụng cho không gian của mình?" text="Gửi ảnh hiện trạng, kích thước, địa điểm và mẫu yêu thích để trao đổi cách phối vật liệu, phạm vi thi công và chi phí dự kiến." />
</BaseLayout>
