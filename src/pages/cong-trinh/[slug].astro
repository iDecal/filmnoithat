---
import ProjectDetailLayout from "../../components/ProjectDetailLayout.astro";
import ApplicationStoryLayout from "../../components/ApplicationStoryLayout.astro";
import { projectConcepts } from "../../data/projectConcepts";
import { projectStories } from "../../data/projectStories";

export function getStaticPaths() {
  return projectStories.map(story => ({ params: { slug: story.slug }, props: { story } }));
}
const { story } = Astro.props;
const concept = projectConcepts.find(item => item.slug === story.slug);
---
{story.kind === "catalogue" ? <ApplicationStoryLayout story={story} /> : <ProjectDetailLayout story={story} concept={concept} />}
