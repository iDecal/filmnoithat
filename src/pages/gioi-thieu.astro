---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { breadcrumbSchema } from "../data/seo";
const principles = [
  { title: "Hiểu bề mặt trước khi tư vấn", text: "Xem hiện trạng, công năng và những phần cần xử lý để chọn phương án phù hợp, thay vì bắt đầu bằng một mẫu film bất kỳ." },
  { title: "Xem mẫu, chốt rõ phạm vi", text: "Trao đổi mã vật liệu, cách phối màu, mối nối, tháo lắp và phần việc trong báo giá trước khi thi công." },
  { title: "Quan tâm đến lúc sử dụng", text: "Cùng kiểm tra phần hoàn thiện và cách chăm sóc theo vật liệu, để bạn biết cần lưu ý gì trong quá trình sử dụng." },
];
---
<BaseLayout title="Giới thiệu iDecal: vật liệu & thi công film nội thất" description="Tìm hiểu cách iDecal tư vấn vật liệu và thi công film nội thất: khảo sát bề mặt, chọn mẫu, thống nhất phạm vi và hướng dẫn chăm sóc sau hoàn thiện." structuredData={[breadcrumbSchema(Astro.site!, [{ name: "Giới thiệu", path: "/gioi-thieu/" }])]}>
  <section class="px-4 sm:px-6 section-space bg-base-50 surface-gradient"><div class="max-w-7xl mx-auto"><Breadcrumbs items={[{ label: "Giới thiệu" }]} /><div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center"><div><p class="eyebrow mb-4">FILM NỘI THẤT CÙNG iDECAL</p><h1 class="text-[1.75rem] sm:text-3xl lg:text-4xl font-medium">Giữ điều còn tốt.<br /><span class="text-primary-500">Làm mới điều bạn thích.</span></h1><p class="text-lg text-base-600 mt-6">Chúng tôi cung cấp film trang trí và tư vấn thi công cho những bề mặt nội thất cần một diện mạo mới. Từ chọn chất liệu đến bàn giao, mỗi bước bắt đầu bằng việc hiểu không gian và nhu cầu sử dụng.</p><a href="/dich-vu/dan-film-noi-that/" class="button-primary mt-7">Khám phá dịch vụ</a></div><figure class="rounded-3xl overflow-hidden bg-white border border-base-200"><img src="/images/blog/film-dan-noi-that-van-go.jpg" alt="Không gian nội thất tham khảo với tông gỗ và màu sáng" class="w-full aspect-[5/4] object-cover" width="900" height="720" fetchpriority="high" /><figcaption class="px-6 py-4 text-sm text-base-600">Chọn vật liệu để hòa vào không gian, thay vì chỉ thay một màu mới.</figcaption></figure></div></div></section>
  <section class="px-4 sm:px-6 section-space bg-white"><div class="max-w-7xl mx-auto grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] gap-8 lg:gap-16"><h2 class="text-[1.375rem] md:text-2xl font-medium">Một lớp hoàn thiện.<br />Nhiều điều cần cân nhắc.</h2><div class="space-y-5 text-base-600 text-lg"><p>Film có thể thay đổi màu và họa tiết trên bàn, tủ hoặc vách còn ổn định. Nhưng kết quả không chỉ phụ thuộc vào ảnh mẫu: độ phẳng, độ ẩm, ánh sáng và thói quen sử dụng đều cần được xem xét.</p><p>Vì vậy, cách làm việc của iDecal tập trung vào trao đổi hiện trạng, so mẫu và làm rõ phạm vi. Nếu bề mặt cần sửa hoặc phương án khác phù hợp hơn, điều đó nên được xác định trước khi thi công.</p></div></div></section>
  <section class="px-4 sm:px-6 section-space bg-base-50"><div class="max-w-7xl mx-auto"><p class="eyebrow mb-3">CÁCH CHÚNG TÔI TIẾP CẬN</p><h2 class="text-[1.375rem] md:text-2xl font-medium mb-6">Rõ ràng để dễ cùng quyết định.</h2><div class="grid md:grid-cols-3 gap-6">{principles.map((item, index) => <article class="border-t border-base-300 pt-6 pb-2"><span class="text-primary-600 font-semibold">0{index + 1}</span><h3 class="text-lg font-semibold mt-4 mb-4">{item.title}</h3><p class="text-base-600">{item.text}</p></article>)}</div></div></section>
  <section class="px-4 sm:px-6 section-space bg-white"><div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-6"><a href="/vat-lieu/" class="rounded-2xl bg-base-50 border border-base-200 p-7 md:p-9 hover:border-primary-300 transition"><p class="eyebrow mb-4">BẠN ĐANG TÌM VẬT LIỆU?</p><h2 class="text-[1.375rem] font-medium">Chọn vân, chọn cảm giác.</h2><p class="text-base-600 mt-4">Khám phá gỗ, vải, bê tông, kim loại và các hướng phối cho nội thất.</p><span class="inline-block text-primary-600 font-semibold mt-6">Xem bộ sưu tập →</span></a><a href="/du-an/" class="rounded-2xl bg-base-50 border border-base-200 p-7 md:p-9 hover:border-primary-300 transition"><p class="eyebrow mb-4">BẠN ĐANG LÊN PHƯƠNG ÁN?</p><h2 class="text-[1.375rem] font-medium">Chuẩn bị trước khi thi công.</h2><p class="text-base-600 mt-4">Những thông tin cần có từ ảnh hiện trạng đến phạm vi công việc.</p><span class="inline-block text-primary-600 font-semibold mt-6">Xem cách chuẩn bị →</span></a></div></section>
  <ContactCTA />
</BaseLayout>
