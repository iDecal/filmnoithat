---
import ColorGuideFeature from "../../components/ColorGuideFeature.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MaterialCards from "../../components/MaterialCards.astro";
import Icon from "../../components/Icon.astro";
import { services, serviceHref } from "../../data/services";
import { getServiceLayout } from "../../data/serviceLayouts";
import { findMaterials } from "../../data/materials";
import { posts, postHref } from "../../data/posts";
import { breadcrumbSchema } from "../../data/seo";
import { site, internationalPhone } from "../../data/site";
const service = services.find(item => item.slug === "dan-film-noi-that")!;
const categories = services.filter(item => item.slug !== service.slug);
const relatedPosts = [...posts].reverse().filter(post => post.services.includes(service.slug)).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);
const schema = [breadcrumbSchema(Astro.site!, [{ name: "Dịch vụ", path: serviceHref(service) }]), {
  "@context": "https://schema.org", "@type": "Service", name: service.name, description: service.description,
  url: new URL(serviceHref(service), Astro.site).href,
  provider: { "@type": "Organization", name: site.name, url: Astro.site!.href, telephone: internationalPhone },
  areaServed: { "@type": "Country", name: "Việt Nam" },
}, { "@context": "https://schema.org", "@type": "ItemList", itemListElement: categories.map((item, index) => ({ "@type": "ListItem", position: index + 1, name: item.name, url: new URL(serviceHref(item), Astro.site).href })) }];
const preparation = [
  { title: "Cho biết nhu cầu", text: "Bạn muốn mua film dán nội thất, thuê thi công một hạng mục hay làm mới nhiều bề mặt? Gửi ảnh, kích thước và địa điểm để bắt đầu." },
  { title: "Chọn vật liệu & phạm vi", text: "So mẫu, kiểm tra nền và làm rõ phần dán, xử lý bề mặt, tháo lắp hoặc các chi tiết cần giữ nguyên." },
  { title: "Thống nhất trước khi làm", text: "Xác nhận vật tư, chi phí, phương án giao hàng hoặc lịch thi công và cách kiểm tra khi bàn giao." },
];
---
<BaseLayout faqs={service.faqs} title={service.title} description={service.description} image={service.image} structuredData={schema}>
  <div class="service-overview">
    <section class="editorial-hero px-4 sm:px-6 pt-6 sm:pt-10 pb-10 sm:pb-16 bg-base-50 surface-gradient">
      <div class="max-w-7xl mx-auto"><Breadcrumbs items={[{ label: "Dịch vụ" }]} />
        <div class="grid lg:grid-cols-[1fr_1.1fr] gap-8 lg:gap-16 items-center">
          <div><p class="eyebrow text-xs mb-4">VẬT LIỆU & THI CÔNG THEO NHU CẦU</p><h1 class="text-[1.75rem] sm:text-4xl lg:text-[2.75rem] font-medium leading-tight">Film dán nội thất.<br /><span class="text-primary-500">Làm mới từng bề mặt.</span></h1><p class="text-base sm:text-lg text-base-600 mt-5 max-w-lg">Chọn film dán nội thất cho tủ bếp, bàn, tường, trần hoặc thang máy. Từ một cánh tủ đến nhiều mảng trong cùng không gian, cùng tìm chất liệu và phương án thi công phù hợp.</p><div class="flex flex-wrap gap-3 mt-6"><a href="#chon-dich-vu" class="button-primary">Chọn dịch vụ <span aria-hidden="true" class="ml-2">↓</span></a><a href="/vat-lieu/" class="button-secondary">Tôi muốn mua film</a></div><p class="text-sm text-base-600 mt-5">Cung cấp film toàn quốc · Thi công theo địa điểm công trình</p></div>
          <figure><img src="/images/home/interior-kitchen.webp" alt="Film dán nội thất cho tủ bếp gỗ sáng — không gian tham khảo" width="810" height="543" fetchpriority="high" class="w-full aspect-[4/3] object-cover rounded-2xl" /><figcaption class="text-xs text-base-600 mt-3">Gợi ý phối vật liệu cho không gian sống.</figcaption></figure>
        </div>

      </div>
    </section>
    <div class="service-wrap service-shortcuts"><nav aria-label="Chọn nhanh hạng mục dịch vụ">{categories.map(item => <a href={serviceHref(item)}>{item.name}</a>)}</nav></div>

    <section id="chon-dich-vu" class="service-section overview-anchor" aria-labelledby="choose-service-title"><div class="service-wrap">
      <header class="service-section-heading"><div><p class="eyebrow mb-3">01 / CHỌN HẠNG MỤC</p><h2 id="choose-service-title" class="text-2xl md:text-[1.875rem] font-semibold">Làm mới từng góc không gian.</h2></div><p>Chọn bề mặt bạn muốn thay đổi. Xem cách ứng dụng, lưu ý thi công và mẫu vật liệu cho từng hạng mục.</p></header>
      <div class="service-card-grid">{categories.map((item,index) => <article class="service-category-card"><a href={serviceHref(item)} class="service-card-link"><div class="service-card-image"><img src={item.image} alt={item.imageAlt} width="1200" height="800" loading="lazy" decoding="async" /><span class="service-card-number">0{index+1}</span></div><div class="service-card-copy"><h3>{item.name}</h3><p>{getServiceLayout(item.slug).lead}</p><span class="service-card-action">Khám phá dịch vụ <Icon name="arrow" size={18} /></span></div></a></article>)}
        <article class="service-category-card"><a href="/vat-lieu/" class="service-card-link"><div class="service-card-image"><img src="/images/cong-trinh/banner-film-dan-noi-that.jpg" alt="Các cuộn film nội thất với nhiều sắc độ và hiệu ứng bề mặt" width="2560" height="1438" loading="lazy" decoding="async" /><span class="service-card-number">VẬT LIỆU</span></div><div class="service-card-copy"><h3>Chọn mẫu film của bạn</h3><p>Khám phá vân gỗ, vân đá, đơn sắc và hiệu ứng kim loại. Chọn mã mẫu phù hợp trước khi lên phương án thi công.</p><span class="service-card-action">Xem bộ sưu tập <Icon name="arrow" size={18} /></span></div></a></article>
      </div><p class="service-image-note">Phối cảnh minh họa ứng dụng. Màu sắc và bề mặt cần đối chiếu với mẫu film thực tế.</p>
    </div></section>

    <section id="blog-tu-van" class="service-section service-soft"><div class="service-wrap"><header class="service-section-heading"><div><p class="eyebrow mb-3">02 / THEO NHU CẦU CỦA BẠN</p><h2 class="text-2xl md:text-[1.875rem] font-semibold">Bắt đầu từ điều bạn cần.</h2></div><p>Từ mua vật liệu đến hoàn thiện bề mặt, cùng làm rõ nhu cầu để chọn bước tiếp theo phù hợp.</p></header>
      <div class="service-needs-grid"><article><span class="service-step">01</span><h3>Bạn cần mua film</h3><p>Đã có người thực hiện? Chọn mã mẫu, số lượng và xác nhận quy cách, giá vật tư cùng phương án giao hàng.</p><a href="/vat-lieu/" class="outline-action">Chọn vật liệu <Icon name="arrow" size={16} /></a></article><article><span class="service-step">02</span><h3>Bạn cần thi công</h3><p>Gửi ảnh, kích thước và địa điểm để trao đổi nền hiện trạng, chi tiết góc cạnh và phạm vi thực hiện.</p><a href={site.zaloHref} class="outline-action">Trao đổi phương án <Icon name="arrow" size={16} /></a></article><article><span class="service-step">03</span><h3>Bạn đang tìm ý tưởng</h3><p>Tham khảo cách phối chất liệu cho bàn, tủ và vách trước khi quyết định màu sắc hoặc nhóm bề mặt.</p><a href="/cong-trinh/" class="outline-action">Xem không gian <Icon name="arrow" size={16} /></a></article></div>
    </div></section>

    <ColorGuideFeature serviceSlug={service.slug} />
    <MaterialCards materials={findMaterials(["van-go", "da-cam-thach", "don-sac"])} title="Chất liệu phù hợp với không gian." />

    <section class="service-section"><div class="service-wrap"><header class="service-section-heading"><div><p class="eyebrow mb-3">03 / CÁCH CHÚNG TÔI BẮT ĐẦU</p><h2 class="text-2xl md:text-[1.875rem] font-semibold">Rõ nhu cầu. Rõ phương án.</h2></div><p>Film là lớp hoàn thiện. Nền ẩm, bong hoặc xuống cấp cần được đánh giá và xử lý trước khi dán.</p></header><ol class="service-process-grid">{preparation.map((item,index) => <li><span class="service-step">0{index+1}</span><h3>{item.title}</h3><p>{item.text}</p></li>)}</ol></div></section>

    <section id="blog-tu-van" class="service-section service-soft"><div class="service-wrap"><header class="service-section-heading"><div><p class="eyebrow mb-3">04 / CẨM NANG NỘI THẤT</p><h2 class="text-2xl md:text-[1.875rem] font-semibold">Đọc thêm trước khi chọn.</h2></div><a href="/blog/" class="outline-action">Tất cả bài tư vấn <Icon name="arrow" size={16} /></a></header><div class="service-post-grid">{relatedPosts.map(post => <article data-service-post><a href={postHref(post)}><img src={post.image} alt={post.imageAlt || post.title} width="800" height="500" loading="lazy" /><h3>{post.title}</h3><p>{post.description}</p><span class="service-card-action">Đọc bài tư vấn <Icon name="arrow" size={16} /></span></a></article>)}</div></div></section>
    <section class="service-section"><div class="service-wrap service-faq-layout"><div><p class="eyebrow mb-3">GIẢI ĐÁP TRƯỚC KHI LÀM</p><h2 class="text-2xl md:text-[1.875rem] font-semibold">Bạn muốn biết thêm?</h2><p class="text-base-600 mt-4">Một vài thông tin để chuẩn bị vật liệu và phạm vi thi công.</p></div><div>{service.faqs.map(faq => <details class="service-faq"><summary>{faq.question}<span aria-hidden="true">⌄</span></summary><p>{faq.answer}</p></details>)}</div></div></section>
  </div>
</BaseLayout>
<style>
  .service-overview { --color-base-200: 185 190 199; --color-base-300: 185 190 199; }
  .service-wrap { width: min(1280px,calc(100% - 40px)); margin-inline: auto; }
  .service-section { padding-block: clamp(3rem,6vw,5.5rem); }
  .service-soft { background: #f7f8f9; }
  .overview-anchor { scroll-margin-top: 6rem; }
  .service-shortcuts nav { display: flex; gap: .625rem; flex-wrap: wrap; padding-top: 2rem; }
  .service-shortcuts a { display: inline-flex; align-items: center; min-height: 44px; padding: .625rem 1rem; background: #f3f5f7; border-radius: 999px; font-size: .8125rem; color: var(--navy); }
  .service-shortcuts a:hover { background: var(--navy); color: white; }
  .service-section-heading { display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 2.25rem; }
  .service-section-heading > p { max-width: 26rem; font-size: .9375rem; color: var(--muted); }
  .service-card-grid, .service-needs-grid, .service-process-grid, .service-post-grid { display: grid; grid-template-columns: minmax(0,1fr); gap: 2rem; }
  .service-category-card { min-width: 0; }
  .service-card-link { height: 100%; display: flex; flex-direction: column; }
  .service-card-image { position: relative; overflow: hidden; border-radius: 18px; }
  .service-card-image img { width: 100%; aspect-ratio: 3/2; object-fit: cover; transition: transform 250ms; }
  .service-card-link:hover img { transform: scale(1.035); }
  .service-card-number { position: absolute; top: 1rem; left: 1rem; padding: .375rem .625rem; border-radius: 999px; background: rgb(255 255 255 / .9); font-size: .6875rem; font-weight: 600; }
  .service-card-copy { display: flex; flex-direction: column; flex: 1; padding: 1.375rem .125rem 0; }
  .service-card-copy h3, .service-needs-grid h3, .service-process-grid h3, .service-post-grid h3 { font-size: 1.25rem; font-weight: 500; line-height: 1.4; }
  .service-card-copy p, .service-needs-grid p, .service-process-grid p, .service-post-grid p { margin-top: .75rem; color: var(--muted); font-size: .875rem; line-height: 1.8; }
  .service-card-action { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding-top: 1.25rem; margin-top: auto; min-height: 48px; font-size: .8125rem; font-weight: 600; color: var(--navy); }
  .service-image-note { margin-top: 1.75rem; font-size: .75rem; color: var(--muted); }
  .service-needs-grid article { display: flex; flex-direction: column; align-items: flex-start; padding: 1.75rem; border-radius: 18px; background: white; }
  .service-step { display: block; margin-bottom: 1rem; font-size: .8125rem; color: var(--muted); }
  .service-needs-grid .outline-action { margin-top: 1.5rem; font-size: .8125rem; }
  .service-process-grid li { border-top: 1px solid rgb(var(--pearl-rgb) / .6); padding-top: 1.5rem; }
  .service-post-grid img { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: 16px; margin-bottom: 1.25rem; }
  .service-post-grid article, .service-post-grid article > a { display: flex; flex-direction: column; min-width: 0; height: 100%; }
  .service-faq-layout { display: grid; gap: 2rem; }
  .service-faq { border-bottom: 1px solid rgb(var(--pearl-rgb) / .6); }
  .service-faq summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.25rem; font-weight: 500; cursor: pointer; list-style: none; }
  .service-faq summary::-webkit-details-marker { display: none; }
  .service-faq[open] summary span { transform: rotate(180deg); }
  .service-faq p { padding-bottom: 1.25rem; color: var(--muted); font-size: .875rem; }
  .service-overview :global(.editorial-hero h1::after) { background: rgb(var(--pearl-rgb) / .7); }
  .service-overview :global(a:focus-visible), .service-overview :global(summary:focus-visible) { outline: 2px solid var(--navy); outline-offset: 4px; }
  @media(min-width:640px) { .service-wrap { width: min(1280px,calc(100% - 48px)); }.service-card-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media(min-width:1024px) {
    .service-section-heading { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 3rem; }
    .service-section-heading > div { max-width: 42rem; }
    .service-card-grid, .service-needs-grid, .service-process-grid, .service-post-grid { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 2.5rem 1.75rem; }
    .service-faq-layout { grid-template-columns: .8fr 1.2fr; gap: 5rem; }
  }
  @media(prefers-reduced-motion:reduce) { .service-card-image img { transition: none; } }
</style>
