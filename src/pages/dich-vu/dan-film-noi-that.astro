---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import MaterialCards from "../../components/MaterialCards.astro";
import Icon from "../../components/Icon.astro";
import { categoryIcon } from "../../data/icons";
import { services, serviceHref } from "../../data/services";
import { getServiceLayout } from "../../data/serviceLayouts";
import { findMaterials } from "../../data/materials";
import { posts, postHref } from "../../data/posts";
import { spaces } from "../../data/spaces";
import { breadcrumbSchema } from "../../data/seo";
import { site } from "../../data/site";
const service = services.find(item => item.slug === "dan-film-noi-that")!;
const categories = services.filter(item => item.slug !== service.slug);
const schema = [breadcrumbSchema(Astro.site!, [{ name: "Dịch vụ", path: serviceHref(service) }]), {
  "@context": "https://schema.org", "@type": "Service", name: service.name, description: service.description,
  url: new URL(serviceHref(service), Astro.site).href,
  provider: { "@type": "Organization", name: site.name, url: Astro.site!.href, telephone: "+84866077040" },
  areaServed: { "@type": "Country", name: "Việt Nam" },
}, { "@context": "https://schema.org", "@type": "ItemList", itemListElement: categories.map((item, index) => ({ "@type": "ListItem", position: index + 1, name: item.name, url: new URL(serviceHref(item), Astro.site).href })) }];
const preparation = [
  { title: "Cho biết nhu cầu", text: "Bạn muốn mua film dán nội thất, thuê thi công một hạng mục hay làm mới nhiều bề mặt? Gửi ảnh, kích thước và địa điểm để bắt đầu." },
  { title: "Chọn vật liệu & phạm vi", text: "So mẫu, kiểm tra nền và làm rõ phần dán, xử lý bề mặt, tháo lắp hoặc các chi tiết cần giữ nguyên." },
  { title: "Thống nhất trước khi làm", text: "Xác nhận vật tư, chi phí, phương án giao hàng hoặc lịch thi công và cách kiểm tra khi bàn giao." },
];
---
<BaseLayout faqs={service.faqs} title={service.title} description={service.description} image="/images/home/interior-kitchen.webp" structuredData={schema}>
  <div class="service-overview">
    <section class="px-4 sm:px-6 pt-6 sm:pt-10 pb-10 sm:pb-16 bg-base-50 surface-gradient">
      <div class="max-w-7xl mx-auto"><Breadcrumbs items={[{ label: "Dịch vụ" }]} />
        <div class="grid lg:grid-cols-[1fr_1.1fr] gap-8 lg:gap-16 items-center">
          <div><p class="eyebrow text-xs mb-4">VẬT LIỆU & THI CÔNG THEO NHU CẦU</p><h1 class="text-[1.75rem] sm:text-4xl lg:text-[2.75rem] font-medium leading-tight">Film dán nội thất.<br /><span class="text-primary-500">Làm mới từng bề mặt.</span></h1><p class="text-base sm:text-lg text-base-600 mt-5 max-w-lg">Chọn film dán nội thất cho tủ bếp, bàn, tường, trần hoặc thang máy. Từ một cánh tủ đến nhiều mảng trong cùng không gian, cùng tìm chất liệu và phương án thi công phù hợp.</p><div class="flex flex-wrap gap-3 mt-6"><a href="#chon-dich-vu" class="button-primary">Chọn dịch vụ <span aria-hidden="true" class="ml-2">↓</span></a><a href="/vat-lieu/" class="button-secondary">Tôi muốn mua film</a></div><p class="text-sm text-base-600 mt-5">Cung cấp film toàn quốc · Thi công theo địa điểm công trình</p></div>
          <figure><img src="/images/home/interior-kitchen.webp" alt="Film dán nội thất cho tủ bếp gỗ sáng — không gian tham khảo" width="810" height="543" fetchpriority="high" class="w-full aspect-[4/3] object-cover rounded-2xl" /><figcaption class="text-xs text-base-600 mt-3">Gợi ý phối vật liệu cho không gian sống.</figcaption></figure>
        </div>
        <nav aria-label="Chọn nhanh hạng mục dịch vụ" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-5 gap-y-1 mt-8 pt-4 border-t border-base-200">{categories.map(item => <a href={serviceHref(item)} class="inline-flex items-center gap-2 py-3 min-h-11 text-sm font-medium hover:text-primary-600"><Icon name={categoryIcon(item.slug)!} size={20} /><span>{item.name}</span></a>)}</nav>
      </div>
    </section>

    <section id="chon-dich-vu" class="overview-anchor px-4 sm:px-6 section-space bg-white" aria-labelledby="choose-service-title"><div class="max-w-7xl mx-auto">
      <div class="max-w-2xl mb-8"><p class="eyebrow mb-4">01 / CHỌN HẠNG MỤC</p><h2 id="choose-service-title" class="text-2xl md:text-[1.875rem] font-semibold">Ứng dụng film dán nội thất theo từng hạng mục.</h2><p class="text-base-600 mt-4">Xem lưu ý, mẫu film và hình ảnh theo từng dịch vụ trước khi trao đổi chi tiết.</p></div>
      <div class="grid md:grid-cols-2 gap-7 lg:gap-10">{categories.map((item, index) => <article class:list={["min-w-0 border-t border-base-200 pt-5", index === 0 && "md:col-span-2"]}><a href={serviceHref(item)} class:list={["group grid gap-5", index === 0 && "md:grid-cols-2 md:gap-8 md:items-center"]}><img src={item.slug === "dan-film-tran" ? spaces[3].image : item.image} alt={`Không gian tham khảo cho ${item.name.toLowerCase()}`} width="900" height="600" loading="lazy" class="w-full aspect-[3/2] object-cover rounded-xl" /><div><p class="text-xs text-base-600 mb-3">0{index + 1} / <span>ẢNH THAM KHẢO</span></p><h3 class="flex items-center gap-3 text-xl sm:text-2xl font-medium group-hover:text-primary-600"><Icon name={categoryIcon(item.slug)!} size={24} />{item.heading}</h3><p class="text-sm sm:text-base text-base-600 mt-4">{getServiceLayout(item.slug).lead}</p><span class="inline-flex items-center min-h-11 text-sm font-semibold text-primary-600 mt-3 group-hover:underline">Tìm hiểu dịch vụ →</span></div></a></article>)}</div>
    </div></section>

    <section class="px-4 sm:px-6 section-space bg-base-900 ink-gradient text-white"><div class="max-w-7xl mx-auto"><p class="text-xs text-accent-200 font-semibold tracking-widest mb-4">02 / CHỌN THEO NHU CẦU</p><h2 class="text-white text-2xl md:text-[1.875rem] font-semibold">Mua film dán nội thất hay cần thi công?</h2><div class="grid md:grid-cols-2 gap-8 lg:gap-16 mt-8"><div class="border-t border-white/20 pt-6"><h3 class="text-white text-xl font-medium">Bạn đã có người thực hiện.</h3><p class="text-white/80 mt-4">Chọn nhóm vật liệu, trao đổi mẫu, số lượng và địa điểm nhận hàng. Khổ film, lượng dư và tình trạng cung cấp được xác nhận trước khi đặt.</p><a href="/vat-lieu/" class="inline-flex items-center min-h-11 text-accent-200 font-semibold text-sm mt-4 hover:underline">Chọn vật liệu →</a></div><div class="border-t border-white/20 pt-6"><h3 class="text-white text-xl font-medium">Bạn muốn được hỗ trợ thi công.</h3><p class="text-white/80 mt-4">Gửi hiện trạng để trao đổi khả năng dán, xử lý nền và phạm vi công việc. Chi phí và lịch thực hiện được thống nhất theo từng công trình.</p><a href={site.zaloHref} class="inline-flex items-center min-h-11 text-accent-200 font-semibold text-sm mt-4 hover:underline">Trao đổi phương án →</a></div></div></div></section>

    <MaterialCards materials={findMaterials(["van-go", "don-sac", "be-tong", "kim-loai"])} title="Chọn chất liệu cho ý tưởng của bạn." />


    <section class="px-4 sm:px-6 section-space bg-base-50"><div class="max-w-7xl mx-auto grid lg:grid-cols-[0.8fr_1.4fr] gap-8 lg:gap-16"><div><p class="eyebrow mb-4">03 / CHUẨN BỊ ĐỂ BẮT ĐẦU</p><h2 class="text-2xl md:text-[1.875rem] font-semibold">Rõ nhu cầu.<br />Dễ chọn phương án.</h2><p class="text-base-600 mt-4">Film là lớp hoàn thiện. Nền ẩm, bong hoặc xuống cấp cần được đánh giá và xử lý trước.</p></div><ol class="space-y-6">{preparation.map((item,index) => <li class="flex gap-4 border-t border-base-200 pt-5"><span class="text-sm text-primary-600 pt-1">0{index+1}</span><div><h3 class="text-lg font-medium">{item.title}</h3><p class="text-sm text-base-600 mt-3">{item.text}</p></div></li>)}</ol></div></section>

    <section class="px-4 sm:px-6 section-space bg-white"><div class="max-w-7xl mx-auto"><div class="flex flex-wrap justify-between items-end gap-4 mb-7"><div><p class="eyebrow mb-4">04 / BLOG TƯ VẤN</p><h2 class="text-2xl md:text-[1.875rem] font-semibold">Tìm hiểu thêm trước khi quyết định.</h2></div><a href="/blog/" class="inline-flex items-center min-h-11 text-primary-600 text-sm font-semibold hover:underline">Tất cả bài tư vấn →</a></div><div class="grid md:grid-cols-3 gap-6">{posts.slice(0,3).map(post => <a href={postHref(post)} class="group border-t border-base-200 pt-5"><img src={post.image} alt={post.imageAlt || post.title} title={post.imageTitle || post.title} width="800" height="500" loading="lazy" class="w-full aspect-[16/10] object-cover rounded-xl" /><h3 class="text-lg font-medium mt-4 group-hover:text-primary-600">{post.title}</h3><p class="text-sm text-base-600 mt-3">{post.description}</p><span class="inline-flex items-center min-h-11 text-primary-600 text-sm font-semibold mt-2">Đọc bài tư vấn →</span></a>)}</div><div class="max-w-3xl mt-10 border-t border-base-200 pt-6"><h2 class="text-2xl font-semibold mb-5">Một vài câu hỏi trước khi bắt đầu.</h2>{service.faqs.map(faq => <details class="border-b border-base-200 py-4"><summary class="font-medium cursor-pointer min-h-11 flex items-center">{faq.question}</summary><p class="text-sm text-base-600 mt-3 pb-3">{faq.answer}</p></details>)}</div></div></section>
    <ContactCTA title="Bắt đầu từ bề mặt bạn muốn thay đổi." />
  </div>
</BaseLayout>
<style>
  .overview-anchor { scroll-margin-top: 6rem; }
  .service-overview :global(a:focus-visible), .service-overview :global(summary:focus-visible) { outline: 2px solid rgb(var(--primary-500)); outline-offset: 4px; }
</style>
