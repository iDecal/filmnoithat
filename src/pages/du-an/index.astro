---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { services, serviceHref } from "../../data/services";
import { breadcrumbSchema } from "../../data/seo";
const steps = [
  { title: "Ghi lại điều bạn muốn thay đổi", text: "Màu tủ chưa hợp, mặt bàn đã cũ hay một vách cần điểm nhấn? Xác định phần muốn giữ lại và phần cần làm mới.", detail: "Chuẩn bị: ảnh tổng thể, vị trí công trình, công năng sử dụng." },
  { title: "Xem hiện trạng trước khi chọn film", text: "Kiểm tra vùng ẩm, bong lớp phủ, cạnh hỏng và các phụ kiện. Những phần kết cấu không ổn định cần có phương án xử lý riêng.", detail: "Chuẩn bị: ảnh cận cảnh góc, mép và vùng hư hỏng." },
  { title: "Chọn mẫu và chốt phạm vi", text: "So màu dưới ánh sáng thực tế, thống nhất chiều vân, mối nối, tháo lắp và lượng vật tư. Yêu cầu báo giá thể hiện rõ các phần việc.", detail: "Thống nhất: mã film, xử lý nền, nhân công, tiến độ và chi phí." },
  { title: "Thi công, kiểm tra và chăm sóc", text: "Kiểm tra góc mép, mối nối và hoạt động của phụ kiện khi bàn giao. Nhận hướng dẫn sử dụng, vệ sinh và điều kiện bảo hành theo phạm vi đã chốt.", detail: "Bàn giao: ghi nhận kết quả và hướng dẫn chăm sóc vật liệu." },
];
---
<BaseLayout image="/images/thi-cong/thi-cong-film-van-go-bang-may-kho-o-mep-cong.webp" title="Chuẩn bị dự án dán film nội thất: từ ý tưởng đến thi công | Film Nội Thất" description="Bốn bước chuẩn bị dự án dán film: ghi nhận nhu cầu, khảo sát nền, chọn mẫu và chốt phạm vi thi công. Checklist cho bàn, tủ, vách và thang máy." structuredData={[breadcrumbSchema(Astro.site!, [{ name: "Công trình", path: "/cong-trinh/" }, { name: "Chuẩn bị dự án", path: "/du-an/" }])]}>
  <section class="editorial-hero px-4 sm:px-6 section-space bg-base-50 surface-gradient"><div class="max-w-7xl mx-auto"><Breadcrumbs items={[{ label: "Công trình", href: "/cong-trinh/" }, { label: "Chuẩn bị dự án" }]} /><div class="grid lg:grid-cols-2 gap-10 items-center"><div><p class="eyebrow mb-4">TỪ NHU CẦU ĐẾN PHƯƠNG ÁN</p><h1 class="text-[1.75rem] md:text-4xl font-medium">Làm mới có kế hoạch.<br /><span class="text-primary-500">Rõ ràng từ bước đầu.</span></h1><p class="text-lg text-base-600 mt-6">Một phương án phù hợp bắt đầu từ hiện trạng, cách sử dụng và điều bạn mong muốn. Cùng chuẩn bị những thông tin cần thiết trước khi chọn vật liệu.</p><a href="#quy-trinh" class="button-primary mt-7">Xem 4 bước chuẩn bị</a></div><img src="/images/thi-cong/thi-cong-film-van-go-bang-may-kho-o-mep-cong.webp" alt="Thợ đeo găng dùng máy khò hỗ trợ uốn film vân gỗ theo mép cong" title="Thi công film nội thất vân gỗ tại mép cong" class="w-full aspect-[4/3] object-cover rounded-3xl" width="739" height="415" fetchpriority="high" /></div></div></section>
  <section id="quy-trinh" class="px-4 sm:px-6 section-space bg-white"><div class="max-w-5xl mx-auto"><h2 class="text-2xl md:text-[1.625rem] font-semibold mb-10">Bốn bước, một phương án rõ ràng.</h2><ol class="space-y-6">{steps.map((step, index) => <li class="grid sm:grid-cols-[4rem_minmax(0,1fr)] gap-5 rounded-2xl border border-base-200 p-6 md:p-8"><span class="text-3xl text-primary-500 font-semibold">0{index + 1}</span><div><h3 class="text-lg font-semibold">{step.title}</h3><p class="text-base-600 mt-3">{step.text}</p><p class="mt-4 text-sm bg-base-50 p-4 rounded-xl text-base-700">{step.detail}</p></div></li>)}</ol></div></section>
  <section class="px-4 sm:px-6 py-12 bg-base-50"><div class="max-w-7xl mx-auto"><h2 class="text-2xl font-semibold mb-7">Bắt đầu từ hạng mục của bạn</h2><div class="flex flex-wrap gap-3">{services.filter(service => service.slug !== "dan-film-noi-that").map(service => <a href={serviceHref(service)} class="button-secondary">{service.name} →</a>)}</div></div></section>
</BaseLayout>
