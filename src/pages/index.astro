---
import home from "../data/homeContent.json";
import { catalogue } from "../data/catalogue";
import { formatRetailPrice } from "../data/infeelPrices";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import type { IconName } from "../data/icons";
import MaterialPreview from "../components/MaterialPreview.astro";
import { categoryIcon } from "../data/icons";
import { materials, materialHref } from "../data/materials";
import { services, serviceHref } from "../data/services";
import { posts, postHref, formatDate } from "../data/posts";
import { spaces } from "../data/spaces";
import { site } from "../data/site";
const infeelPrices = catalogue.filter(sample => sample.brand === "INFEEL" && sample.pricePerMetre).map(sample => sample.pricePerMetre!);
const infeelStartingPrice = infeelPrices.length ? formatRetailPrice(Math.min(...infeelPrices)) : "";
const text = (value: string) => infeelStartingPrice ? value.replaceAll("{gia_infeel}", infeelStartingPrice) : value.replaceAll("từ {gia_infeel}/mét dài", "liên hệ báo giá");
const featured = home.collections.items.map(item => ({ ...item, material: materials.find(material => material.slug === item.slug)! }));
const serviceItems = services.filter(service => service.slug !== "dan-film-noi-that");
const benefits = home.benefits.items.map(item => ({ ...item, icon: item.icon as IconName, text: text(item.text) }));
const steps = home.steps.items;
const faqs = home.faqs.items.map(faq => ({ ...faq, answer: text(faq.answer) }));
---
<BaseLayout brandName={home.brandName} title={home.seoTitle} description={text(home.seoDescription)} image={home.hero.image.src} faqs={faqs}>
  <div class="home-luxe">
    <section class="editorial-hero home-hero px-4 sm:px-6 bg-base-50 surface-gradient">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.2fr)] gap-8 lg:gap-14 items-center">
        <div>
          <p class="home-kicker mb-5">{home.hero.eyebrow}</p>
          <h1 class="home-title"><span class="home-title-lead">{home.hero.titleLead}</span><span class="home-title-accent text-primary-500">{home.hero.titleAccent}</span></h1>
          <p class="text-base sm:text-lg text-base-600 mt-6 max-w-xl">{home.hero.description}</p>
          <div class="flex flex-col sm:flex-row gap-3 mt-7"><a href={home.hero.primaryHref} class="button-primary">{home.hero.primaryLabel} <Icon name="arrow" size={18} class="ml-2" /></a><a href={home.hero.secondaryHref} class="button-secondary">{home.hero.secondaryLabel}</a></div>
          <p class="text-xs sm:text-sm text-base-600 mt-6">{text(home.hero.priceNote)}</p>
        </div>
        <figure class="min-w-0"><img src={home.hero.image.src} alt={home.hero.image.alt} title={home.hero.image.title || undefined} width={home.hero.image.width} height={home.hero.image.height} fetchpriority="high" class="w-full aspect-[4/3] lg:aspect-[5/4] object-cover rounded-2xl" /><figcaption class="text-xs text-base-600 mt-3">{home.hero.caption}</figcaption></figure>
      </div>
    </section>

    <section class="px-4 sm:px-6 py-8 sm:py-10 bg-base-50 border-y border-base-200" aria-labelledby="home-categories-title">
      <div class="max-w-7xl mx-auto">
        <div class="flex justify-between items-center gap-4 mb-6"><h2 id="home-categories-title" class="text-base font-semibold">{home.categories.title}</h2><a href="/vat-lieu/" class="text-sm text-primary-600 inline-flex items-center gap-2 min-h-11">{home.categories.linkLabel} <Icon name="arrow" size={17} /></a></div>
        <nav class="category-rail flex gap-4 sm:gap-8 lg:justify-between overflow-x-auto pb-2" aria-label="Danh mục film nội thất">
          {materials.map(material => <a href={materialHref(material)} class="category-shortcut flex flex-col items-center gap-3 text-center shrink-0 min-w-20 sm:min-w-24"><span class="category-icon bg-accent-100/60 rounded-xl flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 text-accent-700 transition-colors"><Icon name={categoryIcon(material.slug)!} size={28} /></span><span class="text-xs sm:text-sm font-medium">{material.shortName}</span></a>)}
        </nav>
      </div>
    </section>


    <section class="home-section px-4 sm:px-6 warm-surface" aria-labelledby="materials-title">
      <div class="max-w-7xl mx-auto"><div class="home-section-heading"><div><p class="home-kicker mb-3">{home.collections.eyebrow}</p><h2 id="materials-title" class="home-heading">{home.collections.title}</h2></div><a href="/vat-lieu/" class="home-text-link shrink-0">{home.collections.linkLabel} <Icon name="arrow" size={18} /></a></div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 sm:gap-x-6 gap-y-7">{featured.map(item => <article class="min-w-0"><a href={`${materialHref(item.material)}#mau-vat-lieu`} class="block group"><div class="aspect-[4/3] rounded-xl overflow-hidden bg-base-100"><MaterialPreview material={item.material} /></div><div class="flex gap-2 items-start mt-4"><Icon name={categoryIcon(item.slug)!} size={21} class="text-primary-600 shrink-0 mt-0.5" /><h3 class="text-base sm:text-lg font-medium group-hover:text-primary-600">{item.title}</h3></div><p class="text-sm text-base-600 mt-2">{item.text}</p><span class="home-text-link text-sm mt-2">{home.collections.chooseLabel} <Icon name="arrow" size={16} /></span></a>{item.slug === "kim-loai" && <a href="/vat-lieu/be-tong/#mau-vat-lieu" class="text-sm text-primary-600 underline underline-offset-4 inline-flex min-h-11 items-center">{home.collections.concreteLabel}</a>}</article>)}</div>
      </div>
    </section>

    <section class="home-section px-4 sm:px-6 bg-base-900 ink-gradient text-white" aria-labelledby="applications-title">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.3fr)] gap-8 lg:gap-20">
        <div><p class="home-kicker text-accent-200 mb-4">{home.applications.eyebrow}</p><h2 id="applications-title" class="home-heading text-white">{home.applications.titleLead}<br />{home.applications.titleAccent}</h2><p class="text-white/80 mt-6 max-w-md">{home.applications.description}</p><a href="/dich-vu/dan-film-noi-that/" class="inline-flex items-center gap-3 min-h-12 mt-6 pb-2 border-b border-white/40 text-sm font-medium">{home.applications.linkLabel} <Icon name="arrow" size={18} /></a></div>
        <div>{serviceItems.map(service => <a href={serviceHref(service)} class="home-service-link flex items-start sm:items-center gap-4 sm:gap-6 py-5 border-b border-white/20 first:pt-0"><span class="inline-flex w-10 h-10 items-center justify-center text-accent-200 shrink-0"><Icon name={categoryIcon(service.slug)!} size={27} /></span><div class="flex-1 min-w-0"><h3 class="text-lg font-medium">{service.name}</h3><p class="text-white/75 text-sm mt-2">{service.sections[0].title}</p></div><Icon name="arrow" size={18} class="text-accent-200 mt-3 sm:mt-0" /></a>)}</div>
      </div>
    </section>

    <section class="home-section px-4 sm:px-6 bg-white" aria-labelledby="benefits-title">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <figure class="order-2 lg:order-1"><img src={home.benefits.image.src} alt={home.benefits.image.alt} title={home.benefits.image.title} width={home.benefits.image.width} height={home.benefits.image.height} loading="lazy" class="w-full aspect-[16/10] lg:aspect-[4/5] object-cover rounded-2xl" /><figcaption class="text-xs text-base-600 mt-3">{home.benefits.caption}</figcaption></figure>
        <div class="order-1 lg:order-2"><p class="home-kicker mb-4">{home.benefits.eyebrow}</p><h2 id="benefits-title" class="home-heading">{home.benefits.titleLead}<br />{home.benefits.titleAccent}</h2><div class="mt-7 divide-y divide-base-200">{benefits.map(item => <article class="flex gap-4 py-5"><span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-accent-100 text-accent-700 shrink-0"><Icon name={item.icon} size={22} /></span><div><h3 class="text-base sm:text-lg font-medium">{item.title}</h3><p class="text-sm text-base-600 mt-2">{item.text}</p></div></article>)}</div></div>
      </div>
    </section>

    <section class="home-section px-4 sm:px-6 warm-surface" aria-labelledby="steps-title"><div class="max-w-7xl mx-auto"><p class="home-kicker mb-3">{home.steps.eyebrow}</p><h2 id="steps-title" class="home-heading">{home.steps.title}</h2><ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-7 mt-8">{steps.map((step,index) => <li class="border-t border-base-300 pt-5"><span class="text-accent-600 font-heading text-3xl font-medium">0{index+1}</span><p class="text-base-600 mt-4">{step}</p></li>)}</ol></div></section>

    <section id="cam-hung-chat-lieu" class="home-section px-4 sm:px-6 bg-white" aria-labelledby="home-inspiration-title">
      <div class="max-w-7xl mx-auto">
        <div class="home-section-heading">
          <div><p class="home-kicker mb-3">{home.inspiration.eyebrow}</p><h2 id="home-inspiration-title" class="home-heading">{home.inspiration.titleLead}<br />{home.inspiration.titleAccent}</h2></div>
          <div class="flex flex-wrap gap-x-5 gap-y-1"><a href="/cong-trinh/" class="home-text-link text-sm">{home.inspiration.spacesLabel} <Icon name="arrow" size={17} /></a><a href="/blog/" class="home-text-link text-sm">{home.inspiration.blogLabel} <Icon name="arrow" size={17} /></a></div>
        </div>
        <div class="grid lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] gap-8 lg:gap-12">
          <div>
            <a href={spaces[0].service} class="space-feature group block"><img src={spaces[0].image} alt={spaces[0].title} width="900" height="600" loading="lazy" class="w-full aspect-[3/2] object-cover rounded-xl" /><div class="flex items-start justify-between gap-4 mt-4"><div><p class="text-xs text-base-600 mb-2">{spaces[0].label} · Hình tham khảo</p><h3 class="text-lg sm:text-xl font-medium">{spaces[0].title}</h3></div><Icon name="arrow" size={20} class="text-primary-600 mt-3" /></div></a>
            <div class="grid grid-cols-2 gap-4 mt-6">{spaces.slice(1, 3).map(space => <a href={space.service} class="group"><img src={space.image} alt={space.title} width="450" height="280" loading="lazy" class="w-full aspect-[16/10] object-cover rounded-xl" /><p class="text-xs text-base-600 mt-3 mb-1">{space.label} · Tham khảo</p><h3 class="text-sm sm:text-base font-medium">{space.title}</h3></a>)}</div>
          </div>
          <div class="lg:border-l lg:border-base-200 lg:pl-10">
            <p class="home-kicker mb-5">{home.inspiration.readingLabel}</p>
            <div class="divide-y divide-base-200">{posts.slice(0,3).map(post => <a href={postHref(post)} class="group flex items-start gap-4 sm:gap-5 py-5 first:pt-0"><img src={post.image} alt={post.imageAlt || post.title} title={post.imageTitle || post.title} width="140" height="140" loading="lazy" class="w-20 h-20 sm:w-24 sm:h-24 object-cover rounded-lg shrink-0" /><div class="min-w-0"><p class="text-xs text-base-600 mb-2"><time datetime={post.date}>{formatDate(post.date)}</time> / Cẩm nang</p><h3 class="text-base sm:text-lg font-medium">{post.title}</h3><span class="home-text-link text-sm mt-1">{home.inspiration.readMoreLabel} <Icon name="arrow" size={16} /></span></div></a>)}</div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-section px-4 sm:px-6 warm-surface" aria-labelledby="faq-title"><div class="max-w-7xl mx-auto grid lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.3fr)] gap-8 lg:gap-16"><div><p class="home-kicker mb-3">{home.faqs.eyebrow}</p><h2 id="faq-title" class="home-heading">{home.faqs.title}</h2><a href="/blog/" class="home-text-link mt-4">{home.faqs.linkLabel} <Icon name="arrow" size={18} /></a></div><div class="space-y-3">{faqs.map(faq => <details class="bg-white border border-base-200 rounded-xl p-5 sm:p-6"><summary class="font-medium cursor-pointer leading-relaxed">{faq.question}</summary><p class="text-base-600 mt-4 leading-relaxed">{faq.answer}</p></details>)}</div></div></section>

    <section id="bao-gia" class="home-section px-4 sm:px-6 bg-white" aria-labelledby="quote-title">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <div><p class="home-kicker mb-3">{home.contact.eyebrow}</p><h2 id="quote-title" class="home-heading">{home.contact.title}</h2><p class="text-base-600 mt-5">{home.contact.description}</p><p class="text-base-600 mt-5">{home.contact.address}</p></div>
        <div class="warm-surface rounded-2xl p-6 sm:p-8"><p class="text-sm text-base-600">{home.contact.boxLabel}</p><a href={site.phoneHref} class="flex items-center gap-3 min-h-11 text-primary-600 text-2xl font-semibold mt-3"><Icon name="phone" size={24} />{site.phone}</a><div class="flex flex-col sm:flex-row gap-3 mt-6"><a href={site.zaloHref} class="button-primary">{home.contact.zaloLabel} <Icon name="arrow" size={18} class="ml-2" /></a><a href={site.phoneHref} class="button-secondary">{home.contact.phoneLabel}</a></div><p class="text-sm text-base-600 mt-5">{home.contact.serviceNote}</p></div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
.home-hero { padding-block: clamp(2rem, 5vw, 4rem); }
.home-kicker { color: rgb(var(--color-accent-600)); font-size: .6875rem; line-height: 1.7; font-weight: 600; letter-spacing: .12em; }
.home-kicker.text-accent-200 { color: rgb(var(--color-accent-200)); }
.home-title { font-size: clamp(1.875rem, 3.4vw, 3rem); font-weight: 500; line-height: 1.25; letter-spacing: -.03em; }
.home-heading { font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 600; line-height: 1.3; letter-spacing: -.025em; max-width: 40rem; }
.home-section { padding-block: clamp(2.75rem, 5.5vw, 5rem); }
.home-section-heading { display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; gap: 1.25rem; margin-bottom: 2rem; }
.home-text-link { display: inline-flex; align-items: center; gap: .75rem; min-height: 44px; padding-block: .5rem; color: rgb(var(--color-primary-600)); font-weight: 500; }
.home-text-link:hover { text-decoration: underline; text-underline-offset: 5px; }
.home-service-link:hover h3 { color: rgb(var(--color-accent-200)); }
.category-rail { scrollbar-width: thin; }
.category-shortcut:hover .category-icon { color: rgb(var(--color-primary-600)); background: transparent; }
#bao-gia { scroll-margin-top: 6rem; }
@media(min-width:768px) { .home-section-heading { flex-direction: row; align-items: flex-end; gap: 2rem; } }

/* Homepage-only palette and type: retain every existing layout rule. */
:global(body:has(.home-luxe)) {
  --font-heading: "Montserrat", system-ui, sans-serif;
  --font-body: "Wix Madefor Text", system-ui, sans-serif;
  --home-ink: #faf8f4;
  --home-primary: #193b5b;
  font-family: var(--font-body);
  background-color: var(--home-ink);
}
.home-luxe {
  --home-text: #20313d;
  --home-muted: #56636c;
  --home-link: #20313d;
  --home-highlight: #193b5b;
  --home-border: #ded8cf;
  --home-panel: #ffffff;
  color: var(--home-text);
}
.home-luxe > section {
  background-color: var(--home-ink);
  background-image: none;
  color: var(--home-text);
}
.home-luxe > section[aria-labelledby="benefits-title"],
.home-luxe > section[aria-labelledby="home-inspiration-title"] {
  --home-text: #20313d;
  --home-muted: #4b5863;
  --home-link: #20313d;
  --home-highlight: #765b32;
  --home-border: #e0e5e8;
  --home-panel: #ffffff;
  background-color: #ffffff;
}
.home-luxe .home-title,
.home-luxe .home-heading,
.home-luxe :global(h2),
.home-luxe :global(h3),
.home-luxe :global(.font-heading) { font-family: var(--font-heading); }
.home-luxe :global(.text-base-600) { color: var(--home-muted); }
.home-luxe :global([class*="text-primary-"]) { color: var(--home-link); }
.home-luxe .home-text-link { color: var(--home-link); }
.home-luxe .home-kicker,
.home-luxe :global([class*="text-accent-"]) { color: var(--home-highlight); }
.home-luxe :global([class*="bg-accent-"]),
.home-luxe :global(.category-icon) { background-color: transparent; }
.home-luxe :global(.warm-surface),
.home-luxe :global(details.bg-white) {
  background-color: var(--home-panel);
  background-image: none;
}
.home-luxe > section.warm-surface { background-color: var(--home-ink); }
.home-luxe :global([class*="border-base-"]),
.home-luxe :global([class*="border-white/"]),
.home-luxe :global([class*="divide-base-"] > :not([hidden]) ~ :not([hidden])) { border-color: var(--home-border); }
.home-luxe :global(.button-primary) {
  background-color: var(--home-primary);
  border-color: var(--home-primary);
  color: #ffffff;
}
.home-luxe :global(.button-primary:hover) {
  background-color: #102a43;
  border-color: #102a43;
}
.home-luxe :global(.button-secondary) {
  background-color: #e4cfaa;
  color: var(--home-text);
  border-color: #d1b581;
}
.home-luxe :global(.button-secondary:hover) {
  background-color: #d1b581;
  color: #20313d;
  border-color: #eadbc5;
}
.home-luxe .home-text-link:hover,
.home-luxe .home-service-link:hover h3,
.home-luxe .category-shortcut:hover .category-icon,
.home-luxe :global(.group:hover h3) { color: var(--home-highlight); }
:global(body:has(.home-luxe) .site-header) {
  background-color: #e4cfaa;
  color: #20313d;
  border-color: #cdb387;
}
:global(body:has(.home-luxe) .site-header .font-heading),
:global(body:has(.home-luxe) footer .font-heading) { font-family: var(--font-heading); }
:global(body:has(.home-luxe) .site-header .text-base-900),
:global(body:has(.home-luxe) .site-header [class*="text-primary-"]) { color: #20313d; }
:global(body:has(.home-luxe) .site-header .text-base-500),
:global(body:has(.home-luxe) .site-header .text-base-600) { color: #56636c; }
:global(body:has(.home-luxe) .site-header .submenu-panel),
:global(body:has(.home-luxe) #mobileMenu) { background-color: #fbf4e7; }
:global(body:has(.home-luxe) .site-header [class*="border-base-"]) { border-color: #cdb387; }
:global(body:has(.home-luxe) .site-header [class*="bg-primary-"]) { background-color: #f3e2c4; }
:global(body:has(.home-luxe) .site-header .nav-top-link:hover),
:global(body:has(.home-luxe) .site-header .nav-child-link:hover),
:global(body:has(.home-luxe) .site-header .submenu-toggle:hover) {
  color: #193b5b;
  background-color: #fbf4e7;
}
:global(body:has(.home-luxe) .site-header .button-primary) {
  background-color: #193b5b;
  border-color: #193b5b;
  color: #ffffff;
}
:global(body:has(.home-luxe) .site-header .button-primary:hover) {
  background-color: #102a43;
  border-color: #102a43;
}
:global(body:has(.home-luxe) footer) { background-color: #f0ebe3; }
:global(body:has(.home-luxe) footer .text-accent-200) { color: #20313d; }
:global(body:has(.home-luxe) footer .footer-link:hover) { color: #193b5b; }
:global(body:has(.home-luxe) footer a.bg-white) {
  background-color: #193b5b;
  color: #ffffff;
}
:global(body:has(.home-luxe) footer a.bg-white:hover) { background-color: #102a43; color: #ffffff; }
:global(body:has(.home-luxe) :focus-visible) { outline-color: #193b5b; }
.home-luxe :global(:focus-visible) { outline-color: var(--home-highlight); }
:global(body:has(.home-luxe) ::selection) { background-color: #eadbc5; color: #20313d; }

.home-luxe :global(.text-white) { color: var(--home-text); }
.home-luxe :global([class*="text-white/"]) { color: var(--home-muted); }
.home-luxe > section[aria-labelledby="applications-title"] { background-color: #f1e9dd; }
.home-luxe > section.warm-surface { background-color: #f5f1eb; }
.home-luxe :global(.category-icon) { background-color: #e4cfaa; color: #193b5b; }
</style>
