---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import MaterialPreview from "../components/MaterialPreview.astro";
import { categoryIcon } from "../data/icons";
import { materials, materialHref } from "../data/materials";
import { site } from "../data/site";
const featured = [
  { slug: "van-go", title: "Film dán vân gỗ", text: "Ấm áp, tự nhiên, hợp phòng khách, phòng ngủ." },
  { slug: "da-cam-thach", title: "Film dán vân đá, marble", text: "Sang trọng như đá thật, nhẹ và rẻ hơn nhiều." },
  { slug: "don-sac", title: "Film dán màu trơn", text: "Hiện đại, tối giản, hợp tủ bếp, tủ quần áo." },
  { slug: "kim-loai", title: "Film dán kim loại, bê tông", text: "Phong cách industrial cho quán cà phê, showroom." },
].map(item => ({ ...item, material: materials.find(material => material.slug === item.slug)! }));
const benefits = [
  { icon: "cabinet" as const, title: "Chống nước, chống ẩm", text: "Phù hợp tủ bếp, nhà tắm." },
  { icon: "check" as const, title: "Chống xước, dễ vệ sinh", text: "Bề mặt PVC cao cấp, lau chùi nhanh." },
  { icon: "swatches" as const, title: "Hơn 100 mẫu", text: "Vân gỗ sồi, óc chó, marble, bê tông, màu trơn, kim loại." },
  { icon: "wall" as const, title: "Keo bám chắc", text: "Hạn chế bong mép, bóc ra dễ." },
  { icon: "solid" as const, title: "Giá rõ ràng", text: "Từ 280.000đ đến 550.000đ, chiết khấu cho đại lý và nhà thầu." },
  { icon: "phone" as const, title: "Hỗ trợ tư vấn", text: "Chọn mẫu, tính khối lượng, hướng dẫn thi công." },
];
const applications = [
  { icon: "cabinet" as const, title: "Tủ bếp & tủ quần áo", href: "/dich-vu/dan-film-tu-bep/" },
  { icon: "interior" as const, title: "Cửa gỗ", href: "/vat-lieu/van-go/" },
  { icon: "table" as const, title: "Bàn làm việc & mặt quầy", href: "/dich-vu/dan-film-ban/" },
  { icon: "wall" as const, title: "Tường & vách ngăn", href: "/dich-vu/dan-film-tuong/" },
];
const steps = ["Chọn mẫu tại showroom hoặc qua catalogue.", "Gửi kích thước, nhận báo giá nhanh qua Zalo.", "Giao hàng toàn quốc hoặc hướng dẫn thi công.", "Hỗ trợ kỹ thuật sau bán hàng."];
const faqs = [
  { question: "Film dán nội thất có bền không?", answer: "Film chất lượng tốt dùng được nhiều năm nếu dán đúng kỹ thuật trên bề mặt sạch, phẳng." },
  { question: "Có chống nước không?", answer: "Có, nhưng cần xử lý kỹ mép dán ở khu vực tiếp xúc nước nhiều." },
  { question: "Tự dán tại nhà được không?", answer: "Được với bề mặt nhỏ. Tủ bếp, cửa lớn nên nhờ thợ để tránh bọt khí, nhăn." },
  { question: "Giá film dán nội thất bao nhiêu?", answer: "Tại D-vinyl, giá từ 280.000đ đến 550.000đ tùy chất liệu và mẫu. Liên hệ để báo giá chính xác." },
  { question: "Dán đè film cũ được không?", answer: "Nên bóc film cũ và vệ sinh sạch để bám tốt nhất." },
];
---
<BaseLayout brandName="D-vinyl" title="Film Dán Nội Thất Cao Cấp – Vân Gỗ, Vân Đá | D-vinyl" description="Film dán nội thất D-vinyl chống nước, chống xước, bền màu. Hơn 100 mẫu vân gỗ, vân đá, màu trơn. Giá từ 280.000đ. Giao toàn quốc, báo giá ngay!" image="/images/home/interior-kitchen.webp" faqs={faqs}>
  <div class="home-luxe">
    <section class="home-hero px-4 sm:px-6 bg-base-50 surface-gradient">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] gap-8 lg:gap-14 items-center">
        <div>
          <p class="home-kicker mb-5">D-vinyl / FILM DÁN NỘI THẤT CAO CẤP</p>
          <h1 class="home-title">Film Dán Nội Thất <span class="whitespace-nowrap">D-vinyl</span> – <span class="text-primary-500">Làm Mới Không Gian Chỉ Trong Một Ngày</span></h1>
          <p class="text-base sm:text-lg text-base-600 mt-6 max-w-xl">D-vinyl chuyên cung cấp film dán nội thất cao cấp: vân gỗ, vân đá, màu trơn, kim loại. Sản phẩm chống nước, chống xước, dễ vệ sinh, giúp tủ bếp, cửa, bàn ghế cũ trở nên như mới với chi phí thấp hơn nhiều so với thay mới. Giá chỉ từ 280.000đ.</p>
          <div class="flex flex-col sm:flex-row gap-3 mt-7"><a href="/vat-lieu/" class="button-primary">Xem bộ sưu tập <Icon name="arrow" size={18} class="ml-2" /></a><a href="#bao-gia" class="button-secondary">Nhận báo giá miễn phí</a></div>
          <p class="text-xs sm:text-sm text-base-600 mt-6">Giao toàn quốc · Tư vấn chọn mẫu · Hỗ trợ thi công</p>
        </div>
        <figure class="min-w-0"><img src="/images/home/interior-kitchen.webp" alt="Film dán nội thất vân gỗ cho không gian tủ bếp sáng và hiện đại – ảnh tham khảo" width="810" height="543" fetchpriority="high" class="w-full aspect-[4/3] lg:aspect-[5/6] object-cover rounded-2xl" /><figcaption class="text-xs text-base-600 mt-3">Gợi ý phối chất liệu cho không gian bếp · Ảnh tham khảo</figcaption></figure>
      </div>
    </section>

    <section class="home-section px-4 sm:px-6 bg-white" aria-labelledby="benefits-title">
      <div class="max-w-7xl mx-auto"><div class="home-section-heading"><div><p class="home-kicker mb-3">ĐẸP HƠN TỪ BỀ MẶT</p><h2 id="benefits-title" class="home-heading">Vì Sao Chọn Film Dán Nội Thất D-vinyl?</h2></div><p class="text-base-600 max-w-sm">Một lớp hoàn thiện mới cho nội thất quen thuộc.</p></div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-7">{benefits.map(item => <article class="border-t border-base-200 pt-6"><span class="inline-flex w-11 h-11 rounded-xl bg-accent-100 text-accent-700 items-center justify-center"><Icon name={item.icon} size={24} /></span><h3 class="text-lg font-medium mt-4">{item.title}</h3><p class="text-base-600 text-sm mt-2">{item.text}</p></article>)}</div>
      </div>
    </section>

    <section class="home-section px-4 sm:px-6 warm-surface" aria-labelledby="materials-title">
      <div class="max-w-7xl mx-auto"><div class="home-section-heading"><div><p class="home-kicker mb-3">CHỌN CHẤT LIỆU BẠN YÊU THÍCH</p><h2 id="materials-title" class="home-heading">Danh Mục Film Dán Nội Thất Nổi Bật</h2></div><a href="/vat-lieu/" class="home-text-link shrink-0">Xem bộ sưu tập <Icon name="arrow" size={18} /></a></div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 sm:gap-x-6 gap-y-7">{featured.map(item => <article class="min-w-0"><a href={`${materialHref(item.material)}#mau-vat-lieu`} class="block group"><div class="aspect-[4/3] rounded-xl overflow-hidden bg-base-100"><MaterialPreview material={item.material} /></div><div class="flex gap-2 items-start mt-4"><Icon name={categoryIcon(item.slug)!} size={21} class="text-primary-600 shrink-0 mt-0.5" /><h3 class="text-base sm:text-lg font-medium group-hover:text-primary-600">{item.title}</h3></div><p class="text-sm text-base-600 mt-2">{item.text}</p><span class="home-text-link text-sm mt-2">Chọn mẫu <Icon name="arrow" size={16} /></span></a>{item.slug === "kim-loai" && <a href="/vat-lieu/be-tong/#mau-vat-lieu" class="text-sm text-primary-600 underline underline-offset-4 inline-flex min-h-11 items-center">Xem thêm film bê tông →</a>}</article>)}</div>
      </div>
    </section>

    <section class="home-section px-4 sm:px-6 bg-base-900 ink-gradient text-white" aria-labelledby="applications-title">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-8 lg:gap-16 items-center"><div><p class="home-kicker text-accent-200 mb-4">TỪ NHÀ Ở ĐẾN KHÔNG GIAN KINH DOANH</p><h2 id="applications-title" class="home-heading text-white">Film Dán Nội Thất Dùng Ở Đâu?</h2><p class="text-white/80 mt-5 max-w-lg">Tủ bếp, tủ quần áo, cửa gỗ, bàn làm việc, mặt quầy, tường, vách ngăn. Phù hợp nhà ở, căn hộ, văn phòng, quán cà phê, khách sạn.</p><a href="/dich-vu/dan-film-noi-that/" class="inline-flex items-center gap-3 min-h-11 mt-6 text-accent-200 font-medium">Tìm hiểu dịch vụ thi công <Icon name="arrow" size={18} /></a></div><div class="grid sm:grid-cols-2 gap-4">{applications.map(item => <a href={item.href} class="rounded-xl border border-white/20 p-5 sm:p-6 hover:bg-white/5 transition-colors"><Icon name={item.icon} size={28} class="text-accent-200 mb-5" /><h3 class="font-medium text-base">{item.title}</h3><span class="inline-flex items-center gap-2 text-sm text-white/80 mt-3 min-h-11">Xem ứng dụng <Icon name="arrow" size={16} /></span></a>)}</div></div>
    </section>

    <section class="home-section px-4 sm:px-6 bg-white" aria-labelledby="steps-title"><div class="max-w-7xl mx-auto"><p class="home-kicker mb-3">DỄ CHỌN MẪU. RÕ CÁCH ĐẶT HÀNG.</p><h2 id="steps-title" class="home-heading">Quy Trình Đặt Hàng 4 Bước</h2><ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-7 mt-8">{steps.map((step,index) => <li class="border-t border-base-300 pt-5"><span class="text-accent-600 font-heading text-3xl font-medium">0{index+1}</span><p class="text-base-600 mt-4">{step}</p></li>)}</ol></div></section>

    <section class="home-section px-4 sm:px-6 warm-surface" aria-labelledby="faq-title"><div class="max-w-7xl mx-auto grid lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.3fr)] gap-8 lg:gap-16"><div><p class="home-kicker mb-3">TRƯỚC KHI CHỌN MẪU</p><h2 id="faq-title" class="home-heading">Câu Hỏi Thường Gặp</h2><a href="/blog/" class="home-text-link mt-4">Đọc thêm cẩm nang <Icon name="arrow" size={18} /></a></div><div class="space-y-3">{faqs.map(faq => <details class="bg-white border border-base-200 rounded-xl p-5 sm:p-6"><summary class="font-medium cursor-pointer leading-relaxed">{faq.question}</summary><p class="text-base-600 mt-4 leading-relaxed">{faq.answer}</p></details>)}</div></div></section>

    <section id="bao-gia" class="home-section px-4 sm:px-6 bg-white" aria-labelledby="quote-title"><div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-8 lg:gap-16"><div><p class="home-kicker mb-3">D-vinyl | filmnoithat.vn</p><h2 id="quote-title" class="home-heading">Nhận Báo Giá Film Dán Nội Thất Hôm Nay</h2><p class="text-base-600 mt-5">Chọn mẫu, gửi kích thước và nhu cầu. D-vinyl sẽ tư vấn phương án phù hợp với không gian của bạn.</p><address class="not-italic mt-7 space-y-4 text-base-600"><a href={site.phoneHref} class="flex items-center gap-3 min-h-11 text-primary-600 font-semibold"><Icon name="phone" size={22} />Hotline/Zalo: 0866 077 040</a><p>606/20 Quốc lộ 13, P. Hiệp Bình, TP.HCM</p></address><a href={site.zaloHref} class="home-text-link mt-4">Trao đổi trực tiếp qua Zalo <Icon name="arrow" size={18} /></a></div>
      <form data-quote-form class="rounded-2xl warm-surface p-6 sm:p-8 space-y-5"><label class="block text-sm font-medium" for="quote-name">Họ tên<input id="quote-name" name="name" autocomplete="name" required maxlength="100" class="quote-input" placeholder="Tên của bạn" /></label><label class="block text-sm font-medium" for="quote-phone">Số điện thoại<input id="quote-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[+0-9 ()\-]{9,20}" maxlength="20" class="quote-input" placeholder="Số điện thoại liên hệ" /></label><label class="block text-sm font-medium" for="quote-needs">Nhu cầu<textarea id="quote-needs" name="needs" rows="4" required maxlength="2000" class="quote-input" placeholder="Mã mẫu, kích thước, hạng mục hoặc địa điểm cần tư vấn…"></textarea></label><p class="text-xs text-base-600">Form giúp soạn yêu cầu để bạn sao chép và gửi qua Zalo. Thông tin chỉ được gửi khi bạn gửi tin nhắn trong Zalo.</p><button type="submit" class="button-primary w-full">Soạn yêu cầu báo giá <Icon name="arrow" size={18} class="ml-2" /></button><div data-quote-result hidden class="space-y-3"><label class="block text-sm font-medium" for="quote-message">Nội dung gửi D-vinyl<textarea id="quote-message" readonly rows="6" class="quote-input"></textarea></label><button type="button" data-quote-copy class="button-secondary w-full">Sao chép yêu cầu</button><a href={site.zaloHref} class="button-primary w-full">Mở Zalo để gửi yêu cầu</a></div><p data-quote-status role="status" aria-live="polite" class="text-sm text-base-600"></p><noscript><p class="text-sm text-base-600">Vui lòng gọi 0866 077 040 hoặc dùng đường dẫn Zalo bên cạnh để gửi nhu cầu.</p></noscript></form>
    </div></section>
  </div>
</BaseLayout>
<script>
const form = document.querySelector<HTMLFormElement>("[data-quote-form]");
form?.addEventListener("submit", event => {
  event.preventDefault();
  const data = new FormData(form);
  const message = document.querySelector<HTMLTextAreaElement>("#quote-message")!;
  message.value = `Xin chào D-vinyl, tôi muốn nhận báo giá film dán nội thất.\nHọ tên: ${String(data.get("name")).trim()}\nSố điện thoại: ${String(data.get("phone")).trim()}\nNhu cầu: ${String(data.get("needs")).trim()}`;
  document.querySelector<HTMLElement>("[data-quote-result]")!.hidden = false;
  document.querySelector<HTMLElement>("[data-quote-status]")!.textContent = "Đã soạn yêu cầu. Bạn hãy sao chép rồi mở Zalo để gửi cho D-vinyl.";
});
document.querySelector("[data-quote-copy]")?.addEventListener("click", async () => {
  const message = document.querySelector<HTMLTextAreaElement>("#quote-message")!;
  const status = document.querySelector<HTMLElement>("[data-quote-status]")!;
  try { await navigator.clipboard.writeText(message.value); status.textContent = "Đã sao chép. Mở Zalo và dán nội dung để gửi yêu cầu."; }
  catch { message.focus(); message.select(); status.textContent = "Hãy sao chép nội dung đang được chọn, sau đó gửi qua Zalo."; }
});
</script>
<style>
.home-hero { padding-block: clamp(2rem, 5vw, 4rem); }
.home-kicker { color: rgb(var(--color-accent-600)); font-size: .6875rem; line-height: 1.7; font-weight: 600; letter-spacing: .12em; }
.home-kicker.text-accent-200 { color: rgb(var(--color-accent-200)); }
.home-title { font-size: clamp(1.75rem, 3vw, 2.75rem); font-weight: 500; line-height: 1.25; letter-spacing: -.03em; }
.home-heading { font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 600; line-height: 1.3; letter-spacing: -.025em; max-width: 40rem; }
.home-section { padding-block: clamp(2.75rem, 5.5vw, 5rem); }
.home-section-heading { display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; gap: 1.25rem; margin-bottom: 2rem; }
.home-text-link { display: inline-flex; align-items: center; gap: .75rem; min-height: 44px; padding-block: .5rem; color: rgb(var(--color-primary-600)); font-weight: 500; }
.home-text-link:hover { text-decoration: underline; text-underline-offset: 5px; }
.quote-input { display: block; width: 100%; min-height: 48px; margin-top: .5rem; border: 1px solid rgb(var(--color-base-300)); border-radius: .5rem; padding: .75rem 1rem; background: white; font-size: 1rem; font-weight: 400; }
#bao-gia { scroll-margin-top: 6rem; }
[data-quote-result][hidden] { display: none; }
@media(min-width:768px) { .home-section-heading { flex-direction: row; align-items: flex-end; gap: 2rem; } }
</style>
