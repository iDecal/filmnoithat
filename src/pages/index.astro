---
import BaseLayout from "../layouts/BaseLayout.astro";
import MaterialPreview from "../components/MaterialPreview.astro";
import ProductCards from "../components/ProductCards.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { materials, materialHref } from "../data/materials";
import { products } from "../data/products";
import { services, serviceHref } from "../data/services";
import { posts, postHref, formatDate } from "../data/posts";
import { spaces } from "../data/spaces";
const featuredMaterials = [materials[0], materials[2], materials[3], materials[4]];
---
<BaseLayout title="Film nội thất: cung cấp vật liệu & thi công | iDecal" description="Cùng iDecal chọn film và phương án làm mới bàn, tủ, vách, trần, thang máy. Khám phá mẫu vật liệu, ứng dụng và tư vấn tại TP.HCM, Bình Dương." image="/images/blog/dan-film-noi-that-tu-bep.webp">
  <section class="px-4 sm:px-6 py-12 md:py-20 bg-base-50 border-b border-base-200"><div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
    <div><p class="eyebrow mb-5">CUNG CẤP FILM · THI CÔNG NỘI THẤT</p><h1 class="text-4xl sm:text-5xl xl:text-6xl font-semibold leading-[1.2]">Diện mạo mới.<br /><span class="text-primary-500">Không gian thân quen.</span></h1><p class="mt-6 text-lg text-base-600 max-w-xl">Làm mới bàn, tủ và những bề mặt quen thuộc bằng film trang trí. Cùng chọn một chất liệu hợp gu và một phương án hợp với không gian của bạn.</p><div class="flex flex-wrap gap-3 mt-8"><a href="/vat-lieu/" class="button-primary">Tìm mẫu film →</a><a href="/dich-vu/dan-film-noi-that/" class="button-secondary">Tư vấn thi công</a></div><div class="flex flex-wrap gap-x-6 gap-y-2 border-t border-base-200 mt-8 pt-6 text-sm text-base-600"><span><span aria-hidden="true" class="text-primary-600 mr-2">✓</span>Xem mẫu trước khi chọn</span><span><span aria-hidden="true" class="text-primary-600 mr-2">✓</span>TP.HCM & Bình Dương</span></div></div>
    <figure class="rounded-3xl overflow-hidden border border-base-200 bg-white"><img src="/images/blog/dan-film-noi-that-tu-bep.webp" alt="Không gian bếp tham khảo phối sắc gỗ ấm và tường sáng" class="w-full aspect-[5/4] lg:aspect-[5/6] object-cover" width="1000" height="1200" fetchpriority="high" /><figcaption class="p-5 flex items-center gap-4"><img src="/images/vat-lieu/van-go/CAD402-goc.jpg" alt="Tham khảo họa tiết film vân gỗ CAD402" width="56" height="56" class="w-14 h-14 object-cover rounded-lg shrink-0" /><div><p class="text-xs text-base-600">TỪ CHẤT LIỆU ĐẾN CẢM GIÁC</p><p class="text-sm font-semibold mt-1">Chọn vân yêu thích. Làm mới tổ ấm.</p></div></figcaption></figure>
  </div></section>
  <section class="px-4 sm:px-6 py-14 md:py-20 bg-white"><div class="max-w-7xl mx-auto"><div class="flex flex-wrap items-end justify-between gap-5 mb-8"><div><p class="eyebrow mb-3">KHÁM PHÁ THEO CHẤT LIỆU</p><h2 class="text-2xl md:text-3xl font-semibold">Bạn thích cảm giác nào?</h2><p class="text-base-600 mt-4">Ấm áp của gỗ, mềm mại của vải hay một điểm nhấn ánh kim.</p></div><a href="/vat-lieu/" class="text-primary-600 font-semibold py-2 hover:underline">Tất cả vật liệu →</a></div><div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">{featuredMaterials.map(material => <a href={materialHref(material)} class="group rounded-2xl overflow-hidden border border-base-200 hover:border-primary-300 transition"><div class="aspect-[4/5]"><MaterialPreview material={material} /></div><div class="p-5"><h3 class="text-xl font-semibold">{material.name}</h3><p class="mt-2 text-sm text-base-600">{material.moodLabel}</p><span class="inline-block mt-4 text-primary-600 text-sm font-semibold">Khám phá →</span></div></a>)}</div></div></section>
  <section class="px-4 sm:px-6 py-14 md:py-20 bg-base-50"><div class="max-w-7xl mx-auto"><div class="max-w-2xl mb-8"><p class="eyebrow mb-3">CHỌN THEO NHU CẦU</p><h2 class="text-2xl md:text-3xl font-semibold">Bạn muốn làm mới bề mặt nào?</h2><p class="mt-4 text-base-600">Mỗi hạng mục có điều kiện nền, cách chọn mẫu và xử lý chi tiết riêng.</p></div><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{services.filter(service => service.slug !== "dan-film-noi-that").map(service => <a href={serviceHref(service)} class="rounded-2xl border border-base-200 bg-white overflow-hidden hover:border-primary-300 transition"><img src={service.image} alt={`Hình tham khảo ${service.name.toLowerCase()}`} class="w-full aspect-[16/10] object-cover" width="600" height="375" loading="lazy" /><div class="p-6"><h3 class="text-xl font-semibold">{service.name}</h3><p class="text-base-600 text-sm mt-3">{service.sections[0].title}</p><span class="inline-block mt-5 text-sm text-primary-600 font-semibold">Xem dịch vụ →</span></div></a>)}</div></div></section>
  <ProductCards products={products} title="Đã có ý tưởng? Xem mẫu theo mã." />
  <section class="px-4 sm:px-6 py-14 md:py-20 bg-white"><div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-10 lg:gap-16 items-center"><div><p class="eyebrow mb-4">LÀM MỚI CÓ KẾ HOẠCH</p><h2 class="text-2xl md:text-4xl font-semibold">Rõ ràng trước khi bắt đầu.<br /><span class="text-primary-500">Chỉn chu đến lúc hoàn thiện.</span></h2><p class="text-base-600 mt-6">Từ ảnh hiện trạng đến mẫu film, cùng xác định phần cần giữ lại, phần cần xử lý và phạm vi thi công trước khi quyết định.</p><a href="/du-an/" class="button-secondary mt-7">Xem cách chuẩn bị dự án →</a></div><ol class="space-y-4">{[{ title: "Hiểu hiện trạng", text: "Gửi ảnh, kích thước và nhu cầu sử dụng." }, { title: "Chọn mẫu & phương án", text: "So màu, kiểm tra nền và chốt rõ các phần việc." }, { title: "Hoàn thiện & chăm sóc", text: "Kiểm tra góc mép, bàn giao và hướng dẫn sử dụng." }].map((step, index) => <li class="flex gap-5 p-6 rounded-2xl border border-base-200 bg-base-50"><span class="text-primary-600 font-semibold">0{index + 1}</span><div><h3 class="text-lg font-semibold">{step.title}</h3><p class="text-base-600 text-sm mt-2">{step.text}</p></div></li>)}</ol></div></section>
  <section class="px-4 sm:px-6 py-14 bg-base-50"><div class="max-w-7xl mx-auto"><div class="flex flex-wrap items-end justify-between gap-4 mb-8"><div><p class="eyebrow mb-3">CẢM HỨNG CHO KHÔNG GIAN</p><h2 class="text-2xl md:text-3xl font-semibold">Hình dung một thay đổi.</h2></div><a href="/cong-trinh/" class="text-primary-600 font-semibold py-2 hover:underline">Xem gợi ý ứng dụng →</a></div><div class="grid md:grid-cols-3 gap-6">{spaces.slice(0, 3).map(space => <a href={space.service} class="rounded-2xl overflow-hidden border border-base-200 bg-white hover:border-primary-300 transition"><img src={space.image} alt={space.title} class="w-full aspect-[4/3] object-cover" width="600" height="450" loading="lazy" /><div class="p-6"><p class="eyebrow text-xs mb-3">{space.label} · Hình tham khảo</p><h3 class="text-xl font-semibold">{space.title}</h3><span class="text-primary-600 text-sm font-semibold inline-block mt-5">Khám phá giải pháp →</span></div></a>)}</div></div></section>
  <section class="px-4 sm:px-6 py-14 md:py-20 bg-white"><div class="max-w-7xl mx-auto"><div class="flex flex-wrap items-end justify-between gap-4 mb-8"><div><p class="eyebrow mb-3">CẨM NANG FILM NỘI THẤT</p><h2 class="text-2xl md:text-3xl font-semibold">Biết thêm để chọn đúng.</h2></div><a href="/blog/" class="text-primary-600 font-semibold py-2 hover:underline">Tất cả bài viết →</a></div><div class="grid md:grid-cols-3 gap-6">{posts.map(post => <article class="rounded-2xl border border-base-200 overflow-hidden"><a href={postHref(post)} class="block hover:text-primary-600"><img src={post.image} alt={post.title} class="w-full aspect-[3/2] object-cover" width="600" height="400" loading="lazy" /><div class="p-6"><time datetime={post.date} class="text-xs text-base-600">{formatDate(post.date)}</time><h3 class="text-xl font-semibold mt-3">{post.title}</h3><p class="text-sm text-base-600 mt-4">{post.description}</p><span class="text-primary-600 font-semibold text-sm mt-5 inline-block">Đọc bài viết →</span></div></a></article>)}</div></div></section>
  <ContactCTA />
</BaseLayout>
