---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import MaterialPreview from "../components/MaterialPreview.astro";
import { categoryIcon } from "../data/icons";
import { materials, materialHref } from "../data/materials";
import { services, serviceHref } from "../data/services";
import { posts, postHref, formatDate } from "../data/posts";
import { spaces } from "../data/spaces";
import { site } from "../data/site";
const featuredMaterials = [materials[0], materials[2], materials[3], materials[4]];
const serviceItems = services.filter(service => service.slug !== "dan-film-noi-that");
const approach = [
  { title: "Hiểu không gian", text: "Bắt đầu từ ảnh hiện trạng, công năng và điều bạn muốn thay đổi." },
  { title: "Chọn đúng chất liệu", text: "So mẫu, xem ánh sáng và làm rõ điều kiện bề mặt trước khi quyết định." },
  { title: "Chỉn chu khi hoàn thiện", text: "Thống nhất phạm vi, kiểm tra từng chi tiết và hướng dẫn chăm sóc." },
];
---
<BaseLayout title="Film dán nội thất – Vật liệu INFEEL, Corance & thi công" description="Cung cấp film nội thất và nhận thi công theo nhu cầu trên toàn quốc. Chọn film cho bàn, tủ, vách, trần, thang máy; tư vấn vật liệu và báo giá theo công trình." image="/images/home/interior-kitchen.webp">
  <div class="home-luxe">
    <section class="home-hero bg-base-50 surface-gradient px-4 sm:px-6">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.2fr)] gap-8 lg:gap-14 items-center">
        <div class="home-hero-copy">
          <p class="home-kicker mb-5">CUNG CẤP & THI CÔNG FILM NỘI THẤT</p>
          <h1 class="home-title">Tinh tế bề mặt.<br /><span class="text-primary-500">Khác biệt<br class="hidden xl:block" /> không gian.</span></h1>
          <p class="text-base sm:text-lg text-base-600 mt-5 lg:mt-7 max-w-lg">Mua film để tự hoàn thiện hoặc chọn dịch vụ thi công theo nhu cầu. Cùng tìm chất liệu phù hợp để làm mới không gian của bạn.</p>
          <div class="grid grid-cols-2 sm:flex gap-3 mt-6 lg:mt-8">
            <a href="/vat-lieu/" class="button-primary home-action">Chọn vật liệu <Icon name="arrow" size={18} class="ml-2 hidden sm:block" /></a>
            <a href="/dich-vu/dan-film-noi-that/" class="button-secondary home-action">Tư vấn thi công</a>
          </div>
          <p class="text-xs sm:text-sm text-base-600 mt-6 lg:mt-8">Cung cấp film toàn quốc · Thi công theo địa điểm công trình</p>
        </div>
        <figure class="min-w-0">
          <div class="relative overflow-hidden rounded-2xl">
            <img src="/images/home/interior-kitchen.webp" alt="Không gian bếp tham khảo với cánh tủ gỗ sáng, nền xanh trầm và mặt bàn trắng" width="810" height="543" fetchpriority="high" class="home-hero-photo w-full aspect-[4/3] lg:aspect-[5/4] object-cover" />

          </div>
          <figcaption class="flex justify-between flex-wrap gap-2 pt-3 text-xs text-base-600"><span>Không gian tham khảo</span><a href="/vat-lieu/van-go/" class="hover:underline">Khám phá vân gỗ →</a></figcaption>
        </figure>
      </div>
    </section>

    <section class="px-4 sm:px-6 py-8 sm:py-10 bg-base-50 border-y border-base-200" aria-labelledby="home-categories-title">
      <div class="max-w-7xl mx-auto">
        <div class="flex justify-between items-center gap-4 mb-6"><h2 id="home-categories-title" class="text-base font-semibold">Chọn chất liệu của bạn</h2><a href="/vat-lieu/" class="text-sm text-primary-600 inline-flex items-center gap-2 min-h-11">Tất cả <Icon name="arrow" size={17} /></a></div>
        <nav class="category-rail flex gap-4 sm:gap-8 lg:justify-between overflow-x-auto pb-2" aria-label="Danh mục film nội thất">
          {materials.map(material => <a href={materialHref(material)} class="category-shortcut flex flex-col items-center gap-3 text-center shrink-0 min-w-20 sm:min-w-24"><span class="category-icon bg-accent-100/60 rounded-xl flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 text-accent-700 transition-colors"><Icon name={categoryIcon(material.slug)!} size={28} /></span><span class="text-xs sm:text-sm font-medium">{material.shortName}</span></a>)}
        </nav>
      </div>
    </section>

    <section class="home-section px-4 sm:px-6 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="home-section-heading"><div><p class="home-kicker mb-3">01 / BỘ SƯU TẬP VẬT LIỆU</p><h2 class="home-heading">Chất liệu tạo nên<br />cảm xúc.</h2></div><div class="max-w-sm"><p class="text-base-600 mb-4">Từ sắc gỗ ấm đến bề mặt ánh kim, tìm một cách phối hài hòa với không gian của bạn.</p><a href="/vat-lieu/" class="home-text-link">Khám phá bộ sưu tập <Icon name="arrow" size={18} /></a></div></div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 sm:gap-x-6 gap-y-7">
          {featuredMaterials.map(material => <a href={materialHref(material)} class="material-editorial group block"><div class="aspect-[3/4] rounded-xl overflow-hidden bg-base-100"><MaterialPreview material={material} /></div><div class="flex items-start gap-2 sm:gap-3 mt-4"><Icon name={categoryIcon(material.slug)!} size={22} class="text-primary-600 mt-0.5" /><div><h3 class="text-base sm:text-lg font-medium">{material.name}</h3><p class="hidden sm:block text-sm text-base-600 mt-2">{material.moodLabel}</p></div></div></a>)}
        </div>
      </div>
    </section>

    <section class="home-section px-4 sm:px-6 bg-base-900 ink-gradient text-white">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.3fr)] gap-8 lg:gap-20">
        <div><p class="home-kicker text-accent-200 mb-4">02 / DỊCH VỤ THI CÔNG</p><h2 class="home-heading text-white">Giữ kết cấu.<br />Đổi diện mạo.</h2><p class="text-white/80 mt-6 max-w-md">Mỗi bề mặt có một cách tiếp cận. Cùng khảo sát hiện trạng và chọn phương án trước khi bắt đầu.</p><a href="/dich-vu/dan-film-noi-that/" class="inline-flex items-center gap-3 min-h-12 mt-7 pb-2 border-b border-white/40 text-sm font-medium">Tất cả dịch vụ <Icon name="arrow" size={18} /></a></div>
        <div>{serviceItems.map(service => <a href={serviceHref(service)} class="home-service-link flex items-start sm:items-center gap-4 sm:gap-6 py-5 sm:py-6 border-b border-white/20 first:pt-0 group"><span class="flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 text-accent-200 shrink-0"><Icon name={categoryIcon(service.slug)!} size={27} /></span><div class="flex-1 min-w-0"><h3 class="text-lg sm:text-xl font-medium">{service.name}</h3><p class="text-white/80 text-sm mt-2">{service.sections[0].title}</p></div><Icon name="arrow" size={20} class="text-accent-200 mt-3 sm:mt-0" /></a>)}</div>
      </div>
    </section>



    <section class="home-section px-4 sm:px-6 bg-white">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-8 lg:gap-20 items-center">
        <figure class="order-2 lg:order-1"><img src="/images/cong-trinh/huong-dan-tu-dan-film-noi-that-DIY.jpg" alt="Hình tham khảo thao tác hoàn thiện film trên bề mặt" width="1024" height="530" loading="lazy" class="w-full aspect-[16/10] lg:aspect-[4/5] object-cover rounded-2xl" /><figcaption class="text-xs text-base-600 pt-3">Một lớp hoàn thiện, nhiều chi tiết cần quan tâm.</figcaption></figure>
        <div class="order-1 lg:order-2"><p class="home-kicker mb-4">CHẤT LIỆU ĐẸP. CÁCH LÀM RÕ RÀNG.</p><h2 class="home-heading">Chỉn chu từ lựa chọn<br />đến hoàn thiện.</h2><ol class="mt-8 divide-y divide-base-200">{approach.map((step, index) => <li class="flex gap-5 py-5"><span class="text-primary-600 text-sm pt-1">0{index + 1}</span><div><h3 class="text-lg font-medium">{step.title}</h3><p class="text-sm text-base-600 mt-2">{step.text}</p></div></li>)}</ol><a href="/du-an/" class="home-text-link mt-5">Cách chuẩn bị dự án <Icon name="arrow" size={18} /></a></div>
      </div>
    </section>

    <section id="cam-hung-chat-lieu" class="home-section px-4 sm:px-6 warm-surface" aria-labelledby="home-inspiration-title">
      <div class="max-w-7xl mx-auto">
        <div class="home-section-heading">
          <div><p class="home-kicker mb-3">03 / CẢM HỨNG & CHẤT LIỆU</p><h2 id="home-inspiration-title" class="home-heading">Ý tưởng cho không gian.<br />Kiến thức để chọn đúng.</h2></div>
          <div class="flex flex-wrap gap-x-5 gap-y-1"><a href="/cong-trinh/" class="home-text-link text-sm">Xem không gian <Icon name="arrow" size={17} /></a><a href="/blog/" class="home-text-link text-sm">Xem bài viết <Icon name="arrow" size={17} /></a></div>
        </div>
        <div class="grid lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] gap-8 lg:gap-12">
          <div>
            <a href={spaces[0].service} class="space-feature group block"><img src={spaces[0].image} alt={spaces[0].title} width="900" height="600" loading="lazy" class="w-full aspect-[3/2] object-cover rounded-xl" /><div class="flex items-start justify-between gap-4 mt-4"><div><p class="text-xs text-base-600 mb-2">{spaces[0].label} · Hình tham khảo</p><h3 class="text-lg sm:text-xl font-medium">{spaces[0].title}</h3></div><Icon name="arrow" size={20} class="text-primary-600 mt-3" /></div></a>
            <div class="grid grid-cols-2 gap-4 mt-6">{spaces.slice(1, 3).map(space => <a href={space.service} class="group"><img src={space.image} alt={space.title} width="450" height="280" loading="lazy" class="w-full aspect-[16/10] object-cover rounded-xl" /><p class="text-xs text-base-600 mt-3 mb-1">{space.label} · Tham khảo</p><h3 class="text-sm sm:text-base font-medium">{space.title}</h3></a>)}</div>
          </div>
          <div class="lg:border-l lg:border-base-200 lg:pl-10">
            <p class="home-kicker mb-5">ĐỌC THÊM TRƯỚC KHI CHỌN VẬT LIỆU</p>
            <div class="divide-y divide-base-200">{posts.map(post => <a href={postHref(post)} class="group flex items-start gap-4 sm:gap-5 py-5 first:pt-0"><img src={post.image} alt={post.title} width="140" height="140" loading="lazy" class="w-20 h-20 sm:w-24 sm:h-24 object-cover rounded-lg shrink-0" /><div class="min-w-0"><p class="text-xs text-base-600 mb-2"><time datetime={post.date}>{formatDate(post.date)}</time> / Cẩm nang</p><h3 class="text-base sm:text-lg font-medium">{post.title}</h3><span class="home-text-link text-sm mt-1">Đọc bài viết <Icon name="arrow" size={16} /></span></div></a>)}</div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-closing home-section px-4 sm:px-6 bg-base-900 ink-gradient text-white text-center">
      <div class="max-w-3xl mx-auto"><span class="inline-flex text-accent-200 mb-5"><Icon name="interior" size={38} /></span><p class="home-kicker text-accent-200 mb-4">MỘT Ý TƯỞNG MỚI CHO KHÔNG GIAN QUEN</p><h2 class="home-heading">Cùng tạo nên<br />diện mạo bạn yêu thích.</h2><p class="text-white/80 mt-5 max-w-xl mx-auto">Gửi ảnh hiện trạng và phong cách bạn mong muốn. Cùng trao đổi từ mẫu film đến phương án thi công phù hợp.</p><div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6 mt-7"><a href={site.zaloHref} class="button-secondary button-accent home-action w-full sm:w-auto">Tư vấn qua Zalo <Icon name="arrow" size={18} class="ml-2" /></a><a href={site.phoneHref} class="inline-flex items-center gap-2 min-h-12 text-sm font-medium"><Icon name="phone" size={18} />{site.phone}</a></div></div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-hero { padding-top: 2rem; padding-bottom: 2.25rem; }
  .home-kicker { color: rgb(var(--color-accent-600)); font-size: 0.6875rem; line-height: 1.7; font-weight: 600; letter-spacing: 0.13em; }
  .home-kicker.text-accent-200 { color: rgb(var(--color-accent-200)); }
  .home-title { font-size: clamp(1.75rem, 3.4vw, 3rem); font-weight: 500; line-height: 1.2; letter-spacing: -0.03em; }
  .home-heading { font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 600; line-height: 1.3; letter-spacing: -0.025em; }
  .home-section { padding-block: clamp(2.75rem, 5.5vw, 5rem); }
  .home-section-heading { display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; gap: 1.25rem; margin-bottom: 2rem; }
  .home-text-link { display: inline-flex; align-items: center; gap: 0.75rem; min-height: 44px; padding-block: 0.5rem; color: rgb(var(--color-primary-600)); font-weight: 500; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .home-text-link:hover { text-decoration-line: underline; }
  .category-rail { scrollbar-width: thin; scrollbar-color: rgb(var(--color-base-300)) transparent; }
  .category-shortcut:hover .category-icon { background: transparent; color: rgb(var(--color-primary-600)); }
  .home-service-link:hover h3 { color: rgb(var(--color-primary-200)); }
  .material-editorial:hover h3, .space-feature:hover h3 { color: rgb(var(--color-primary-600)); }
  @media (max-width: 639px) { .home-action { font-size: 0.875rem; padding: 12px 10px; min-height: 48px; } }
  @media (min-width: 768px) { .home-section-heading { flex-direction: row; align-items: flex-end; gap: 2rem; margin-bottom: 2rem; } }
  @media (min-width: 1024px) { .home-hero { padding-top: 4rem; padding-bottom: 4rem; } }
</style>
