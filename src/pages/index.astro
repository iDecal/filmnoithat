---
import home from "../data/homeContent.json";
import { catalogue, sampleHref } from "../data/catalogue";
import { formatRetailPrice } from "../data/infeelPrices";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { categoryIcon } from "../data/icons";
import { materials, materialHref } from "../data/materials";
import { posts, postHref, formatDate } from "../data/posts";
import { projectStories, storyHref, storyLabel } from "../data/projectStories";
import { heroBackdrop } from "../data/heroBackdrops";
import { site } from "../data/site";
const prices = catalogue.filter(sample => sample.brand === "INFEEL" && sample.pricePerMetre).map(sample => sample.pricePerMetre!);
const startingPrice = prices.length ? formatRetailPrice(Math.min(...prices)) : "";
const text = (value: string) => startingPrice ? value.replaceAll("{gia_infeel}", startingPrice) : value.replaceAll("từ {gia_infeel}/mét dài", "liên hệ báo giá");
const faqs = home.faqs.items.map(faq => ({ ...faq, answer: text(faq.answer) }));
const brands = [...new Set(catalogue.map(sample => sample.brand))];
const collectionPhotos: Record<string,string> = {
  "van-go": "/images/bo-suu-tap/film-noi-that-phoi-go-sang-trong-khong-gian-bep.webp",
  "da-cam-thach": "/images/home/interior-kitchen.webp",
  "don-sac": "/images/bo-suu-tap/film-noi-that-canh-tu-mau-kem.webp",
  "kim-loai": "/images/bo-suu-tap/film-noi-that-quay-anh-kim-voi-duong-sang.webp",
};
const collections = home.collections.items.map(item => ({ ...item, material: materials.find(material => material.slug === item.slug)!, image: collectionPhotos[item.slug] }));
const stories = [...projectStories.filter(story => story.kind === "reference"), ...projectStories.filter(story => story.kind !== "reference")].slice(0,6);
const heroSlides = [
  { src: heroBackdrop("/"), alt: "Không gian bếp phối gỗ và tông trung tính — ảnh tham khảo" },
  { src: "/images/bo-suu-tap/film-noi-that-quay-va-vach-trong-khong-gian-tiep-don.webp", alt: "Quầy và vách nội thất trong không gian tiếp đón — ảnh tham khảo" },
  { src: "/images/bo-suu-tap/film-noi-that-phoi-go-sang-trong-khong-gian-bep.webp", alt: "Bếp sáng phối chất liệu gỗ — ảnh tham khảo" },
];
const selected = new Set<string>();
const featuredProducts = [
  ["van-go","INFEEL"], ["van-go","Corance"], ["da-cam-thach","INFEEL"], ["da-cam-thach","TODA"],
  ["don-sac","INFEEL"], ["don-sac","TODA"], ["kim-loai","INFEEL"], ["kim-loai","Corance"],
].map(([category,brand]) => {
  const sample = catalogue.find(item => item.category === category && item.brand === brand && !selected.has(item.slug)) || catalogue.find(item => item.category === category && !selected.has(item.slug))!;
  selected.add(sample.slug); return sample;
});
const latestPosts = [...posts].sort((a,b) => b.date.localeCompare(a.date)).slice(0,4);
---
<BaseLayout brandName={home.brandName} title={home.seoTitle} description={text(home.seoDescription)} image={heroSlides[0].src} faqs={faqs}>
  <div class="home-dom">
    <section class="dom-hero" aria-labelledby="dom-title" aria-roledescription="trình chiếu" aria-label="Không gian nội thất tham khảo" data-home-slider>
      <div class="dom-slides">{heroSlides.map((slide,index) => <img src={slide.src} alt={slide.alt} width="1448" height="1086" loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} class:list={["dom-slide",{"is-active":index===0}]} aria-hidden={index !== 0 ? "true" : undefined} data-hero-slide />)}</div>
      <div class="dom-shade" aria-hidden="true"></div>
      <div class="dom-wrap dom-hero-copy"><p class="dom-label">{home.hero.eyebrow}</p><h1 id="dom-title">{home.hero.titleLead}<br />{home.hero.titleAccent}</h1><p class="dom-hero-description">{home.hero.description}</p><a href={home.hero.primaryHref} class="dom-button dom-button-orange">{home.hero.primaryLabel}<Icon name="arrow" size={17} /></a></div>
      <button type="button" data-hero-prev class="dom-hero-arrow dom-prev" aria-label="Xem ảnh không gian trước">←</button><button type="button" data-hero-next class="dom-hero-arrow dom-next" aria-label="Xem ảnh không gian tiếp theo">→</button>
      <div class="dom-dots" role="group" aria-label="Chọn ảnh không gian">{heroSlides.map((_,index) => <button type="button" data-hero-dot aria-label={`Xem ảnh ${index+1}`} aria-pressed={index===0 ? "true":"false"}><span></span></button>)}</div><p class="dom-hero-source">Ảnh không gian tham khảo</p><span class="dom-sr-only" data-hero-status role="status" aria-live="polite">Ảnh 1 / {heroSlides.length}</span>
    </section>

    <section class="dom-section" aria-labelledby="dom-collections-title"><div class="dom-wrap"><header class="dom-heading dom-center"><p class="dom-label">CHỌN CHẤT LIỆU BẠN YÊU THÍCH</p><h2 id="dom-collections-title">Film dán nội thất cho từng<br class="dom-desktop-break" /> không gian của bạn.</h2><p>Đổi màu tủ, cửa và vách bằng chất liệu phù hợp với nội thất đang có.</p></header><div class="dom-collections">{collections.map(item => <a class="dom-collection" href={materialHref(item.material)}><img src={item.image} alt={`Gợi ý không gian cho ${item.material.name.toLowerCase()} — ảnh tham khảo`} width="700" height="900" loading="lazy" /><div class="dom-collection-shade"></div><div class="dom-collection-caption"><Icon name={categoryIcon(item.slug)!} size={25} /><h3>{item.material.shortName}</h3><span>Khám phá chất liệu ↗</span></div></a>)}</div></div></section>

    <section class="dom-ribbon"><div class="dom-wrap dom-ribbon-inner"><h2>Chọn mẫu bạn thích.<br />Cùng lên phương án hoàn thiện.</h2><a class="dom-button dom-button-dark" href={site.zaloHref}>Trao đổi qua Zalo<Icon name="arrow" size={17} /></a></div></section>

    <section class="dom-section" aria-labelledby="dom-about-title"><div class="dom-wrap"><div class="dom-about-grid"><div><p class="dom-label">HIỂU VẬT LIỆU. CHỌN ĐÚNG ỨNG DỤNG.</p><h2 id="dom-about-title">Chọn film dán nội thất<br />cho không gian của bạn.</h2><div class="dom-faq">{faqs.map((faq,index) => <details open={index===0}><summary><span>{faq.question}</span><span class="dom-faq-plus" aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div></div><div class="dom-about-visual"><figure><img src={home.benefits.image.src} alt={home.benefits.image.alt} width={home.benefits.image.width} height={home.benefits.image.height} loading="lazy" /><figcaption>{home.benefits.caption}</figcaption></figure><div class="dom-stats"><div><span>Mẫu film trên website</span><strong>{catalogue.length}</strong><span>Chọn theo vân và sắc độ</span></div><div><span>Bộ sưu tập vật liệu</span><strong>{brands.length}</strong><span>Thương hiệu trong danh mục</span></div></div></div></div><div class="dom-brands" aria-label="Các thương hiệu trong danh mục">{brands.map(brand => <a href={`/vat-lieu/van-go/?brand=${encodeURIComponent(brand)}#mau-vat-lieu`}>{brand}</a>)}</div></div></section>

    <section aria-labelledby="dom-spaces-title"><div class="dom-wrap dom-gallery-heading"><p class="dom-label">CẢM HỨNG ỨNG DỤNG</p><h2 id="dom-spaces-title">Chất liệu trong không gian.</h2><p>Ảnh ứng dụng catalogue và không gian tham khảo. Xem nguồn và mã liên quan tại từng trang.</p></div><div class="dom-space-grid">{stories.map(story => <a class="dom-space" href={storyHref(story)}><figure><img src={story.images[0].src} alt={story.images[0].alt} width="1000" height="700" loading="lazy" /><figcaption><span>{storyLabel(story)}</span><h3>{story.title}</h3><span>Xem không gian ↗</span></figcaption></figure></a>)}</div></section>

    <section class="dom-section" aria-labelledby="dom-products-title"><div class="dom-wrap"><header class="dom-heading dom-center"><p class="dom-label">BỘ SƯU TẬP VẬT LIỆU</p><h2 id="dom-products-title">Mẫu film dán nội thất.</h2><p>Chọn mã để xem bề mặt, quy cách và tư vấn ứng dụng.</p></header><div class="dom-products">{featuredProducts.map(sample => <a href={sampleHref(sample)} class="dom-product"><div class="dom-product-image"><img src={sample.image} alt={sample.imageAlt || `${sample.title} ${sample.code}`} width={sample.imageWidth} height={sample.imageHeight} loading="lazy" /></div><p class="dom-product-code">{sample.brand} / {sample.code}</p><h3>{sample.title}</h3><p class="dom-product-price">{sample.pricePerMetre ? formatRetailPrice(sample.pricePerMetre) : "Liên hệ báo giá"}{sample.pricePerMetre && <span> / mét dài</span>}</p></a>)}</div><div class="dom-center dom-section-action"><a class="dom-button dom-button-orange" href="/vat-lieu/">Xem tất cả mẫu film<Icon name="arrow" size={17} /></a></div></div></section>

    <section class="dom-assurance"><img src={heroSlides[1].src} alt="" width="1400" height="900" loading="lazy" class="dom-assurance-photo" /><div class="dom-shade" aria-hidden="true"></div><div class="dom-wrap dom-assurance-grid"><div class="dom-assurance-intro"><p class="dom-label">VẬT LIỆU & THI CÔNG THEO NHU CẦU</p><h2>Rõ ràng từ lựa chọn<br />đến hoàn thiện.</h2><p>Chốt mẫu, phạm vi và những chi tiết cần xử lý trước khi bắt đầu.</p><a href="/dich-vu/dan-film-noi-that/" class="dom-button dom-button-orange">Xem dịch vụ<Icon name="arrow" size={17} /></a></div><article class="dom-promise"><Icon name="swatches" size={29} /><h3>Chọn mẫu thực tế</h3><p>Đối chiếu màu, chiều vân và thông số của đúng mã film với không gian cần dán.</p><a href="/blog/cach-chon-film-noi-that/">Tìm hiểu cách chọn mẫu ↗</a></article><article class="dom-promise"><Icon name="check" size={29} /><h3>Thống nhất phạm vi</h3><p>Trao đổi xử lý nền, tháo lắp, chi phí, nghiệm thu và điều kiện bảo hành theo hạng mục.</p><a href="/blog/bao-gia-dan-film/">Cách đọc báo giá ↗</a></article></div></section>

    <section class="dom-section" aria-labelledby="dom-posts-title"><div class="dom-wrap"><header class="dom-heading"><p class="dom-label">CẨM NANG FILM NỘI THẤT</p><h2 id="dom-posts-title">Đọc thêm trước khi chọn.</h2></header><div class="dom-posts">{latestPosts.map(post => <article><a href={postHref(post)}><div class="dom-post-photo"><img src={post.image} alt={post.imageAlt || post.title} width="700" height="500" loading="lazy" /></div><p class="dom-post-category">Tư vấn vật liệu & thi công</p><h3>{post.title}</h3><time datetime={post.date}>{formatDate(post.date)}</time><span class="dom-post-link">Đọc bài viết ↗</span></a></article>)}</div><a class="dom-text-link" href="/blog/">Xem tất cả bài viết<Icon name="arrow" size={17} /></a></div></section>

    <section id="bao-gia" class="dom-contact"><div class="dom-wrap dom-contact-inner"><div><p class="dom-label">{home.contact.eyebrow}</p><h2>{home.contact.title}</h2><p>{home.contact.description}</p><p class="dom-contact-address">{home.contact.address}</p></div><div class="dom-contact-actions"><a href={site.zaloHref} class="dom-button dom-button-orange">{home.contact.zaloLabel}<Icon name="arrow" size={17} /></a><a href={site.phoneHref} class="dom-phone">{site.phone}</a><span>{home.contact.serviceNote}</span></div></div></section>
  </div>
</BaseLayout>

<script>
const slider = document.querySelector<HTMLElement>("[data-home-slider]");
if (slider) {
  const slides = [...slider.querySelectorAll<HTMLImageElement>("[data-hero-slide]")];
  const dots = [...slider.querySelectorAll<HTMLButtonElement>("[data-hero-dot]")];
  const status = slider.querySelector<HTMLElement>("[data-hero-status]")!;
  let current = 0;
  const show = (index: number) => {
    current = (index + slides.length) % slides.length;
    slides.forEach((slide,i) => { slide.classList.toggle("is-active",i===current); slide.setAttribute("aria-hidden",String(i!==current)); if (i===current) slide.loading="eager"; });
    dots.forEach((dot,i) => dot.setAttribute("aria-pressed",String(i===current)));
    status.textContent = `Ảnh ${current+1} / ${slides.length}`;
  };
  slider.querySelector("[data-hero-prev]")?.addEventListener("click",()=>show(current-1));
  slider.querySelector("[data-hero-next]")?.addEventListener("click",()=>show(current+1));
  dots.forEach((dot,i)=>dot.addEventListener("click",()=>show(i)));
  slider.addEventListener("keydown",event=>{ if(event.key==="ArrowLeft"||event.key==="ArrowRight"){event.preventDefault();show(current+(event.key==="ArrowRight"?1:-1));} });
}
</script>

<style>
.home-dom { --dom-ink:#191919; --dom-muted:#555b61; --dom-orange:#e58b2a; --dom-orange-text:#914700; --dom-paper:#fff; --dom-soft:#f5f5f3; --dom-line:#dededb; color:var(--dom-ink); background:var(--dom-paper); }
.dom-wrap { width:min(1240px,calc(100% - 40px)); margin-inline:auto; }
.home-dom h1,.home-dom h2,.home-dom h3,.home-dom p { margin:0; }
.home-dom h1 { font-size:clamp(2rem,4vw,3.75rem); font-weight:500; line-height:1.17; letter-spacing:-.035em; }
.home-dom h2 { font-size:clamp(1.6rem,2.8vw,2.5rem); line-height:1.22; font-weight:500; letter-spacing:-.03em; }
.home-dom h3 { font-weight:500; line-height:1.4; letter-spacing:-.015em; }
.home-dom p { line-height:1.8; }
.dom-section { padding-block:clamp(3.5rem,7vw,6.5rem); }
.dom-center { text-align:center; }
.dom-label { font-size:.6875rem; letter-spacing:.15em; font-weight:600; color:var(--dom-orange-text); text-transform:uppercase; }
.dom-heading { margin-bottom:2.25rem; }
.dom-heading h2 { margin-top:.7rem; }
.dom-heading>p:last-child:not(.dom-label) { color:var(--dom-muted); max-width:42rem; margin:.9rem auto 0; font-size:.9375rem; }
.dom-heading:not(.dom-center)>p:last-child { margin-left:0; }
.dom-button { display:inline-flex; align-items:center; justify-content:center; gap:.8rem; min-height:48px; padding:.8rem 1.5rem; border:1px solid transparent; border-radius:999px; font-size:.8125rem; font-weight:500; line-height:1.5; transition:background-color .2s,color .2s; text-align:center; }
.dom-button-orange { background:var(--dom-orange); color:var(--dom-ink); border-color:var(--dom-orange); }
.dom-button-orange:hover { background:var(--dom-ink); color:var(--dom-paper); border-color:var(--dom-ink); }
.dom-button-dark { background:var(--dom-ink); color:var(--dom-paper); border-color:var(--dom-ink); }
.dom-button-dark:hover { background:var(--dom-paper); color:var(--dom-ink); }
.dom-hero { position:relative; min-height:560px; min-height:clamp(560px,70svh,760px); display:flex; align-items:center; justify-content:center; isolation:isolate; background:var(--dom-ink); color:var(--dom-paper); padding:4rem 1.25rem 6rem; }
.dom-slides,.dom-slide,.dom-shade { position:absolute; inset:0; width:100%; height:100%; }
.dom-slide { object-fit:cover; opacity:0; transition:opacity .6s; }
.dom-slide.is-active { opacity:1; }
.dom-shade { background:var(--dom-ink); opacity:.64; pointer-events:none; }
.dom-hero-copy { width:min(100%,1000px); position:relative; z-index:1; text-align:center; max-width:1000px; }
.dom-hero .dom-label { color:var(--dom-paper); }
.dom-hero h1 { margin:1rem auto 1.3rem; }
.dom-hero-description { max-width:650px; margin:0 auto 1.7rem!important; font-size:.9375rem; }
.dom-hero-arrow { position:absolute; z-index:2; top:auto; bottom:1.2rem; width:44px; height:44px; border-radius:50%; border:1px solid var(--dom-paper); background:var(--dom-ink); color:var(--dom-paper); font-size:18px; }
.dom-prev { left:10px; }.dom-next { right:10px; }
.dom-dots { position:absolute; z-index:2; bottom:1.2rem; display:flex; gap:.3rem; }
.dom-dots button { width:44px; height:44px; display:grid; place-items:center; border:0; background:transparent; }
.dom-dots span { width:8px; height:8px; border-radius:50%; border:1px solid var(--dom-paper); }
.dom-dots [aria-pressed=true] span { background:var(--dom-paper); }
.dom-hero-source { position:absolute; z-index:2; right:20px; bottom:12px; font-size:10px; }
.dom-collections { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
.dom-collection { position:relative; display:block; aspect-ratio:3/4; overflow:hidden; background:var(--dom-ink); color:var(--dom-paper); }
.dom-collection>img { width:100%; height:100%; object-fit:cover; transition:transform .4s; }
.dom-collection:hover>img { transform:scale(1.03); }
.dom-collection-shade { position:absolute; inset:55% 0 0; background:var(--dom-ink); opacity:.85; }
.dom-collection-caption { position:absolute; left:1rem; right:1rem; bottom:1rem; }
.dom-collection-caption :global(svg) { margin-bottom:.5rem; }
.dom-collection-caption h3 { font-size:1rem; }
.dom-collection-caption span { display:block; font-size:.7rem; margin-top:.3rem; }
.dom-ribbon { padding-block:2.5rem; background:var(--dom-orange); color:var(--dom-ink); }
.dom-ribbon-inner { display:flex; flex-direction:column; align-items:flex-start; gap:1.5rem; }
.dom-ribbon h2 { font-size:clamp(1.5rem,2.5vw,2rem); }
.dom-about-grid { display:grid; gap:2.5rem; align-items:center; }
.dom-about-grid h2 { margin-top:.8rem; }
.dom-faq { margin-top:1.5rem; }
.dom-faq details { border-bottom:1px solid var(--dom-line); }
.dom-faq summary { display:flex; justify-content:space-between; align-items:center; gap:1rem; padding:1rem 0; list-style:none; cursor:pointer; font-size:.875rem; font-weight:500; }
.dom-faq summary::-webkit-details-marker { display:none; }
.dom-faq p { font-size:.8125rem; padding:0 1.5rem 1rem 0; color:var(--dom-muted); }
.dom-faq-plus { font-size:1.25rem; }.dom-faq [open] .dom-faq-plus { transform:rotate(45deg); }
.dom-about-visual { min-width:0; }
.dom-about-visual figure img { width:100%; aspect-ratio:4/5; object-fit:cover; }
.dom-about-visual figcaption { color:var(--dom-muted); font-size:.6875rem; margin-top:.6rem; }
.dom-stats { display:grid; grid-template-columns:1fr 1fr; position:relative; margin:-4rem 1rem 0; background:var(--dom-ink); color:var(--dom-paper); }
.dom-stats>div { padding:1rem; }.dom-stats>div+div { border-left:1px solid var(--dom-muted); }
.dom-stats span { display:block; font-size:.75rem; }.dom-stats strong { display:block; font-size:2.5rem; font-weight:500; line-height:1.5; }
.dom-brands { display:flex; flex-wrap:wrap; justify-content:space-around; gap:1rem 2rem; margin-top:4rem; border-top:1px solid var(--dom-line); padding-top:2rem; }
.dom-brands a { display:inline-flex; align-items:center; min-height:44px; color:var(--dom-muted); font-size:1.35rem; letter-spacing:.06em; font-weight:600; }
.dom-gallery-heading { padding-bottom:1.75rem; }.dom-gallery-heading h2 { margin:.6rem 0 .9rem; }.dom-gallery-heading>p:last-child { color:var(--dom-muted); font-size:.875rem; }
.dom-space-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:3px; }
.dom-space { position:relative; display:block; overflow:hidden; }.dom-space figure { margin:0; }.dom-space img { width:100%; aspect-ratio:4/3; object-fit:cover; transition:transform .4s; }.dom-space:hover img { transform:scale(1.03); }
.dom-space figcaption { position:absolute; inset:auto 0 0; padding:.75rem; color:var(--dom-paper); background:var(--dom-ink); }
.dom-space figcaption h3 { font-size:.8125rem; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }.dom-space figcaption span { display:block; font-size:.6875rem; margin:.15rem 0; }
.dom-products { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rem 1rem; }.dom-product { display:block; min-width:0; text-align:center; }
.dom-product-image { overflow:hidden; background:var(--dom-soft); }.dom-product img { width:100%; aspect-ratio:4/3; object-fit:cover; transition:transform .4s; }.dom-product:hover img { transform:scale(1.03); }
.dom-product-code { font-size:.75rem; color:var(--dom-muted); margin-top:.75rem!important; }.dom-product h3 { font-size:.875rem; margin-top:.3rem; }.dom-product-price { font-size:.875rem; font-weight:500; margin-top:.5rem!important; }.dom-product-price span { font-size:.75rem; font-weight:400; }
.dom-section-action { margin-top:2.5rem; }
.dom-assurance { position:relative; isolation:isolate; padding-block:3.5rem; background:var(--dom-ink); }.dom-assurance-photo { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
.dom-assurance-grid { position:relative; display:grid; gap:1rem; align-items:center; }.dom-assurance-intro { color:var(--dom-paper); margin-bottom:.5rem; }.dom-assurance-intro .dom-label { color:var(--dom-paper); }.dom-assurance-intro h2 { margin:1rem 0; }.dom-assurance-intro>p { font-size:.875rem; }.dom-assurance-intro>a { margin-top:1.5rem; }
.dom-promise { padding:1.75rem; background:var(--dom-paper); color:var(--dom-ink); }.dom-promise h3 { font-size:1.125rem; margin:1.25rem 0 .8rem; }.dom-promise p { font-size:.875rem; color:var(--dom-muted); }.dom-promise>a { display:inline-flex; align-items:center; min-height:44px; font-size:.75rem; font-weight:500; margin-top:.6rem; text-decoration:underline; text-underline-offset:4px; }
