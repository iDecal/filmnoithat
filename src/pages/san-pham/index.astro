---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProductCards from "../../components/ProductCards.astro";
import { products } from "../../data/products";
import { breadcrumbSchema } from "../../data/seo";
---
<BaseLayout title="Mẫu film nội thất: vân gỗ, bê tông, vải, kim loại | iDecal" description="Tham khảo các mẫu film nội thất CAD402, CAG816, CSM003, CAN034. Xem ảnh, ứng dụng và liên hệ kiểm tra mẫu thực tế, thông số, giá theo nhu cầu." structuredData={[breadcrumbSchema(Astro.site!, [{ name: "Mẫu film", path: "/san-pham/" }])]}>
  <section class="px-4 sm:px-6 pt-10 pb-6 bg-base-50"><div class="max-w-7xl mx-auto"><Breadcrumbs items={[{ label: "Mẫu film" }]} /><h1 class="text-3xl md:text-5xl font-semibold">Mẫu film nội thất</h1><p class="mt-6 text-lg text-base-600 max-w-3xl">Xem mẫu theo mã để trao đổi phương án phối màu và thi công. Ảnh chỉ mang tính tham khảo; hãy kiểm tra mẫu thực tế và tài liệu vật liệu trước khi đặt hàng.</p></div></section>
  <ProductCards products={products} title="Chọn mẫu theo bề mặt và phong cách" />
</BaseLayout>
