---
import pageContent from "../data/pageContent.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { site } from "../data/site";
import { breadcrumbSchema } from "../data/seo";
const faqs = [
  { question: "Có cung cấp film và nhận thi công toàn quốc không?", answer: "Có. Chúng tôi tiếp nhận nhu cầu mua film và thi công trên toàn quốc. Bạn gửi địa điểm nhận hàng hoặc công trình để trao đổi phương án cung cấp, khảo sát, chi phí và lịch thực hiện trước khi xác nhận." },
  { question: "Tôi cần gửi gì để được tư vấn?", answer: "Ảnh tổng thể, ảnh cận cảnh các góc hoặc vùng hư hỏng, kích thước dự kiến và khu vực công trình. Nếu đã có mẫu yêu thích, bạn có thể gửi thêm mã hoặc ảnh tham khảo." },
  { question: "Có thể chỉ mua vật liệu, không thuê thi công không?", answer: "Bạn có thể trao đổi nhu cầu mua film theo mã, số lượng và ứng dụng dự kiến. Thông số, lượng cần cắt, giá và tình trạng cung cấp được xác nhận trước khi đặt hàng." },
  { question: "Tủ bị ẩm hoặc tường bong có dán được ngay không?", answer: "Cần đánh giá và xử lý nguyên nhân hư hỏng trước. Film là lớp hoàn thiện trang trí, không thay thế việc sửa cốt tủ, chống thấm hay làm chắc lớp nền." },
  { question: "Chi phí và thời gian thi công được chốt khi nào?", answer: "Sau khi làm rõ mã film, kích thước, hiện trạng, chi tiết cần xử lý và điều kiện tiếp cận. Báo giá nên ghi rõ vật tư, nhân công, tháo lắp, tiến độ và điều kiện bảo hành theo phạm vi thực tế." },
];
const channels = [
  { title: "Gọi trực tiếp", text: "Trao đổi nhanh về hạng mục và nhu cầu của bạn.", value: site.phone, href: site.phoneHref, number: "01" },
  { title: "Gửi ảnh qua Zalo", text: "Thuận tiện để gửi hiện trạng, kích thước và mẫu yêu thích.", value: "Mở cuộc trò chuyện →", href: site.zaloHref, number: "02" },
  { title: "Trao đổi qua email", text: "Gửi bảng kích thước, ảnh hoặc yêu cầu cần mô tả chi tiết.", value: site.email, href: `mailto:${site.email}`, number: "03" },
];
---
<BaseLayout faqs={faqs} title={pageContent.contact.title} description={pageContent.contact.description} structuredData={[breadcrumbSchema(Astro.site!, [{ name: "Liên hệ", path: "/lien-he/" }])]}>
  <section class="editorial-hero px-4 sm:px-6 section-space bg-base-50 surface-gradient"><div class="max-w-7xl mx-auto"><Breadcrumbs items={[{ label: "Liên hệ" }]} /><div class="grid lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] gap-10 items-center"><div><p class="eyebrow mb-4">BẮT ĐẦU TỪ KHÔNG GIAN CỦA BẠN</p><h1 class="text-[1.75rem] sm:text-3xl lg:text-4xl font-medium">{pageContent.contact.headingLead}<br /><span class="text-primary-500">{pageContent.contact.headingAccent}</span></h1><p class="text-lg text-base-600 mt-6 max-w-2xl">{pageContent.contact.intro}</p><p class="text-sm text-base-600 mt-5">Phạm vi phục vụ: <strong class="font-semibold text-base-900">{site.serviceArea}</strong></p></div></div></div></section>
<section class="px-4 sm:px-6 pt-8"><div class="max-w-7xl mx-auto"><aside class="rounded-3xl bg-base-900 p-7 md:p-9 text-white"><p class="text-accent-200 text-sm font-semibold mb-5">ĐỂ TƯ VẤN RÕ RÀNG HƠN</p><h2 class="text-2xl font-semibold mb-6">Chuẩn bị 3 điều đơn giản.</h2><ol class="space-y-5 text-white/90"><li class="flex gap-3"><span class="text-accent-200 font-semibold">01</span><span>Ảnh tổng thể và ảnh cận cảnh bề mặt.</span></li><li class="flex gap-3"><span class="text-accent-200 font-semibold">02</span><span>Kích thước và khu vực công trình.</span></li><li class="flex gap-3"><span class="text-accent-200 font-semibold">03</span><span>Màu, mã film hoặc phong cách bạn thích.</span></li></ol><a href={site.zaloHref} class="button-secondary w-full mt-8">Gửi ảnh qua Zalo →</a></aside></div></section>
  <section class="px-4 sm:px-6 section-space bg-white"><div class="max-w-7xl mx-auto"><h2 class="text-2xl md:text-[1.625rem] font-semibold mb-6">Chọn cách liên hệ thuận tiện nhất.</h2><div class="grid md:grid-cols-3 gap-6">{channels.map(channel => <a href={channel.href} class="block border-t border-base-300 py-6 hover:border-primary-500 transition-colors"><span class="text-primary-600 font-semibold text-sm">{channel.number}</span><h3 class="text-lg font-semibold mt-4">{channel.title}</h3><p class="text-base-600 text-sm mt-3">{channel.text}</p><span class="block text-primary-600 font-semibold mt-6 break-words">{channel.value}</span></a>)}</div></div></section>
  <section class="px-4 sm:px-6 section-space bg-base-50"><div class="max-w-7xl mx-auto grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] gap-10"><div><p class="eyebrow mb-4">TRƯỚC KHI LIÊN HỆ</p><h2 class="text-2xl md:text-[1.625rem] font-semibold">Một vài điều<br />có thể bạn đang hỏi.</h2><a href="/blog/" class="inline-block text-primary-600 font-semibold py-3 mt-4 hover:underline">Đọc thêm cẩm nang →</a></div><div class="space-y-4">{faqs.map(faq => <details class="rounded-2xl border border-base-200 bg-white p-6"><summary class="font-semibold cursor-pointer">{faq.question}</summary><p class="text-base-600 mt-4">{faq.answer}</p></details>)}</div></div></section>
</BaseLayout>
