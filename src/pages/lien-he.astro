---
import "../styles/company-pages.css";
import pageContent from "../data/pageContent.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import type { IconName } from "../data/icons";
import { site } from "../data/site";
import { breadcrumbSchema } from "../data/seo";
const faqs = [
  { question: "Có cung cấp film và nhận thi công toàn quốc không?", answer: "Có. Chúng tôi tiếp nhận nhu cầu mua film và thi công trên toàn quốc. Bạn gửi địa điểm nhận hàng hoặc công trình để trao đổi phương án cung cấp, khảo sát, chi phí và lịch thực hiện trước khi xác nhận." },
  { question: "Tôi cần gửi gì để được tư vấn?", answer: "Ảnh tổng thể, ảnh cận cảnh các góc hoặc vùng hư hỏng, kích thước dự kiến và khu vực công trình. Nếu đã có mẫu yêu thích, bạn có thể gửi thêm mã hoặc ảnh tham khảo." },
  { question: "Có thể chỉ mua vật liệu, không thuê thi công không?", answer: "Bạn có thể trao đổi nhu cầu mua film theo mã, số lượng và ứng dụng dự kiến. Thông số, lượng cần cắt, giá và tình trạng cung cấp được xác nhận trước khi đặt hàng." },
  { question: "Tủ bị ẩm hoặc tường bong có dán được ngay không?", answer: "Cần đánh giá và xử lý nguyên nhân hư hỏng trước. Film là lớp hoàn thiện trang trí, không thay thế việc sửa cốt tủ, chống thấm hay làm chắc lớp nền." },
  { question: "Chi phí và thời gian thi công được chốt khi nào?", answer: "Sau khi làm rõ mã film, kích thước, hiện trạng, chi tiết cần xử lý và điều kiện tiếp cận. Báo giá nên ghi rõ vật tư, nhân công, tháo lắp, tiến độ và điều kiện bảo hành theo phạm vi thực tế." },
];

const channels: {title:string;text:string;value:string;href:string;icon:IconName}[] = [
 {title:"Gọi trực tiếp",text:"Trao đổi nhanh về hạng mục và nhu cầu của bạn.",value:site.phone,href:site.phoneHref,icon:"phone"},
 {title:"Gửi ảnh qua Zalo",text:"Gửi hiện trạng, kích thước và mẫu yêu thích trong cùng cuộc trò chuyện.",value:"Mở cuộc trò chuyện",href:site.zaloHref,icon:"message"},
 {title:"Trao đổi qua email",text:"Phù hợp khi gửi bảng kích thước, ảnh hoặc yêu cầu cần mô tả chi tiết.",value:site.email,href:`mailto:${site.email}`,icon:"mail"},
];
const preparation: {title:string;text:string;icon:IconName}[] = [
 {title:"Ảnh hiện trạng",text:"Một ảnh tổng thể và các ảnh cận cảnh góc, mép hoặc vùng hư hỏng.",icon:"camera"},
 {title:"Kích thước & địa điểm",text:"Kích thước dự kiến, khu vực nhận hàng hoặc vị trí công trình.",icon:"ruler"},
 {title:"Mẫu bạn yêu thích",text:"Mã film, tông màu hoặc ảnh không gian muốn tham khảo.",icon:"swatches"},
];
---
<BaseLayout faqs={faqs} title={pageContent.contact.title} description={pageContent.contact.description} structuredData={[breadcrumbSchema(Astro.site!,[{name:"Liên hệ",path:"/lien-he/"}])]}>
 <section class="company-hero"><div class="company-shell"><Breadcrumbs items={[{label:"Liên hệ"}]} /><div class="company-hero-grid">
  <div><p class="company-kicker mb-4"><Icon name="phone" size={20} />BẮT ĐẦU TỪ NHU CẦU CỦA BẠN</p><h1 class="company-title">{pageContent.contact.headingLead}<br />{pageContent.contact.headingAccent}</h1><p class="company-muted text-base sm:text-lg mt-5">{pageContent.contact.intro}</p><p class="company-muted text-sm mt-5 flex items-start gap-2"><Icon name="package" size={19} /><span>Phạm vi phục vụ: {site.serviceArea}</span></p></div>
  <aside class="company-card company-sand"><span class="company-icon"><Icon name="phone" size={23} /></span><p class="company-kicker mt-5">HOTLINE / ZALO</p><a href={site.phoneHref} class="block text-3xl sm:text-4xl font-medium mt-3 break-words">{site.phone}</a><p class="company-muted text-sm mt-4">Gửi ảnh hiện trạng và hạng mục dự định làm mới để cùng trao đổi hướng chọn vật liệu, số lượng và phương án thi công.</p><div class="company-actions"><a href={site.zaloHref} class="button-primary">Gửi ảnh qua Zalo<Icon name="arrow" size={18} class="ml-3" /></a><a href={site.phoneHref} class="button-secondary">Gọi tư vấn</a></div></aside>
 </div></div></section>
 <section class="company-section company-soft"><div class="company-shell"><div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-7"><div><p class="company-kicker mb-3">KẾT NỐI THEO CÁCH THUẬN TIỆN</p><h2 class="company-heading">Bạn muốn trao đổi bằng cách nào?</h2></div><a href="#soan-yeu-cau" class="company-link">Soạn sẵn nội dung tư vấn<Icon name="arrow" size={18} /></a></div><div class="grid md:grid-cols-3 gap-5">{channels.map(channel=><a href={channel.href} class="company-card company-card-link"><span class="company-icon"><Icon name={channel.icon} size={23} /></span><h3 class="text-lg font-semibold mt-5">{channel.title}</h3><p class="company-muted text-sm mt-3">{channel.text}</p><span class="flex justify-between items-start gap-3 mt-auto pt-5"><span class="company-contact-value">{channel.value}</span><Icon name="arrow" size={18} class="mt-1" /></span></a>)}</div></div></section>
 <section id="soan-yeu-cau" class="company-section"><div class="company-shell grid lg:grid-cols-[.8fr_1.2fr] gap-8 lg:gap-16 items-start">
  <div><p class="company-kicker mb-3">CHUẨN BỊ NHANH, TRAO ĐỔI RÕ</p><h2 class="company-heading">Một yêu cầu rõ ràng giúp chọn đúng hướng</h2><p class="company-muted mt-4">Bạn có thể điền những thông tin đang có, sao chép nội dung rồi gửi qua Zalo. Chưa có mã mẫu hoặc kích thước chính xác vẫn có thể bắt đầu trao đổi.</p><ol class="space-y-5 mt-7">{preparation.map(item=><li class="flex gap-3"><span class="company-icon"><Icon name={item.icon} size={21} /></span><div><h3 class="text-base font-semibold">{item.title}</h3><p class="company-muted text-sm mt-1">{item.text}</p></div></li>)}</ol><a href="/huong-dan-phoi-mau/" class="company-link mt-5">Tham khảo cách phối màu trước khi chọn mẫu<Icon name="arrow" size={18} /></a></div>
  <form data-contact-composer class="company-card company-inquiry">
    <h3 class="text-xl font-semibold mb-5">Soạn nội dung cần tư vấn</h3>
    <div class="grid sm:grid-cols-2 gap-4"><label>Nhu cầu<select name="purpose"><option value="mua film nội thất">Mua vật liệu</option><option value="thi công dán film nội thất">Tư vấn thi công</option><option value="chọn mẫu và phương án dán film">Chưa chọn phương án</option></select></label><label>Hạng mục<input name="item" maxlength="200" placeholder="Tủ bếp, mặt bàn, vách…" /></label><label>Mã hoặc tông màu<input name="sample" maxlength="200" placeholder="Mã mẫu, màu hoặc chất liệu…" /></label><label>Kích thước / số lượng<input name="dimensions" maxlength="200" placeholder="Ví dụ: 6 cánh tủ, mỗi cánh…" /></label></div>
    <label class="mt-4">Địa điểm nhận hàng / công trình<input name="location" maxlength="250" autocomplete="address-level2" placeholder="Quận/huyện, tỉnh/thành phố" /></label>
    <label class="mt-4">Thông tin thêm<textarea name="note" rows="3" maxlength="1500" placeholder="Hiện trạng, phần muốn giữ lại, nhu cầu khác…"></textarea></label>
    <label class="mt-5">Nội dung để gửi<textarea data-contact-preview rows="6" readonly aria-describedby="composer-instruction"></textarea></label>
    <p id="composer-instruction" class="company-muted text-xs mt-3">Bấm sao chép, mở Zalo rồi dán nội dung vào cuộc trò chuyện. Các thông tin ở đây chưa được gửi đi.</p>
    <div class="company-actions"><button data-contact-copy disabled type="submit" class="button-primary">Sao chép yêu cầu</button><a href={site.zaloHref} class="button-secondary">Mở Zalo<Icon name="arrow" size={18} class="ml-3" /></a></div>
    <noscript><p class="company-muted text-sm mt-3">Bật JavaScript để soạn và sao chép yêu cầu, hoặc liên hệ trực tiếp bằng các nút gọi điện, Zalo và email phía trên.</p></noscript>
    <p data-contact-copy-status role="status" aria-live="polite" class="company-muted text-sm mt-3"></p>
  </form>
 </div></section>
 <section class="company-section company-sand"><div class="company-shell grid lg:grid-cols-[.8fr_1.2fr] gap-8 lg:gap-16 items-start"><div><p class="company-kicker mb-3">TRƯỚC KHI LIÊN HỆ</p><h2 class="company-heading">Một vài điều bạn có thể đang hỏi</h2><p class="company-muted mt-4">Tham khảo trước để cuộc trao đổi về vật liệu, hiện trạng và chi phí rõ ràng hơn.</p><a href="/blog/" class="company-link mt-4">Đọc thêm cẩm nang<Icon name="arrow" size={18} /></a></div><div class="company-faq">{faqs.map(faq=><details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></div></section>
</BaseLayout>
<script>
 document.querySelectorAll<HTMLFormElement>("[data-contact-composer]").forEach(form=>{
  const preview=form.querySelector<HTMLTextAreaElement>("[data-contact-preview]")!;
  const status=form.querySelector<HTMLElement>("[data-contact-copy-status]")!;
  const value=(name:string)=>(form.elements.namedItem(name) as HTMLInputElement).value.trim();
  const update=()=>{
   const lines=[`Xin chào, tôi cần tư vấn ${value('purpose')}.`];
   for(const [name,label]of [['item','Hạng mục'],['sample','Mã mẫu / tông màu'],['dimensions','Kích thước / số lượng'],['location','Địa điểm'],['note','Thông tin thêm']])if(value(name))lines.push(`${label}: ${value(name)}`);
   lines.push('Nhờ tư vấn vật liệu, số lượng và phương án phù hợp.');preview.value=lines.join('\n');status.textContent='';
  };
  form.addEventListener('input',update);update();
  form.querySelector<HTMLButtonElement>('[data-contact-copy]')!.disabled=false;
  form.addEventListener('submit',async event=>{
   event.preventDefault();update();
   try{await navigator.clipboard.writeText(preview.value);status.textContent='Đã sao chép. Mở Zalo và dán nội dung để gửi yêu cầu.';}
   catch{preview.focus();preview.select();status.textContent='Chưa sao chép tự động được. Hãy sao chép phần nội dung đang chọn rồi gửi qua Zalo.';}
  });
 });
</script>
