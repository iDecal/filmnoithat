---
import pageContent from "../../data/pageContent.json";
import Icon from "../../components/Icon.astro";
import { categoryIcon } from "../../data/icons";
import { catalogue, samplesForMaterial } from "../../data/catalogue";
import CatalogueKnowledge from "../../components/CatalogueKnowledge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MaterialPreview from "../../components/MaterialPreview.astro";
import FilterGallery from "../../components/FilterGallery.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { materials, materialHref } from "../../data/materials";
import { breadcrumbSchema } from "../../data/seo";
const brands = [...new Set(catalogue.map(sample => sample.brand))];
const filters = [{ label: "Tất cả vật liệu", value: "all" }, { label: "Ấm áp", value: "warm" }, { label: "Trung tính", value: "neutral" }, { label: "Ánh kim & phản chiếu", value: "reflective" }];
---
<BaseLayout title={pageContent.materials.title} description={pageContent.materials.description} structuredData={[breadcrumbSchema(Astro.site!, [{ name: "Vật liệu", path: "/vat-lieu/" }])]}>
  <section class="editorial-hero px-4 sm:px-6 section-space bg-base-50 surface-gradient"><div class="max-w-7xl mx-auto"><Breadcrumbs items={[{ label: "Vật liệu" }]} /><p class="eyebrow mb-4">BẮT ĐẦU TỪ CHẤT LIỆU BẠN THÍCH</p><h1 class="text-[1.75rem] sm:text-3xl lg:text-4xl font-medium max-w-3xl">{pageContent.materials.headingLead}<br /><span class="text-primary-500">{pageContent.materials.headingAccent}</span></h1><p class="text-base-600 text-lg max-w-2xl mt-6">{pageContent.materials.intro}</p><a href="/vat-lieu/van-go/?brand=Corance#mau-vat-lieu" class="button-secondary mt-6">Khám phá mẫu Corance →</a></div></section>
  <section class="px-4 sm:px-6 section-space bg-white"><div class="max-w-7xl mx-auto"><FilterGallery filters={filters} noun="nhóm vật liệu" brands={brands}><span slot="count">{materials.length} nhóm vật liệu</span><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{materials.map(material => <article data-filter-card={material.mood} data-brand-counts={JSON.stringify(Object.fromEntries(brands.map(brand => [brand, samplesForMaterial(material.slug).filter(sample => sample.brand === brand).length])))}><a href={materialHref(material)} data-material-link={materialHref(material)} class="group block"><div class="aspect-[4/3] rounded-xl overflow-hidden bg-base-100"><MaterialPreview material={material} /></div><div class="pt-5 pb-2"><p class="eyebrow text-xs mb-2">{material.moodLabel}</p><h2 class="flex items-center gap-3 text-[1.375rem] font-semibold"><Icon name={categoryIcon(material.slug)!} class="text-primary-600" />{material.name}</h2><p class="mt-3 text-sm text-base-600"><span data-gallery-sample-count>{samplesForMaterial(material.slug).length > 0 ? `${samplesForMaterial(material.slug).length} mẫu · ` : ""}</span>{material.applications.map(item => item.title).join(" · ")}</p><span class="inline-block text-primary-600 text-sm font-semibold mt-5">Khám phá chất liệu →</span></div></a></article>)}</div></FilterGallery></div></section>
  <CatalogueKnowledge />
  <ContactCTA title="Chưa biết bắt đầu từ chất liệu nào?" text="Gửi ảnh nội thất hiện có và phong cách mong muốn. Cùng chọn một bảng màu hài hòa trước khi quyết định mã film." />
</BaseLayout>
