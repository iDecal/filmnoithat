---
import { formatRetailPrice } from "../../../data/infeelPrices";
import ProductImageUpload from "../../../components/ProductImageUpload.astro";
import ProductImageGallery from "../../../components/ProductImageGallery.astro";
import ProductProjectSlider from "../../../components/ProductProjectSlider.astro";
import Icon from "../../../components/Icon.astro";
import { categoryIcon } from "../../../data/icons";
import { productSeoTitle, productHeading } from "../../../data/seoTitles";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { catalogue, sampleHref } from "../../../data/catalogue";
import { materials, materialHref } from "../../../data/materials";
import { services, serviceHref } from "../../../data/services";
import { site } from "../../../data/site";
import { breadcrumbSchema } from "../../../data/seo";
export function getStaticPaths() {
  return catalogue.map(sample => ({ params: { slug: sample.slug }, props: { sample } }));
}
const { sample } = Astro.props;
const material = materials.find(item => item.slug === sample.category)!;
const related = catalogue.filter(item => item.category === sample.category && item.brand === sample.brand && item.slug !== sample.slug).sort((a,b) => Number(b.group === sample.group)-Number(a.group === sample.group)).slice(0,4);
const relatedServices = services.filter(service => material.services.includes(service.slug));
const description = sample.seoDescription || `${productHeading(sample)}, dòng ${sample.group} trong catalogue ${sample.collection}. Xem ảnh bề mặt, tham khảo ứng dụng và liên hệ tư vấn mua film hoặc thi công.`;
const priceText = sample.pricePerMetre ? " Giá vật liệu: " + formatRetailPrice(sample.pricePerMetre) + "/mét dài." : "";
const request = `Tôi muốn tư vấn mẫu ${sample.brand} ${sample.code} — ${sample.title} (${sample.group}). Quy cách cuộn: ${sample.rollSpecification}.${priceText} Nhu cầu: mua film / thi công. Kích thước, số lượng: … Địa điểm: …`;
---
<BaseLayout title={sample.seoTitle || productSeoTitle(sample)} description={description} image={sample.image} structuredData={[breadcrumbSchema(Astro.site!, [{name:"Vật liệu",path:"/vat-lieu/"},{name:material.name,path:materialHref(material)},{name:`${sample.title} ${sample.code}`,path:sampleHref(sample)}])]}>
  <section class="px-4 sm:px-6 section-space bg-base-50 surface-gradient"><div class="max-w-7xl mx-auto">
    <Breadcrumbs items={[{ label:"Vật liệu",href:"/vat-lieu/" },{label:material.name,href:materialHref(material)},{label:sample.code}]} />
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-start">
      <div class="min-w-0"><ProductImageGallery sample={sample} /><ProductImageUpload sample={sample} /></div>
      <div class="min-w-0"><p class="eyebrow mb-3">{sample.collection} / {sample.group}</p><h1 class="text-[1.75rem] sm:text-3xl lg:text-4xl font-medium">{productHeading(sample)}</h1><p class="text-lg text-primary-600 font-semibold mt-4">Mã mẫu: {sample.code}</p><p class="text-base-600 mt-5">Mẫu film dán nội thất {sample.brand} {sample.code} thuộc nhóm {material.shortName.toLowerCase()}, tông {sample.color.name.toLowerCase()}, để tham khảo khi phối bàn, tủ hoặc vách. Cần xem mẫu thực tế và xác nhận thông số phù hợp với bề mặt dự kiến sử dụng.</p>
        {sample.pricePerMetre && <div class="mt-6" data-product-price data-price={sample.pricePerMetre}><p class="text-sm text-base-600">Giá vật liệu / mét dài</p><p class="text-2xl sm:text-3xl font-semibold text-primary-600 mt-1">{formatRetailPrice(sample.pricePerMetre)}<span class="text-sm sm:text-base font-normal text-base-600 ml-2">/ mét dài</span></p><p class="text-xs text-base-600 mt-2">Giá cho 1 mét dài theo khổ cuộn của mẫu, không phải giá theo m². Chưa gồm công thi công; chi phí giao hàng và tổng đơn được xác nhận khi đặt.</p></div>}
        <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-5 gap-y-3 mt-6 text-sm border-y border-base-200 py-5"><dt class="text-base-600">Bộ sưu tập</dt><dd>{sample.collection}</dd><dt class="text-base-600">Dòng bề mặt</dt><dd>{sample.group}</dd><dt class="text-base-600">Tông màu</dt><dd>{sample.color.name} <span class="text-base-600">(tham khảo)</span></dd><dt class="text-base-600">Quy cách cuộn</dt><dd>{sample.rollSpecification}</dd><dt class="text-base-600">Tình trạng cung cấp</dt><dd>{sample.pricePerMetre ? "Liên hệ xác nhận số lượng và giao hàng" : "Liên hệ báo giá theo số lượng"}</dd></dl>
        <div class="flex flex-col sm:flex-row flex-wrap gap-3 mt-6"><a href={site.zaloHref} class="button-primary">Tư vấn mẫu {sample.code} qua Zalo</a><button type="button" data-copy-request class="button-secondary" data-request={request}>Sao chép yêu cầu mẫu</button></div><p data-copy-status role="status" aria-live="polite" class="text-sm text-base-600 mt-3">Sao chép yêu cầu rồi gửi qua Zalo để trao đổi đúng mã mẫu.</p>
        {sample.imageSource && <a href={`${sample.imageSource.pdf}#page=${sample.imageSource.page}`} class="inline-flex items-center min-h-11 text-sm text-primary-600 font-medium mt-3 mr-5 hover:underline">Nguồn ảnh từ catalogue bổ sung ↗</a>}
        <a href={`${sample.pdf}#page=${sample.sourcePage}`} class="inline-flex items-center min-h-11 text-sm text-primary-600 font-medium mt-4 hover:underline">Đối chiếu trong catalogue gốc ↗</a>
      </div>
    </div>
  </div></section>
  <ProductProjectSlider sample={sample} />
  <section class="px-4 sm:px-6 section-space bg-white"><div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-8 lg:gap-16"><div><h2 class="text-2xl font-semibold mb-5">Trước khi chọn film dán nội thất.</h2><ul class="list-disc pl-5 space-y-3 text-base-600"><li>Gửi mã {sample.code}, số lượng hoặc kích thước cần dán và địa điểm nhận hàng / công trình.</li><li>Xác nhận khổ film, thông số, lô màu, lượng dư và tình trạng cung cấp trước khi đặt.</li><li>So mẫu dưới ánh sáng thực tế. Đặc tính kỹ thuật cần theo hồ sơ của đúng mẫu và phiên bản vật liệu.</li><li>Nếu thuê thi công, cần đánh giá nền và thống nhất chi phí xử lý, tháo lắp cùng phạm vi thực hiện.</li></ul></div><div class="warm-surface rounded-xl p-6 sm:p-8"><p class="eyebrow mb-3">CẦN HOÀN THIỆN NỘI THẤT?</p><h2 class="text-2xl font-semibold mb-5">Xem thêm cách ứng dụng.</h2><ul class="space-y-2" data-product-applications>{relatedServices.map(service => <li><a href={serviceHref(service)} class="flex items-center gap-3 min-h-11 py-2 text-primary-600 font-medium hover:underline"><span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-accent-100 text-accent-700 shrink-0"><Icon name={categoryIcon(service.slug)!} size={23} /></span><span class="flex-1">{service.name}</span><Icon name="arrow" size={18} /></a></li>)}</ul><a href={`${materialHref(material)}#mau-vat-lieu`} class="inline-flex items-center min-h-11 mt-4 text-sm text-primary-600 font-semibold hover:underline">Trở lại bộ sưu tập {material.shortName.toLowerCase()} →</a></div></div></section>
  <section class="px-4 sm:px-6 section-space warm-surface"><div class="max-w-7xl mx-auto"><h2 class="text-2xl font-semibold mb-7">Thêm lựa chọn cùng nhóm.</h2><div class="grid grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-7">{related.map(item => <a href={sampleHref(item)} class="group min-w-0"><img src={item.image} alt={`${item.title} ${item.code}`} width={item.imageWidth} height={item.imageHeight} loading="lazy" class="w-full aspect-[4/3] object-cover object-center bg-white rounded-xl border border-base-200" /><h3 class="text-sm sm:text-base font-medium mt-3 group-hover:text-primary-600">{item.title}</h3><p class="text-sm text-primary-600 mt-1">{item.code}</p><p class="text-sm font-semibold mt-2">{item.pricePerMetre ? `${formatRetailPrice(item.pricePerMetre)} / mét dài` : "Liên hệ báo giá"}</p><span class="inline-flex min-h-11 items-center text-sm text-base-600">Xem mẫu →</span></a>)}</div></div></section>

</BaseLayout>
<script>
  document.querySelector<HTMLButtonElement>("[data-copy-request]")?.addEventListener("click", async event => {
    const button = event.currentTarget as HTMLButtonElement;
    const status = document.querySelector<HTMLElement>("[data-copy-status]")!;
    try { await navigator.clipboard.writeText(button.dataset.request || ""); status.textContent = "Đã sao chép. Mở Zalo và dán yêu cầu để được tư vấn đúng mẫu."; }
    catch { status.textContent = "Bạn có thể gửi trực tiếp mã mẫu trên trang qua Zalo để được tư vấn."; }
  });
</script>
